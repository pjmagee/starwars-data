<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <base href="/"/>
        <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
        <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet"/>
        <link href=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.css"] rel="stylesheet"/>
        <link href=@Assets["_content/Z.Blazor.Diagrams/style.min.css"] rel="stylesheet"/>
        <link href=@Assets["_content/Z.Blazor.Diagrams/default.styles.min.css"] rel="stylesheet"/>
        <link href=@Assets["style.css"] rel="stylesheet"/>
        <link rel="stylesheet" href="lib/family-chart-premium/styles/family-chart.css" />
        <ImportMap/>
        <link rel="icon" type="image/svg+xml" href="img/galaxy-logo.svg"/>
        <link rel="alternate icon" type="image/ico" href="favicon.ico"/>

        <!-- SEO: global defaults (pages override via HeadContent) -->
        <meta name="description" content="Explore the Star Wars universe through a temporal knowledge graph of 166,000+ entities, AI-powered semantic search, interactive galaxy map, and relationship visualizations — all sourced from Wookieepedia." />
        <meta name="keywords" content="Star Wars, Wookieepedia, knowledge graph, galaxy map, timeline, AI, semantic search, characters, planets, relationships, Canon, Legends" />
        <meta name="author" content="Patrick Magee" />
        <meta name="robots" content="index, follow" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Star Wars Data Explorer" />
        <meta property="og:title" content="Star Wars Data Explorer" />
        <meta property="og:description" content="AI-powered exploration of the Star Wars universe — 166K entities, 694K relationships, semantic search over 800K article passages, interactive galaxy map, and more." />
        <meta property="og:url" content="https://swdata.ai" />
        <meta property="og:image" content="https://swdata.ai/galaxy.png" />
        <meta property="og:image:width" content="1671" />
        <meta property="og:image:height" content="940" />
        <meta property="og:image:alt" content="Star Wars galaxy map background" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Star Wars Data Explorer" />
        <meta name="twitter:description" content="AI-powered exploration of the Star Wars universe — knowledge graph, semantic search, galaxy map, and interactive visualizations." />
        <meta name="twitter:image" content="https://swdata.ai/galaxy.png" />
        <meta name="twitter:image:alt" content="Star Wars galaxy map background" />

        <!-- Canonical -->
        <link rel="canonical" href="https://swdata.ai" />

        <HeadOutlet />
        <!-- Google Analytics — loaded only after cookie consent -->
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}

            function swLoadAnalytics() {
                if (document.querySelector('script[src*="googletagmanager"]')) return;
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1JWZZ8THNS';
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', 'G-1JWZZ8THNS');
            }

            function swGetCookieConsent() {
                return localStorage.getItem('sw_cookie_consent');
            }

            function swSetCookieConsent(value) {
                localStorage.setItem('sw_cookie_consent', value);
                if (value === 'accepted') swLoadAnalytics();
            }

            // Auto-load if previously accepted
            if (swGetCookieConsent() === 'accepted') swLoadAnalytics();

            // Accessibility: persist text-size preference. Stored as one of
            // 'small' | 'default' | 'large' | 'extra-large'. The actual sizing
            // is done via [data-text-size="..."] CSS overrides on <html> in
            // style.css — switching is a single attribute toggle, no MudTheme
            // rebuild, no Blazor re-render.
            function swSetTextSize(size) {
                localStorage.setItem('sw-text-size', size);
                if (size && size !== 'default') {
                    document.documentElement.dataset.textSize = size;
                } else {
                    delete document.documentElement.dataset.textSize;
                }
            }
            function swGetTextSize() { return localStorage.getItem('sw-text-size') || 'default'; }

            // Apply the saved text size NOW, synchronously, before Blazor loads.
            // This eliminates the flash from default sizing to user sizing on the
            // very first paint. The script tag is in <head> so it runs before any
            // body content is parsed.
            (function applySavedTextSize() {
                var size = localStorage.getItem('sw-text-size');
                if (size && size !== 'default') {
                    document.documentElement.dataset.textSize = size;
                }
            })();

            // First-visit landing: new users see "/" (the Getting Started page).
            // Once they've been welcomed we set sw-welcomed and, on subsequent
            // visits to the bare root, send them straight to /ask. Done here in
            // <head> BEFORE Blazor boots so returning users never flash the
            // welcome page (Design-039). Functional-only flag — not tracking,
            // so it does not require cookie consent.
            function swSetWelcomed() { localStorage.setItem('sw-welcomed', 'true'); }
            function swGetWelcomed() { return localStorage.getItem('sw-welcomed') === 'true'; }
            (function redirectWelcomedRoot() {
                if (location.pathname === '/' && swGetWelcomed()) {
                    location.replace('/ask');
                }
            })();

            // Faction theme: persist user's selected MudTheme palette
            function swSetTheme(themeId) { localStorage.setItem('sw-theme', themeId); }
            function swGetTheme() { return localStorage.getItem('sw-theme'); }

            // Dark mode preference: 'light' | 'dark' | 'system'. When 'system',
            // MainLayout follows prefers-color-scheme; otherwise the OS preference
            // is ignored so the user's explicit choice survives reconnects.
            function swSetDarkMode(mode) { localStorage.setItem('sw-dark-mode', mode); }
            function swGetDarkMode() { return localStorage.getItem('sw-dark-mode') || 'system'; }
            function swGetSystemDarkMode() { return window.matchMedia('(prefers-color-scheme: dark)').matches; }

            // Custom system dark-mode watcher. We deliberately do NOT use
            // MudThemeProvider's built-in observer (ObserveSystemDarkModeChange):
            // its JSInvokable callback writes the new value back through the
            // two-way IsDarkMode binding BEFORE our handler runs, so a guard
            // on the .NET side cannot prevent it from stomping a user's
            // explicit Light/Dark choice. We register our own listener and
            // route through a JSInvokable that the layout can ignore based
            // on the persisted preference.
            var _swDarkModeMql = null;
            var _swDarkModeListener = null;
            var _swDarkModeRef = null;
            function swRegisterDarkModeWatcher(dotnetRef) {
                swUnregisterDarkModeWatcher();
                _swDarkModeRef = dotnetRef;
                _swDarkModeMql = window.matchMedia('(prefers-color-scheme: dark)');
                _swDarkModeListener = function (e) {
                    if (_swDarkModeRef) {
                        _swDarkModeRef.invokeMethodAsync('OnSystemDarkModeChangedJs', e.matches);
                    }
                };
                if (_swDarkModeMql.addEventListener) {
                    _swDarkModeMql.addEventListener('change', _swDarkModeListener);
                } else if (_swDarkModeMql.addListener) {
                    _swDarkModeMql.addListener(_swDarkModeListener);
                }
            }
            function swUnregisterDarkModeWatcher() {
                if (_swDarkModeMql && _swDarkModeListener) {
                    if (_swDarkModeMql.removeEventListener) {
                        _swDarkModeMql.removeEventListener('change', _swDarkModeListener);
                    } else if (_swDarkModeMql.removeListener) {
                        _swDarkModeMql.removeListener(_swDarkModeListener);
                    }
                }
                _swDarkModeMql = null;
                _swDarkModeListener = null;
                _swDarkModeRef = null;
            }

            // Combined UI state read — used by MainLayout on first render so we
            // only need ONE JS interop round-trip. The circuit can be torn down
            // between consecutive awaited interop calls during the SignalR
            // first-connect retry cycle, so a single batched call is reliable.
            function swGetUiState() {
                return {
                    theme: localStorage.getItem('sw-theme'),
                    textSize: localStorage.getItem('sw-text-size') || 'default',
                    aurebesh: localStorage.getItem('sw-aurebesh') === 'true',
                    darkMode: localStorage.getItem('sw-dark-mode') || 'system',
                    systemDark: window.matchMedia('(prefers-color-scheme: dark)').matches,
                    // Wide = the copilot can sit beside the page in a split panel.
                    // Below this the copilot falls back to a temporary drawer (a
                    // side-by-side split is unusable on a phone). 960px matches the
                    // Design-011 mobile gate used everywhere else in the layout.
                    wide: window.matchMedia('(min-width: 960px)').matches
                };
            }

            // Viewport width watcher — mirrors the dark-mode watcher above. Lets
            // MainLayout switch the copilot between split-panel (wide) and
            // temporary-drawer (narrow) modes when the window is resized, without
            // a full reload. Same 960px breakpoint as swGetUiState.
            var _swViewportMql = null;
            var _swViewportListener = null;
            var _swViewportRef = null;
            function swRegisterViewportWatcher(dotnetRef) {
                swUnregisterViewportWatcher();
                _swViewportRef = dotnetRef;
                _swViewportMql = window.matchMedia('(min-width: 960px)');
                _swViewportListener = function (e) {
                    if (_swViewportRef) {
                        _swViewportRef.invokeMethodAsync('OnViewportChanged', e.matches);
                    }
                };
                if (_swViewportMql.addEventListener) {
                    _swViewportMql.addEventListener('change', _swViewportListener);
                } else if (_swViewportMql.addListener) {
                    _swViewportMql.addListener(_swViewportListener);
                }
            }
            function swUnregisterViewportWatcher() {
                if (_swViewportMql && _swViewportListener) {
                    if (_swViewportMql.removeEventListener) {
                        _swViewportMql.removeEventListener('change', _swViewportListener);
                    } else if (_swViewportMql.removeListener) {
                        _swViewportMql.removeListener(_swViewportListener);
                    }
                }
                _swViewportMql = null;
                _swViewportListener = null;
                _swViewportRef = null;
            }

            // Aurebesh preview: show selected text in galactic script
            var _aurebeshBar = null;
            function swSetAurebesh(enabled) {
                localStorage.setItem('sw-aurebesh', enabled ? 'true' : 'false');
                if (!enabled && _aurebeshBar) {
                    _aurebeshBar.classList.remove('visible');
                    document.removeEventListener('selectionchange', _onSelectionChange);
                    return;
                }
                if (enabled) {
                    if (!_aurebeshBar) {
                        _aurebeshBar = document.createElement('div');
                        _aurebeshBar.className = 'aurebesh-preview';
                        _aurebeshBar.innerHTML = '<span class="aurebesh-label">Aurebesh</span><span class="aurebesh-text"></span>';
                        document.body.appendChild(_aurebeshBar);
                    }
                    document.addEventListener('selectionchange', _onSelectionChange);
                }
            }
            function _onSelectionChange() {
                if (!_aurebeshBar) return;
                var sel = window.getSelection();
                var text = (sel || '').toString().trim();
                var textEl = _aurebeshBar.querySelector('.aurebesh-text');
                var labelEl = _aurebeshBar.querySelector('.aurebesh-label');
                if (text.length > 0) {
                    // Check if selection is inside aurebesh-content (already rendered as Aurebesh)
                    var node = sel.anchorNode;
                    var inAurebesh = false;
                    while (node) {
                        if (node.nodeType === 1 && node.classList && node.classList.contains('aurebesh-content')) {
                            inAurebesh = true;
                            break;
                        }
                        node = node.parentElement;
                    }
                    // If selecting Aurebesh text, show translation in English; otherwise show in Aurebesh
                    textEl.textContent = text;
                    if (inAurebesh) {
                        textEl.style.fontFamily = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
                        labelEl.textContent = 'Translation';
                    } else {
                        textEl.style.fontFamily = "'Aurebesh', sans-serif";
                        labelEl.textContent = 'Aurebesh';
                    }
                    _aurebeshBar.classList.add('visible');
                } else {
                    _aurebeshBar.classList.remove('visible');
                }
            }
            function swGetAurebesh() { return localStorage.getItem('sw-aurebesh') === 'true'; }

            // Chat session localStorage helpers (global, no ES module import needed)
            var _chatKey = 'starwars-chat-sessions';
            function swChatLoad() { try { return JSON.parse(localStorage.getItem(_chatKey)) || []; } catch { return []; } }
            function swChatSave(session) { var s = swChatLoad(); var i = s.findIndex(x => x.id === session.id); if (i >= 0) s[i] = session; else s.unshift(session); localStorage.setItem(_chatKey, JSON.stringify(s)); }
            function swChatLoadOne(id) { return swChatLoad().find(x => x.id === id) || null; }
            function swChatDelete(id) { localStorage.setItem(_chatKey, JSON.stringify(swChatLoad().filter(x => x.id !== id))); }
            function swChatClear() { localStorage.removeItem(_chatKey); }

            // Set target="_blank" + rel="noopener" on every <a> inside the given selector
            // root. Used by the copilot sidebar after each streaming update so that both
            // in-site KG links (/graph-explorer/{id}) and external Wookieepedia links
            // open in a new tab — keeps the user's exploration context on the source page.
            function swOpenLinksInNewTab(rootSelector) {
                var root = document.querySelector(rootSelector);
                if (!root) return;
                var anchors = root.querySelectorAll('a:not([data-sw-newtab])');
                anchors.forEach(function (a) {
                    a.setAttribute('target', '_blank');
                    var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
                    if (rel.indexOf('noopener') === -1) rel.push('noopener');
                    if (rel.indexOf('noreferrer') === -1) rel.push('noreferrer');
                    a.setAttribute('rel', rel.join(' '));
                    a.setAttribute('data-sw-newtab', '1');
                });
            }

            // Watch document text-selection and forward it to .NET so the copilot
            // can inject [SELECTION: "..."] into the next user message. The pin
            // is "sticky": once captured it persists until the user either
            // (a) makes a new non-empty selection somewhere on the page, or
            // (b) clicks the × on the chip in the sidebar (which calls
            // SetSelection(null) directly from Razor — there is no JS path to
            // clear the pin). This is deliberate: focus-shifting to the chat
            // input or clicking elsewhere on the page collapses the browser
            // selection and fires an empty selectionchange — we MUST ignore
            // those, otherwise the act of asking about the selection wipes the
            // selection. Selections inside the copilot itself are skipped so
            // the user reading their own chat doesn't loop back into context.
            // Debounced ~250ms because selectionchange fires on every cursor
            // movement during a drag.
            var _swSelectionDebounce = null;
            var _swSelectionRef = null;
            var _swSelectionLast = null;
            function swRegisterSelectionWatcher(dotNetRef) {
                _swSelectionRef = dotNetRef;
                if (window._swSelectionRegistered) return;
                window._swSelectionRegistered = true;
                document.addEventListener('selectionchange', function () {
                    if (_swSelectionDebounce) clearTimeout(_swSelectionDebounce);
                    _swSelectionDebounce = setTimeout(function () {
                        try {
                            var sel = window.getSelection();
                            var text = sel ? String(sel).trim() : '';

                            // Empty selection = browser collapsed it (focus shift,
                            // click elsewhere). Don't disturb the pinned chip; only
                            // the × button clears.
                            if (!text) return;

                            // Don't capture selections inside the copilot itself.
                            if (sel && sel.anchorNode) {
                                var node = sel.anchorNode.nodeType === 3
                                    ? sel.anchorNode.parentElement
                                    : sel.anchorNode;
                                if (node && node.closest && node.closest('#copilot-drawer, .copilot-container')) {
                                    return;
                                }
                            }

                            // Cap length so the envelope doesn't dwarf the user's question.
                            if (text.length > 400) text = text.substring(0, 400) + '…';

                            // Avoid spamming Blazor with identical updates.
                            if (text === _swSelectionLast) return;
                            _swSelectionLast = text;

                            if (_swSelectionRef) {
                                _swSelectionRef.invokeMethodAsync('OnSelectionChanged', text);
                            }
                        } catch { /* ignore */ }
                    }, 250);
                });
            }
            function swUnregisterSelectionWatcher() {
                _swSelectionRef = null;
                _swSelectionLast = null;
            }
        </script>
    </head>
    <body>
        @* LoggingErrorBoundary catches MudBlazor MudInput ObjectDisposedException that occurs
           when navigating between pages — MudInput.OnAfterRenderAsync races with disposal
           of DotNetObjectReference during Blazor's component teardown/remount cycle.
           The subclass logs each exception with the current URL so it lands in Aspire
           structured logs instead of being swallowed. *@
        <LoggingErrorBoundary @ref="_routeErrorBoundary">
            <ChildContent>
                <Routes @rendermode="InteractiveServerNoPrerender" />
            </ChildContent>
            <ErrorContent>
                <Routes @rendermode="InteractiveServerNoPrerender" />
            </ErrorContent>
        </LoggingErrorBoundary>
        <script src="_framework/blazor.web.js"></script>
        <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
        <script src=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"]></script>
        <script src=@Assets["_content/Z.Blazor.Diagrams/script.min.js"]></script>
        <script src="https://d3js.org/d3.v7.min.js"></script>
        <script src="lib/family-chart-premium/family-chart.js"></script>
    </body>
</html>

@code {
    private static readonly InteractiveServerRenderMode InteractiveServerNoPrerender = new(prerender: false);
    private LoggingErrorBoundary? _routeErrorBoundary;

    protected override void OnParametersSet()
    {
        // Auto-recover from MudBlazor MudInput dispose race — the ErrorBoundary
        // catches the ObjectDisposedException and re-renders Routes immediately.
        _routeErrorBoundary?.Recover();
    }
}