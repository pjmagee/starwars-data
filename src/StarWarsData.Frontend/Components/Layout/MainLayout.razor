@using System.Reflection
@using System.Security.Claims
@using Microsoft.JSInterop
@using StarWarsData.Models.Entities
@using StarWarsData.Frontend.Services
@using StarWarsData.Frontend.Theming
@inherits LayoutComponentBase
@inject LayoutService Layout
@inject PageContextService PageContext
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider"
                  Theme="@_theme"
                  @bind-IsDarkMode="_isDarkMode"
                  ObserveSystemDarkModeChange="false" />
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    @if (!Layout.IsFullscreen)
    {
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"/>
        <MudImage Src="img/galaxy-logo.svg" Alt="Star Wars Data" Width="32" Height="32" Class="ml-2" />
        @* Title hidden below lg (< 1280px) — at md (960–1279) the AppBar is too cramped once filters are in. *@
        <MudText Typo="Typo.h5" Class="ml-2 d-none d-lg-flex">Star Wars Data</MudText>
        <MudTooltip Text="This site is in active development. If you see an issue, please report it on GitHub.">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                     Href="https://github.com/pjmagee/starwars-data/issues" Target="_blank"
                     Class="ml-2" Style="font-weight:600;letter-spacing:0.5px;">BETA</MudChip>
        </MudTooltip>
        <MudSpacer/>
        <ContinuityFilter />
        @* Desktop-only secondary controls (lg and up): individual icon buttons *@
        <div class="d-none d-lg-flex align-center">
            <MudLink Href="https://www.buymeacoffee.com/pjmagee" Target="_blank" Class="d-flex align-center" Style="height:28px;">
                <img src="https://img.buymeacoffee.com/button-api/?text=Buy me a coffee&emoji=&slug=pjmagee&button_colour=FFDD00&font_colour=000000&font_family=Poppins&outline_colour=000000&coffee_colour=ffffff" alt="Buy me a coffee" style="height:28px;" />
            </MudLink>
            <MudTooltip Text="Text size — adjust the font scale">
                <MudMenu Icon="@Icons.Material.Filled.FormatSize" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                    @foreach (var (label, value) in _textSizes)
                    {
                        var v = value;
                        <MudMenuItem OnClick="@(() => SetTextSize(v))"
                                     Icon="@(_textSize == v ? Icons.Material.Filled.Check : Icons.Material.Filled.FormatSize)">
                            @label
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTooltip>
            <MudTooltip Text="Faction theme — change the colour palette">
                <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                    @foreach (var theme in Enum.GetValues<SwTheme>())
                    {
                        var t = theme;
                        <MudMenuItem OnClick="@(() => SetTheme(t))"
                                     Icon="@(_selectedTheme == t ? Icons.Material.Filled.Check : Icons.Material.Filled.Palette)">
                            @t.Label()
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTooltip>
            <MudTooltip Text="@(_aurebesh ? "Aurebesh mode ON — click to disable" : "Aurebesh mode — render selected text in Star Wars script")">
                <MudIconButton Icon="@Icons.Material.Filled.Translate" Color="@(_aurebesh ? Color.Warning : Color.Inherit)"
                               OnClick="ToggleAurebesh" />
            </MudTooltip>
            <MudTooltip Text="Appearance — light, dark, or follow system">
                <MudMenu Icon="@DarkLightModeButtonIcon" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                    <MudMenuItem OnClick="@(() => SetDarkMode("light"))"
                                 Icon="@(_darkModePreference == "light" ? Icons.Material.Filled.Check : Icons.Material.Outlined.LightMode)">
                        Light
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetDarkMode("dark"))"
                                 Icon="@(_darkModePreference == "dark" ? Icons.Material.Filled.Check : Icons.Material.Outlined.DarkMode)">
                        Dark
                    </MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetDarkMode("system"))"
                                 Icon="@(_darkModePreference == "system" ? Icons.Material.Filled.Check : Icons.Material.Rounded.AutoMode)">
                        System
                    </MudMenuItem>
                </MudMenu>
            </MudTooltip>
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/pjmagee/starwars-data" Target="_blank" title="GitHub" />
        </div>
        @* Compact overflow menu removed: Appearance / Theme / Text size / Aurebesh / GitHub now live in the nav drawer below lg. *@
        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem Disabled="true">
                        <MudText Typo="Typo.body2">@(context.User.Identity?.Name ?? context.User.FindFirst("preferred_username")?.Value ?? "User")</MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Href="/profile" Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                    <MudMenuItem Href="/authentication/logout" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                @* Desktop sign-in button (full text) — lg and up *@
                <MudButton Href="/authentication/login" Variant="Variant.Text" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login" Class="d-none d-lg-inline-flex">Sign in</MudButton>
                @* Compact sign-in icon — below lg *@
                <MudIconButton Icon="@Icons.Material.Filled.Login" Color="Color.Inherit" Edge="Edge.End"
                               Href="/authentication/login" title="Sign in" Class="d-flex d-lg-none" />
            </NotAuthorized>
        </AuthorizeView>
        @* Copilot sidebar toggle — hidden on pages that opt out (e.g. /ask). *@
        @if (!Layout.HideCopilot)
        {
            <MudTooltip Text="@(_copilotOpen ? "Hide copilot" : "Open copilot")">
                <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome"
                               Color="@(_copilotOpen ? Color.Secondary : Color.Inherit)"
                               Edge="Edge.End"
                               OnClick="ToggleCopilot" />
            </MudTooltip>
        }
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Width="280px">
        @* Three flex zones: scrollable NavMenu on top (absorbs chat history growth),
           then compact-only Settings + Footer pinned to the bottom. Settings use collapsed
           MudNavGroups so they stay one row until tapped. *@
        <div class="d-flex flex-column" style="height:100%;">
            <div style="flex:1; min-height:0; overflow-y:auto;">
                <NavMenu/>
            </div>
            @* Compact-only Settings — hidden at lg+ where the AppBar icon cluster takes over. *@
            <div class="d-lg-none" style="flex-shrink:0; border-top:1px solid var(--mud-palette-lines-default);">
                <MudNavMenu>
                    <MudNavGroup Title="Appearance" Icon="@DarkLightModeButtonIcon" Expanded="false">
                        <MudNavLink OnClick="@(() => SetDarkMode("light"))"
                                    Icon="@(_darkModePreference == "light" ? Icons.Material.Filled.Check : Icons.Material.Outlined.LightMode)">Light</MudNavLink>
                        <MudNavLink OnClick="@(() => SetDarkMode("dark"))"
                                    Icon="@(_darkModePreference == "dark" ? Icons.Material.Filled.Check : Icons.Material.Outlined.DarkMode)">Dark</MudNavLink>
                        <MudNavLink OnClick="@(() => SetDarkMode("system"))"
                                    Icon="@(_darkModePreference == "system" ? Icons.Material.Filled.Check : Icons.Material.Rounded.AutoMode)">System</MudNavLink>
                    </MudNavGroup>
                    <MudNavGroup Title="Theme" Icon="@Icons.Material.Filled.Palette" Expanded="false">
                        @foreach (var theme in Enum.GetValues<SwTheme>())
                        {
                            var t = theme;
                            <MudNavLink OnClick="@(() => SetTheme(t))"
                                        Icon="@(_selectedTheme == t ? Icons.Material.Filled.Check : Icons.Material.Filled.Palette)">@t.Label()</MudNavLink>
                        }
                    </MudNavGroup>
                    <MudNavGroup Title="Text size" Icon="@Icons.Material.Filled.FormatSize" Expanded="false">
                        @foreach (var (label, value) in _textSizes)
                        {
                            var v = value;
                            <MudNavLink OnClick="@(() => SetTextSize(v))"
                                        Icon="@(_textSize == v ? Icons.Material.Filled.Check : Icons.Material.Filled.FormatSize)">@label</MudNavLink>
                        }
                    </MudNavGroup>
                    <MudNavLink OnClick="ToggleAurebesh"
                                Icon="@Icons.Material.Filled.Translate"
                                IconColor="@(_aurebesh ? Color.Warning : Color.Default)">
                        @(_aurebesh ? "Aurebesh: ON" : "Aurebesh: OFF")
                    </MudNavLink>
                    <MudNavLink Href="https://github.com/pjmagee/starwars-data" Target="_blank" Icon="@Icons.Custom.Brands.GitHub">GitHub</MudNavLink>
                </MudNavMenu>
            </div>
            @* Compact-only footer pinned to the bottom of the drawer (below lg) — mirrors the desktop <footer>. *@
            <div class="pa-3 d-lg-none" style="flex-shrink:0; border-top:1px solid var(--mud-palette-lines-default);">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Made with ❤️ by
                        <MudLink Href="https://magaoidh.pro" Target="_blank" Color="Color.Secondary" Underline="Underline.Always">Patrick Magee</MudLink>
                        &copy; @DateTime.UtcNow.Year
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">v@(_version)</MudText>
                    <MudText Typo="Typo.caption" Style="color:rgba(146,146,159,0.6); font-size:11px;">
                        Not affiliated with or endorsed by Wookieepedia, Fandom, Disney, or Lucasfilm.
                        Star Wars and all related properties are trademarks of Disney/Lucasfilm Ltd.
                        This is an independent fan project.
                        <MudLink Href="/about" Style="font-size:11px;" Color="Color.Secondary" Underline="Underline.Hover">Learn more</MudLink>
                    </MudText>
                </MudStack>
            </div>
        </div>
    </MudDrawer>
    @* Copilot — mobile fallback only. On wide viewports the copilot lives in a
       MudSplitPanel beside the page content (see MudMainContent below) so the
       user can keep reading and navigating while it's open. A side-by-side
       split is unusable on a phone, so below the 960px gate it stays a
       temporary drawer. Suppressed on /ask and any page that sets
       Layout.HideCopilot. *@
    @if (!Layout.HideCopilot && !_isWide)
    {
        <MudDrawer id="copilot-drawer" @bind-Open="_copilotOpen" Anchor="Anchor.Right"
                   ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Temporary"
                   Elevation="3" Width="380px">
            <CopilotSidebar />
        </MudDrawer>
    }
    }
    <MudMainContent Class="@MainContentClass" Style="@MainContentStyle">
        @if (CopilotEligible)
        {
            @* Copilot lives beside the page in a draggable split panel rather
               than an overlay drawer, so the user can keep reading and clicking
               around the site while it's open. The page scrolls inside
               FirstPanel; the copilot owns its own internal scroll in
               SecondPanel.

               CRITICAL: this structure is rendered whether or not the copilot
               is open — only the `copilot-closed` class, the SecondPanel
               content, and the divider position change on toggle. @Body must
               keep the same ancestor chain across the toggle or Blazor
               re-mounts the whole page (lost scroll/state). See CopilotEligible. *@
            <div class="sw-copilot-split-host @(_copilotOpen ? null : "copilot-closed")">
                <MudSplitPanel @ref="_splitPanel"
                               Class="mud-width-full mud-height-full"
                               MinPanelSize="320"
                               PanelGap="6"
                               Transparent="true"
                               ClassDivider="sw-split-divider"
                               ClassFirstPanel="sw-split-first"
                               ClassSecondPanel="sw-copilot-pane">
                    <FirstPanel>
                        <div class="sw-split-scroll pa-4">
                            @Body
                            @FooterContent
                        </div>
                    </FirstPanel>
                    <SecondPanel>
                        @if (_copilotOpen)
                        {
                            <CopilotSidebar />
                        }
                    </SecondPanel>
                </MudSplitPanel>
            </div>
        }
        else
        {
            @Body
            @if (!Layout.IsFullscreen)
            {
                @FooterContent
            }
        }
    </MudMainContent>
</MudLayout>

<CookieConsent />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _copilotOpen;
    private bool _isDarkMode = true;
    private string _darkModePreference = "system"; // "light" | "dark" | "system"
    private bool _aurebesh;
    private MudTheme? _theme;
    private string _textSize = "default";
    private SwTheme _selectedTheme = SwTheme.Holonet;
    private MudThemeProvider _mudThemeProvider = null!;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private bool _darkModeWatcherRegistered;
    private bool _selectionWatcherRegistered;
    private bool _viewportWatcherRegistered;

    // True when the viewport is wide enough (>= 960px, the Design-011 gate) to
    // host the copilot beside the page in a split panel. Defaults true — the
    // app renders server-side with no prerender so the real value lands on the
    // first JS-interop round-trip; desktop-first is the safe default.
    private bool _isWide = true;
    private MudSplitPanel? _splitPanel;
    private bool _splitInitialized;

    // Whether the copilot is *permitted* to host beside the page on this
    // page/viewport — deliberately INDEPENDENT of _copilotOpen.
    //
    // The split structure (host div → MudSplitPanel → FirstPanel) is mounted
    // whenever this is true, open or closed. It must NOT depend on
    // _copilotOpen: @Body's ancestor chain has to be invariant across the
    // open/close toggle. If the toggle moved @Body between an `if` and `else`
    // branch (its old behaviour), Blazor would re-mount the entire routed page
    // — re-running OnInitialized, wiping scroll/camera/form state — every time
    // the user opened the copilot. Open/closed now only flips a CSS class, the
    // SecondPanel content, and the divider position; @Body never moves.
    private bool CopilotEligible => !Layout.HideCopilot && !Layout.IsFullscreen && _isWide;

    // When eligible the page always lives inside FirstPanel (its own scroll
    // container), so the main content keeps only its app-bar offset (pt-16)
    // and drops pa-4 regardless of whether the copilot is open.
    private string MainContentClass =>
        Layout.IsFullscreen ? "" : CopilotEligible ? "pt-16" : "pt-16 pa-4";

    private string MainContentStyle =>
        Layout.IsFullscreen ? "padding-top:0!important;" : "";

    // Footer is shared between the split and non-split branches. It's static
    // markup (not @Body), so rendering it from a fragment in either branch is
    // safe — @Body itself only ever lives in one branch at a time.
    private RenderFragment FooterContent => @<footer class="d-none d-lg-flex flex-column align-center gap-2 pa-4 mt-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="flex-wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Made with ❤️ by
                <MudLink Href="https://magaoidh.pro" Target="_blank" Color="Color.Secondary" Underline="Underline.Always">Patrick Magee</MudLink>
                &copy; @DateTime.UtcNow.Year
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">|</MudText>
            <MudLink Href="/privacy" Typo="Typo.caption" Color="Color.Secondary" Underline="Underline.Hover">Privacy</MudLink>
            <MudLink Href="/terms" Typo="Typo.caption" Color="Color.Secondary" Underline="Underline.Hover">Terms</MudLink>
            <MudLink Href="/about" Typo="Typo.caption" Color="Color.Secondary" Underline="Underline.Hover">About</MudLink>
            <MudText Typo="Typo.caption" Color="Color.Secondary">|</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">v@(_version)</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Style="color:rgba(146,146,159,0.6); font-size:11px; text-align:center; max-width:600px;">
            Not affiliated with or endorsed by Wookieepedia, Fandom, Disney, or Lucasfilm.
            Star Wars and all related properties are trademarks of Disney/Lucasfilm Ltd.
            This is an independent fan project. <MudLink Href="/about" Style="font-size:11px;" Color="Color.Secondary" Underline="Underline.Hover">Learn more</MudLink>
        </MudText>
    </footer>;

    private static readonly (string Label, string Value)[] _textSizes =
    [
        ("Small", "small"),
        ("Default", "default"),
        ("Large", "large"),
        ("Extra Large", "extra-large"),
    ];

    private readonly string _version = Assembly.GetExecutingAssembly()
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?.InformationalVersion?.Split('+')[0]
        ?? Assembly.GetExecutingAssembly().GetName().Version?.ToString(3)
        ?? "0.0.0";

    protected override void OnInitialized()
    {
        Layout.OnChange += StateHasChanged;
        // Build with current (default) field values so MudThemeProvider has a non-null
        // Theme on the very first render. The saved palette is loaded later in
        // OnAfterRenderAsync once JS interop is safe. Text size is handled entirely
        // via CSS variable overrides on <html data-text-size="...">; the inline
        // script in App.razor's <head> applies it synchronously before Blazor loads,
        // so MainLayout never has to rebuild the MudTheme to scale typography.
        _theme = BuildTheme(_selectedTheme);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Size the copilot split divider the first time the split becomes
        // active. This runs on every render (not just first) because the split
        // appears when the user toggles the copilot — long after first render.
        // Measure the actual content host (already inset by the left nav
        // drawer) so the copilot lands at a sane ~34% width clamped to a
        // readable band rather than MudSplitPanel's 50/50 default. Reset the
        // flag when it closes so it re-sizes the next time it opens.
        if (CopilotEligible && _copilotOpen && _splitPanel is not null && !_splitInitialized)
        {
            _splitInitialized = true;
            try
            {
                var hostWidth = await JS.InvokeAsync<int>("swElementWidth", ".sw-copilot-split-host");
                if (hostWidth > 0)
                {
                    var copilot = Math.Clamp((int)(hostWidth * 0.34), 360, 460);
                    var offset = Math.Max(320, hostWidth - copilot - 6);
                    await _splitPanel.SetDividerPositionAsync(offset);
                }
            }
            catch (JSDisconnectedException) { }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Failed initializing copilot split divider");
            }
        }
        else if (!_copilotOpen && _splitInitialized)
        {
            // Closed (or no longer eligible): re-arm so the divider is
            // re-measured and re-positioned the next time it opens.
            _splitInitialized = false;
        }

        if (!firstRender) return;

        // Critical: load all persisted UI state in ONE round-trip via swGetUiState.
        // Empirically, in Blazor Server with prerender disabled the SignalR circuit
        // can be torn down between consecutive awaited JS interop calls during the
        // first-connect retry race, causing the second call to throw
        // JSDisconnectedException. Batching into a single call sidesteps that.
        try
        {
            var ui = await JS.InvokeAsync<UiState>("swGetUiState");
            if (!string.IsNullOrEmpty(ui.Theme))
                _selectedTheme = SwThemeExtensions.FromId(ui.Theme);
            _textSize = string.IsNullOrEmpty(ui.TextSize) ? "default" : ui.TextSize;
            _aurebesh = ui.Aurebesh;
            _darkModePreference = string.IsNullOrEmpty(ui.DarkMode) ? "system" : ui.DarkMode;

            _isDarkMode = _darkModePreference switch
            {
                "dark" => true,
                "light" => false,
                _ => ui.SystemDark,
            };

            _isWide = ui.Wide;

            _theme = BuildTheme(_selectedTheme);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed loading persisted UI state");
        }

        // Best-effort follow-ups. These may JSDisconnectedException-throw on the
        // first circuit; if so, the SECOND circuit (the one that survives) will
        // run this method again and pick them up.
        try
        {
            if (_aurebesh)
                await JS.InvokeVoidAsync("swSetAurebesh", true);

            if (!_darkModeWatcherRegistered)
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("swRegisterDarkModeWatcher", _dotNetRef);
                _darkModeWatcherRegistered = true;
            }

            if (!_selectionWatcherRegistered)
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("swRegisterSelectionWatcher", _dotNetRef);
                _selectionWatcherRegistered = true;
            }

            if (!_viewportWatcherRegistered)
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("swRegisterViewportWatcher", _dotNetRef);
                _viewportWatcherRegistered = true;
            }

            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed wiring system dark mode watcher");
        }
    }

    private sealed record UiState(string? Theme, string? TextSize, bool Aurebesh, string? DarkMode, bool SystemDark, bool Wide);

    [JSInvokable]
    public Task OnViewportChanged(bool wide)
    {
        // Forwarded by swRegisterViewportWatcher when the window crosses the
        // 960px gate. Flips the copilot between split-panel and drawer modes
        // live, without a reload.
        if (_isWide == wide) return Task.CompletedTask;
        _isWide = wide;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSystemDarkModeChangedJs(bool systemIsDark)
    {
        // Only honour OS-level theme changes when the user has asked to follow
        // the system. Explicit Light/Dark choices must survive any noise the
        // browser emits on prefers-color-scheme.
        if (_darkModePreference != "system") return Task.CompletedTask;
        _isDarkMode = systemIsDark;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSelectionChanged(string? text)
    {
        // Forwarded by swRegisterSelectionWatcher in App.razor when the user
        // highlights text outside the copilot drawer. CopilotSidebar reads this
        // at submit time and tacks it onto the agent envelope.
        PageContext.SetSelection(text);
        return Task.CompletedTask;
    }

    private async Task SetTextSize(string size)
    {
        _textSize = size;
        await JS.InvokeVoidAsync("swSetTextSize", size);
    }

    private async Task SetTheme(SwTheme theme)
    {
        _selectedTheme = theme;
        _theme = BuildTheme(_selectedTheme);
        await JS.InvokeVoidAsync("swSetTheme", theme.Id());
        StateHasChanged();
    }

    private async Task ToggleAurebesh()
    {
        _aurebesh = !_aurebesh;
        await JS.InvokeVoidAsync("swSetAurebesh", _aurebesh);
    }

    private static MudTheme BuildTheme(SwTheme theme)
    {
        var (light, dark) = Themes.GetPalettes(theme);
        return new MudTheme
        {
            PaletteLight = light,
            PaletteDark = dark,
            LayoutProperties = new LayoutProperties(),
            // Typography intentionally omitted — text-size is controlled by
            // [data-text-size="..."] CSS overrides on <html>, see style.css.
        };
    }

    public void Dispose()
    {
        Layout.OnChange -= StateHasChanged;
        if (_darkModeWatcherRegistered)
        {
            try
            {
                _ = JS.InvokeVoidAsync("swUnregisterDarkModeWatcher");
            }
            catch { }
        }
        if (_selectionWatcherRegistered)
        {
            try
            {
                _ = JS.InvokeVoidAsync("swUnregisterSelectionWatcher");
            }
            catch { }
        }
        if (_viewportWatcherRegistered)
        {
            try
            {
                _ = JS.InvokeVoidAsync("swUnregisterViewportWatcher");
            }
            catch { }
        }
        _dotNetRef?.Dispose();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleCopilot()
    {
        _copilotOpen = !_copilotOpen;
    }

    private async Task SetDarkMode(string mode)
    {
        _darkModePreference = mode;
        if (mode == "system")
        {
            try
            {
                _isDarkMode = await JS.InvokeAsync<bool>("swGetSystemDarkMode");
            }
            catch (JSDisconnectedException) { }
        }
        else
        {
            _isDarkMode = mode == "dark";
        }

        try
        {
            await JS.InvokeVoidAsync("swSetDarkMode", mode);
        }
        catch (JSDisconnectedException) { }

        StateHasChanged();
    }

    public string DarkLightModeButtonIcon => _darkModePreference switch
    {
        "light" => Icons.Material.Outlined.LightMode,
        "dark" => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Rounded.AutoMode,
    };

}
