@namespace StarWarsData.Frontend.Components.Shared.Holocron
@using StarWarsData.Models.Entities

<MudStack Spacing="2" Class="@Class">
    @foreach (var stage in HolocronUi.Stages)
    {
        var state = HolocronUi.GetState(stage, Stage);
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            @if (state == StageState.Done)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
            }
            else if (state == StageState.Active)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Style="width:20px;height:20px" />
            }
            else if (state == StageState.Failed)
            {
                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Outlined.Circle" Color="Color.Default" Size="Size.Small" />
            }
            <MudText Typo="Typo.body2"
                     Color="@(state == StageState.Active ? Color.Primary : state == StageState.Done ? Color.Success : state == StageState.Failed ? Color.Error : Color.Default)">
                @HolocronUi.StageLabel(stage)
            </MudText>
        </MudStack>
    }
</MudStack>

<MudProgressLinear Value="@HolocronUi.StageProgress(Stage)"
                   Color="@(ProgressColor ?? (Stage == HolocronJobStatus.Failed ? Color.Error : Stage == HolocronJobStatus.Completed ? Color.Success : Color.Primary))"
                   Striped="@(Striped && Stage is not (HolocronJobStatus.Completed or HolocronJobStatus.Failed))"
                   Size="Size.Medium" Class="mt-3 mb-2" />

@if (ShowSubStepProgress && TotalSteps > 0)
{
    <MudProgressLinear Value="@HolocronUi.SubStepProgress(CurrentStep, TotalSteps)" Color="Color.Secondary" Size="Size.Small" Class="mb-2" Rounded="true" />
}

@if (!string.IsNullOrEmpty(Message))
{
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Message</MudText>
}

@if (ProposalsExtracted > 0 || EnrichmentsApplied > 0)
{
    <MudStack Row="true" Spacing="2" Class="mt-2">
        <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Lightbulb">@ProposalsExtracted proposed</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">@EnrichmentsApplied applied</MudChip>
    </MudStack>
}

@code {
    [Parameter] public HolocronJobStatus Stage { get; set; }
    [Parameter] public int CurrentStep { get; set; }
    [Parameter] public int TotalSteps { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public int ProposalsExtracted { get; set; }
    [Parameter] public int EnrichmentsApplied { get; set; }
    [Parameter] public bool ShowSubStepProgress { get; set; } = true;
    [Parameter] public bool Striped { get; set; } = true;
    [Parameter] public Color? ProgressColor { get; set; }
    [Parameter] public string? Class { get; set; }
}
