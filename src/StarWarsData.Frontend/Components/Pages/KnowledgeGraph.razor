@page "/knowledge-graph"
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject GlobalFilterService GlobalFilterService
@inject PageContextService PageContext
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Knowledge Graph — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="Explore a Star Wars knowledge graph with 166,000+ entities and 694,000+ relationships. Browse by type, search entities, and view temporal lifecycle data." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4 px-4">

    @* <MudText Typo="Typo.h5" Class="mb-4">Knowledge Graph</MudText> *@

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-0 pt-4">
    <MudTabPanel Text="Nodes" Icon="@Icons.Material.Filled.AccountTree">

    @* ── Bulk action bar (visible when nodes are selected) ── *@
    @if (_selectedItems.Count > 0)
    {
        <MudPaper Elevation="2" Class="pa-3 mb-3" Style="background-color: var(--mud-palette-primary-hover);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" />
                <MudText Typo="Typo.body1">
                    <strong>@_selectedItems.Count</strong> node@(_selectedItems.Count == 1 ? "" : "s") selected
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Hub"
                           OnClick="OpenSelectedInGraphExplorer"
                           Disabled="@(_selectedItems.Count == 0)">
                    Open in Graph Explorer
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopySelectedIds">
                    Copy PageIds
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSelection">
                    Clear
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    @* ── Filter card (MudPaper + MudGrid is the idiomatic MudBlazor pattern for
       a filter bar above a table — keeps filters out of MudTable.ToolBarContent
       which has flex-layout defects with input components, and gives us
       responsive 12-column layout with no custom CSS) ── *@
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField T="string" @bind-Value="_search" Placeholder="Search entities..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchChanged"
                              Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedType" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Types" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedLabel" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchEdgeLabels" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Relationships" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatPropertyKey(v))" MaxItems="20"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedSemantic" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchSemantics" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Dimensions" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatPropertyKey(v))" MaxItems="10"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSwitch T="bool" @bind-Value="_temporalOnly" @bind-Value:after="OnFilterChanged"
                           Color="Color.Primary" Label="Temporal only" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudToggleGroup T="string" @bind-Value="_selectedCalendar" @bind-Value:after="OnCalendarChanged"
                                Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                    <MudToggleItem T="string" Value="@("")" Text="All" />
                    <MudToggleItem T="string" Value="@("galactic")" Text="Galactic" />
                    <MudToggleItem T="string" Value="@("real")" Text="Real World" />
                </MudToggleGroup>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudNumericField T="int?" @bind-Value="_yearFromAbs" @bind-Value:after="OnYearInputChanged"
                                     Placeholder="@(_selectedCalendar == "real" ? "e.g. 1977" : "Year")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" Min="0"
                                     Label="From" />
                    @if (_selectedCalendar == "galactic")
                    {
                        <MudToggleGroup T="string" @bind-Value="_yearFromEra" @bind-Value:after="OnYearInputChanged"
                                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                            <MudToggleItem T="string" Value="@("BBY")" Text="BBY" />
                            <MudToggleItem T="string" Value="@("ABY")" Text="ABY" />
                        </MudToggleGroup>
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudNumericField T="int?" @bind-Value="_yearToAbs" @bind-Value:after="OnYearInputChanged"
                                     Placeholder="@(_selectedCalendar == "real" ? "e.g. 2025" : "Year")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" Min="0"
                                     Label="To" />
                    @if (_selectedCalendar == "galactic")
                    {
                        <MudToggleGroup T="string" @bind-Value="_yearToEra" @bind-Value:after="OnYearInputChanged"
                                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                            <MudToggleItem T="string" Value="@("BBY")" Text="BBY" />
                            <MudToggleItem T="string" Value="@("ABY")" Text="ABY" />
                        </MudToggleGroup>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable T="TemporalNodeDto" ServerData="LoadData" @ref="_table" Dense="true"
              Hover="true" Bordered="false" Striped="true" Elevation="1"
              Loading="_loading" LoadingProgressColor="Color.Primary"
              AllowUnsorted="false"
              MultiSelection="true" @bind-SelectedItems="_selectedItems"
              SelectOnRowClick="false">
        <HeaderContent>
            <MudTh Style="width:50px"></MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="name" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="type">Type</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="continuity">Continuity</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="startyear">Temporal Data</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:60px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (context.ImageUrl is not null)
                {
                    <MudAvatar Size="Size.Small">
                        <MudImage Src="@StripRevision(context.ImageUrl)" Alt="@context.Name" />
                    </MudAvatar>
                }
            </MudTd>
            <MudTd DataLabel="Name">
                <MudLink Href="@($"/graph-explorer/{context.Id}")" Underline="Underline.Hover">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                    @FormatTypeName(context.Type)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Continuity">
                @if (context.Continuity == "Canon")
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="font-size:10px;">Canon</MudChip>
                }
                else if (context.Continuity == "Legends")
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Style="font-size:10px;">Legends</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Temporal">
                @if (context.TemporalFacets.Count > 0)
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                        @foreach (var (facet, idx) in context.TemporalFacets.OrderBy(f => f.Order).Select((f, i) => (f, i)))
                        {
                            @if (idx > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                         Style="opacity:0.3; font-size:12px;" />
                            }
                            <MudTooltip Text="@($"{facet.Semantic} ({facet.Calendar})")">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@GetFacetColor(facet.Semantic)" Style="font-size:11px;">
                                    @FormatFacetRole(facet.Semantic): @facet.Text
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@(_expandedNodeId == context.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small" OnClick="@(() => ToggleDetails(context))" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedNodeId == context.Id)
            {
                <MudTr>
                    <td colspan="6">
                        <MudPaper Class="pa-4 ma-2" Outlined="true">
                            <MudGrid Spacing="2">
                                @if (context.ImageUrl is not null)
                                {
                                    <MudItem xs="12" sm="3" md="2">
                                        <MudImage Src="@StripRevision(context.ImageUrl)" Alt="@context.Name"
                                                  ObjectFit="ObjectFit.Contain" Style="max-height:200px; width:100%;"
                                                  Class="rounded" />
                                    </MudItem>
                                }
                                <MudItem xs="12" sm="@(context.ImageUrl is not null ? 9 : 12)" md="@(context.ImageUrl is not null ? 10 : 12)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                                        <MudText Typo="Typo.h6">@context.Name</MudText>
                                        @if (context.WikiUrl is not null)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                                           Href="@context.WikiUrl" Target="_blank" Color="Color.Primary" />
                                        }
                                        <MudTooltip Text="View in Graph Explorer">
                                            <MudIconButton Icon="@Icons.Material.Filled.Hub" Size="Size.Small"
                                                           Href="@($"/graph-explorer/{context.Id}")" Target="_blank" Color="Color.Secondary" />
                                        </MudTooltip>
                                        @if (IsSpatialKind(context.Type))
                                        {
                                            <MudTooltip Text="@($"Locate {context.Name} on the Galaxy Map")">
                                                <MudIconButton Icon="@Icons.Material.Filled.Explore" Size="Size.Small"
                                                               Href="@($"/galaxy-map/{context.Id}")" Target="_blank" Color="Color.Primary" />
                                            </MudTooltip>
                                        }
                                        @if (context.StartYear.HasValue || context.EndYear.HasValue)
                                        {
                                            <MudTooltip Text="@($"View timeline during {context.Name}")">
                                                <MudIconButton Icon="@Icons.Material.Filled.Timeline" Size="Size.Small"
                                                               Href="@($"/timeline/{context.Id}")" Target="_blank" Color="Color.Tertiary" />
                                            </MudTooltip>
                                        }
                                        @* Holocron enhance — open to any authenticated user. After completion the panel
                                             re-fetches labels + edges + node-enrichments for the current node, so newly
                                             written enrichments appear without requiring the user to collapse + re-expand. *@
                                        <AuthorizeView Context="auth">
                                            <MudTooltip Text="@(_holocronRunningForNodeId == context.Id ? "Re-open the live progress modal for the in-flight Holocron run on this node." : "Run the Holocron agent on this node — gathers context, calls the LLM, writes evidence-backed enrichments. Refreshes this panel when complete.")">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                                           OnClick="@(() => EnhanceWithHolocron(context))">
                                                    @if (_holocronRunningForNodeId == context.Id)
                                                    {
                                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                        <span>Enhancing… (view)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Enhance with Holocron</span>
                                                    }
                                                </MudButton>
                                            </MudTooltip>
                                        </AuthorizeView>
                                        @* Deep-link to the per-node Holocron history page — visible to ALL users
                                            (even anonymous), so anyone curious about what the agent did on a node
                                            can browse the run history + see any in-flight workflow.
                                            Mirrors the Character Timeline per-character page pattern. *@
                                        <MudTooltip Text="Open the per-node Holocron history page — see all past runs and any workflow currently in progress.">
                                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.History"
                                                       Href="@($"/holocron/jobs/{context.Id}")">
                                                Holocron history
                                            </MudButton>
                                        </MudTooltip>
                                    </MudStack>

                                    @* ── Temporal Facets ── *@
                                    @if (context.TemporalFacets.Count > 0)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                                            Timeline
                                        </MudText>
                                        @foreach (var group in context.TemporalFacets.GroupBy(f => f.Semantic.Split('.')[0]).OrderBy(g => g.Key))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="text-transform:capitalize;">
                                                @group.Key
                                            </MudText>
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2">
                                                @foreach (var (facet, idx) in group.OrderBy(f => f.Order).Select((f, i) => (f, i)))
                                                {
                                                    @if (idx > 0)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                                                 Color="Color.Secondary" Style="opacity:0.5;" />
                                                    }
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                             Color="@GetFacetColor(facet.Semantic)">
                                                        @FormatFacetRole(facet.Semantic): @facet.Text
                                                        @if (facet.Calendar == "real" && facet.Year.HasValue)
                                                        {
                                                            <text> (CE)</text>
                                                        }
                                                    </MudChip>
                                                }
                                            </MudStack>
                                        }

                                        @if (context.StartYear.HasValue && context.EndYear.HasValue)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="mb-3">
                                                Duration: @Math.Abs(context.EndYear.Value - context.StartYear.Value) years
                                            </MudChip>
                                        }
                                    }
                                    else if (context.StartYear.HasValue || context.EndYear.HasValue)
                                    {
                                        <MudStack Row="true" Spacing="2" Class="mb-3">
                                            @if (context.StartDateText is not null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                                    Start: @context.StartDateText
                                                </MudChip>
                                            }
                                            @if (context.EndDateText is not null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                                    End: @context.EndDateText
                                                </MudChip>
                                            }
                                        </MudStack>
                                    }

                                    @* ── Attributes + Phase 2 enhancements side-by-side ──
                                         Per user feedback: don't merge Phase 2 into the Phase 1 attributes table — there's no place to
                                         show evidence inline. Instead, render Phase 1 attributes on the left (canonical infobox data,
                                         unmodified) and a dedicated "Holocron-added attributes" card on the right with claim + evidence
                                         per enrichment. The two are stacked on small screens via xs=12 / md=6. *@
                                    <MudGrid Spacing="3" Class="mb-4">
                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle2" Class="mb-1">
                                                <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                                                Attributes
                                            </MudText>
                                            @if (context.Properties.Count > 0)
                                            {
                                                <MudSimpleTable Dense="true" Bordered="true" Striped="true" Style="font-size:13px;">
                                                    <tbody>
                                                        @foreach (var kvp in context.Properties.OrderBy(p => p.Key))
                                                        {
                                                            <tr>
                                                                <td style="font-weight:600; white-space:nowrap; width:1%; padding:4px 8px; vertical-align:top; text-transform:capitalize;">
                                                                    @FormatPropertyKey(kvp.Key)
                                                                </td>
                                                                <td style="padding:4px 8px;">
                                                                    @string.Join(", ", kvp.Value)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">No attributes recorded.</MudText>
                                            }
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudText Typo="Typo.subtitle2" Class="mb-1">
                                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                                                Holocron-added attributes
                                            </MudText>
                                            @if (_expandedNodeEnrichmentsLoading)
                                            {
                                                <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Style="max-width:400px;" />
                                            }
                                            else if (_expandedNodeEnrichments is { Count: > 0 })
                                            {
                                                @* Same MudSimpleTable layout as the Phase 1 Attributes table, with two extra
                                                     stacked elements on the value cell: the agent's claim (caption, secondary
                                                     colour) and the evidence excerpts (collapsible link). The "Op" chip in the
                                                     field cell distinguishes Add (whole new property) from Augment (extra values
                                                     on a Phase 1 list). Matching styling to the Phase 1 table — per user feedback:
                                                     Phase 2 should look like a peer of Phase 1, not a different visual category. *@
                                                <MudSimpleTable Dense="true" Bordered="true" Striped="true" Style="font-size:13px;">
                                                    <tbody>
                                                        @foreach (var en in _expandedNodeEnrichments)
                                                        {
                                                            <tr>
                                                                <td style="font-weight:600; white-space:nowrap; width:1%; padding:4px 8px; vertical-align:top; text-transform:capitalize;">
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Class="mr-1">@en.Operation</MudChip>
                                                                    @FormatPropertyKey(en.FieldPath)
                                                                </td>
                                                                <td style="padding:4px 8px;">
                                                                    @if (en.Values is { Count: > 0 })
                                                                    {
                                                                        <MudText Typo="Typo.body2">@string.Join(", ", en.Values)</MudText>
                                                                    }
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="display:block; font-style:italic;">@en.Claim</MudText>

                                                                    @if (en.Evidence is { Count: > 0 })
                                                                    {
                                                                        var enrichmentId = en.Id;
                                                                        var isExpanded = _expandedEnrichmentEvidence.Contains(enrichmentId);
                                                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="mt-1 px-1"
                                                                                   StartIcon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                                                   OnClick="@(() => ToggleEnrichmentEvidence(enrichmentId))">
                                                                            @($"{(isExpanded ? "Hide" : "Show")} {en.Evidence.Count} source{(en.Evidence.Count == 1 ? "" : "s")}")
                                                                        </MudButton>
                                                                        @if (isExpanded)
                                                                        {
                                                                            @foreach (var ev in en.Evidence)
                                                                            {
                                                                                <div style="border-left:2px solid var(--mud-palette-secondary); padding-left:8px; margin-top:4px;">
                                                                                    @if (ev.SourcePageId.HasValue)
                                                                                    {
                                                                                        <MudLink Href="@($"/graph-explorer/{ev.SourcePageId.Value}")" Underline="Underline.Hover" Typo="Typo.caption">
                                                                                            @(ev.SourcePageName ?? $"PageId {ev.SourcePageId}")
                                                                                        </MudLink>
                                                                                    }
                                                                                    <MudText Typo="Typo.caption" Style="display:block; font-style:italic;">"@ev.Excerpt"</MudText>
                                                                                </div>
                                                                            }
                                                                            <MudLink Href="@($"/holocron?pageId={context.Id}")" Typo="Typo.caption" Class="mt-1" Style="display:block;">
                                                                                See full Holocron entry →
                                                                            </MudLink>
                                                                        }
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">No Holocron enhancements yet — click "Enhance with Holocron" above to run the agent on this node.</MudText>
                                            }
                                        </MudItem>
                                    </MudGrid>

                                    @* ── Relationships (edge labels connecting this node to others) ── *@
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Class="mr-1" />
                                        Relationships
                                    </MudText>
                                    @if (_expandedLabelsLoading)
                                    {
                                        <MudProgressLinear Indeterminate="true" Color="Color.Info" Style="max-width:400px;" />
                                    }
                                    else if (_expandedLabels is { Count: > 0 })
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                            @foreach (var label in _expandedLabels)
                                            {
                                                @* Phase 2 provenance for relationship chips per Design-019:
                                                     - HolocronOnly      → secondary-coloured chip (Phase 2 added the relationship)
                                                     - HolocronAnnotated → primary chip + secondary dot (Phase 1 with Phase 2 context overlay)
                                                     - otherwise         → primary chip (Phase 1 only) *@
                                                var phase2Only = _holocronOnlyLabels.Contains(label);
                                                var annotated = _holocronAnnotatedLabels.Contains(label);
                                                var chipColor = phase2Only ? Color.Secondary : Color.Info;
                                                var chipTooltip = phase2Only
                                                    ? "Added by the Holocron agent — no Phase 1 edge with this label exists."
                                                    : annotated
                                                        ? "Phase 1 relationship with Holocron context attached (role/qualifier/description)."
                                                        : null;
                                                <MudTooltip Text="@chipTooltip" Disabled="@(chipTooltip is null)">
                                                    <MudChip T="string" Size="Size.Small" Color="@chipColor" Variant="Variant.Outlined"
                                                             Href="@($"/graph-explorer/{context.Id}")" Target="_self">
                                                        @FormatPropertyKey(label)
                                                        @if (annotated && !phase2Only)
                                                        {
                                                            <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background-color: var(--mud-palette-secondary); margin-left:6px; vertical-align:middle;"></span>
                                                        }
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No relationships found.</MudText>
                                    }

                                    @* ── Edges table — virtualised per-edge view with Phase 2 annotation context inline.
                                         Virtualize=true keeps high-degree nodes (Anakin: 671 edges) scrolling smoothly without
                                         server-side pagination. ItemSize is the average row height in px and feeds the virtualiser's
                                         viewport calculation; bumped above the default 50px because annotation rows can wrap to
                                         multiple lines (description text). FixedHeader keeps the column headers visible while
                                         the body scrolls. ── *@
                                    @if (_expandedEdgesLoading)
                                    {
                                        <MudProgressLinear Indeterminate="true" Color="Color.Info" Style="max-width:400px;" Class="mt-3" />
                                    }
                                    else if (_expandedEdges is { Count: > 0 })
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Class="mr-1" />
                                            Edges
                                            <MudText HtmlTag="span" Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                                                @(_expandedEdgesTotal > _expandedEdges.Count
                                                    ? $"showing {_expandedEdges.Count} of {_expandedEdgesTotal}"
                                                    : $"{_expandedEdges.Count}")
                                            </MudText>
                                        </MudText>
                                        <MudTable T="EntityEdgeRow" Items="_expandedEdges" Virtualize="true" FixedHeader="true" Height="520px"
                                                  ItemSize="64f" OverscanCount="6"
                                                  Dense="true" Hover="true" Striped="true" Bordered="true" Class="mb-2"
                                                  Style="font-size:13px;"
                                                  RowStyleFunc="@(static (EntityEdgeRow e, int _) => e.IsHolocronOnly ? "background-color: var(--mud-palette-secondary-hover);" : "")">
                                            <HeaderContent>
                                                <MudTh Style="width:1%;">Dir</MudTh>
                                                <MudTh>Label</MudTh>
                                                <MudTh>Target</MudTh>
                                                <MudTh>Years</MudTh>
                                                <MudTh>Holocron context</MudTh>
                                            </HeaderContent>
                                            @* `Context="edge"` disambiguates from the outer MudTable's ChildRowContent context (which is the
                                                 currently-expanded TemporalNodeDto). Without it, Razor can't tell which `context` the inner
                                                 RowTemplate refers to. *@
                                            <RowTemplate Context="edge">
                                                @{
                                                    var hasAnnotation = !string.IsNullOrWhiteSpace(edge.Role) || !string.IsNullOrWhiteSpace(edge.Qualifier) || !string.IsNullOrWhiteSpace(edge.Description);
                                                }
                                                <MudTd Style="white-space:nowrap;">
                                                    <MudIcon Icon="@(edge.Direction == "out" ? Icons.Material.Filled.ArrowOutward : Icons.Material.Filled.SubdirectoryArrowLeft)" Size="Size.Small" Color="@(edge.Direction == "out" ? Color.Tertiary : Color.Info)" />
                                                </MudTd>
                                                <MudTd Style="white-space:nowrap;">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(edge.IsHolocronOnly ? Color.Secondary : Color.Info)">
                                                        @FormatPropertyKey(edge.Label)
                                                        @if (hasAnnotation && !edge.IsHolocronOnly)
                                                        {
                                                            <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background-color: var(--mud-palette-secondary); margin-left:6px; vertical-align:middle;"></span>
                                                        }
                                                    </MudChip>
                                                </MudTd>
                                                <MudTd>
                                                    <MudLink Href="@($"/graph-explorer/{edge.OtherId}")" Underline="Underline.Hover">@edge.OtherName</MudLink>
                                                    @if (!string.IsNullOrEmpty(edge.OtherType))
                                                    {
                                                        <MudText HtmlTag="span" Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">(@edge.OtherType)</MudText>
                                                    }
                                                    @if (IsSpatialKind(edge.OtherType))
                                                    {
                                                        <MudTooltip Text="@($"Locate {edge.OtherName} on the Galaxy Map")">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Explore" Size="Size.Small"
                                                                           Href="@($"/galaxy-map/{edge.OtherId}")" Target="_blank" Color="Color.Primary" Class="ml-1" />
                                                        </MudTooltip>
                                                    }
                                                    @if (!string.IsNullOrEmpty(edge.Phase1Qualifier))
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Default" Style="display:block;">@edge.Phase1Qualifier</MudText>
                                                    }
                                                </MudTd>
                                                <MudTd Style="white-space:nowrap;">@FormatYearRange(edge.FromYear, edge.ToYear)</MudTd>
                                                <MudTd>
                                                    @if (edge.IsHolocronOnly)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Class="mr-1">Holocron-added</MudChip>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(edge.Role))
                                                    {
                                                        <MudText HtmlTag="span" Typo="Typo.body2"><b>@edge.Role</b></MudText>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(edge.Qualifier))
                                                    {
                                                        <MudText HtmlTag="span" Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">@edge.Qualifier</MudText>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(edge.Description))
                                                    {
                                                        <MudText Typo="Typo.caption" Style="display:block;">@edge.Description</MudText>
                                                    }
                                                    @if (edge.HolocronAppliedAt.HasValue)
                                                    {
                                                        var tooltip = $"Applied {edge.HolocronAppliedAt:yyyy-MM-dd HH:mm} UTC by {edge.HolocronAgentVersion ?? "(unknown agent)"}";
                                                        <MudTooltip Text="@tooltip">
                                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
                                                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">last updated @FormatRelativeTime(edge.HolocronAppliedAt.Value)</MudText>
                                                                @if (!string.IsNullOrEmpty(edge.HolocronJobId))
                                                                {
                                                                    <MudLink Href="@($"/holocron/jobs/{_expandedNodeId}")" Underline="Underline.Hover">
                                                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">view run</MudText>
                                                                    </MudLink>
                                                                }
                                                            </MudStack>
                                                        </MudTooltip>
                                                    }
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                No knowledge graph nodes found matching your filters.
            </MudAlert>
        </NoRecordsContent>
    </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Edges" Icon="@Icons.Material.Filled.Hub">
        @* ── Filter card (same MudPaper + MudGrid pattern as the Nodes tab) ── *@
        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudTextField T="string" @bind-Value="_labelSearch" Placeholder="Search labels..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnLabelSearchChanged"
                                  Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudAutocomplete T="string" @bind-Value="_labelFromType" @bind-Value:after="OnLabelFilterChanged"
                                     SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Placeholder="From type" Clearable="true" Dense="true"
                                     ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                     ResetValueOnEmptyText="true" CoerceValue="false" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudAutocomplete T="string" @bind-Value="_labelToType" @bind-Value:after="OnLabelFilterChanged"
                                     SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Placeholder="To type" Clearable="true" Dense="true"
                                     ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                     ResetValueOnEmptyText="true" CoerceValue="false" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudNumericField T="long?" @bind-Value="_labelMinCount" @bind-Value:after="OnLabelFilterChanged"
                                     Placeholder="Min count" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable T="EdgeLabelStatsDto" ServerData="LoadLabelStats" @ref="_labelTable" Dense="true"
                  Hover="true" Bordered="false" Striped="true" Elevation="1"
                  Loading="_labelsLoading" LoadingProgressColor="Color.Primary"
                  AllowUnsorted="false">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="label">Label</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="count" InitialDirection="SortDirection.Descending">Count</MudTableSortLabel>
                </MudTh>
                <MudTh>Continuity</MudTh>
                <MudTh>From types</MudTh>
                <MudTh>To types</MudTh>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="avgWeight">Avg conf.</MudTableSortLabel>
                </MudTh>
                <MudTh>Example</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Label">
                    <MudLink Href="@($"/knowledge-graph")" OnClick="@(() => JumpToNodesFilteredByLabel(context.Label))" Underline="Underline.Hover">
                        <strong>@FormatPropertyKey(context.Label)</strong>
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Count">@context.Count.ToString("N0")</MudTd>
                <MudTd DataLabel="Continuity">
                    <MudStack Row="true" Spacing="1">
                        @if (context.CanonCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="font-size:10px;">C: @context.CanonCount.ToString("N0")</MudChip>
                        }
                        @if (context.LegendsCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Style="font-size:10px;">L: @context.LegendsCount.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="From">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var tc in context.TopFromTypes)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px;">@FormatTypeName(tc.Type) · @tc.Count.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="To">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var tc in context.TopToTypes)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px;">@FormatTypeName(tc.Type) · @tc.Count.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="AvgWeight">@context.AvgWeight.ToString("F2")</MudTd>
                <MudTd DataLabel="Sample">
                    @if (context.Sample is { } s)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudLink Href="@($"/graph-explorer/{s.FromId}")" Underline="Underline.Hover">
                                <MudText Typo="Typo.caption">@s.FromName</MudText>
                            </MudLink>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="opacity:.4; font-size:14px;" />
                            <MudLink Href="@($"/graph-explorer/{s.ToId}")" Underline="Underline.Hover">
                                <MudText Typo="Typo.caption">@s.ToName</MudText>
                            </MudLink>
                        </MudStack>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
            <NoRecordsContent>
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    No relationship labels match your filters.
                </MudAlert>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
    </MudTabs>

</MudContainer>

@code {
    private MudTable<TemporalNodeDto>? _table;
    private bool _loading;
    private string _search = "";
    private string _selectedType = "";
    private bool _temporalOnly;
    private string _selectedSemantic = "";
    private string _selectedLabel = "";
    private string _selectedCalendar = "";
    private int? _yearFrom;
    private int? _yearTo;

    // Galactic mode: user-friendly absolute year + era selector
    private int? _yearFromAbs;
    private string _yearFromEra = "BBY";
    private int? _yearToAbs;
    private string _yearToEra = "ABY";
    private List<string> _entityTypes = [];
    private List<string> _edgeLabels = [];
    private int? _expandedNodeId;
    private List<string>? _expandedLabels;
    private bool _expandedLabelsLoading;

    // Phase 2 provenance buckets for the relationship chips of the currently-expanded
    // node. Populated alongside _expandedLabels — see ToggleDetails. Stored as HashSets
    // for O(1) chip-rendering lookups in the foreach loop. See Design-019.
    private HashSet<string> _holocronOnlyLabels = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _holocronAnnotatedLabels = new(StringComparer.OrdinalIgnoreCase);

    // Per-edge rows for the currently-expanded node (relationships drill-down table).
    // Fetched lazily on row-expand alongside the labels. Cap is server-controlled (default 50).
    private List<EntityEdgeRow>? _expandedEdges;
    private int _expandedEdgesTotal;
    private bool _expandedEdgesLoading;

    // Phase 2 attribute enrichments for the currently-expanded node — claim + evidence per row.
    // Renders in the Holocron-added attributes panel beside the Phase 1 attributes table.
    private List<EntityNodeEnrichmentRow>? _expandedNodeEnrichments;
    private bool _expandedNodeEnrichmentsLoading;

    // Per-enrichment evidence-toggle state. Empty by default → claim only renders, evidence
    // hidden behind a "Show N sources" link. Mirrors the Holocron Log row-expand pattern.
    private readonly HashSet<string> _expandedEnrichmentEvidence = new();

    private void ToggleEnrichmentEvidence(string enrichmentId)
    {
        if (!_expandedEnrichmentEvidence.Add(enrichmentId))
            _expandedEnrichmentEvidence.Remove(enrichmentId);
    }

    // Holocron in-flight: tracked by PageId so the right row's button shows the spinner while
    // the agent runs. Null when no enhance is in progress. Other rows' buttons stay disabled
    // (via _holocronRunningForNodeId.HasValue) so the user can't queue parallel enhances —
    // each call is single-node and synchronous server-side.
    private int? _holocronRunningForNodeId;

    // Multi-selection: persist across pages by tracking selected ids, not row references
    private HashSet<TemporalNodeDto> _selectedItems = new();

    // Edge Labels tab state
    private MudTable<EdgeLabelStatsDto>? _labelTable;
    private bool _labelsLoading;
    private string _labelSearch = "";
    private string _labelFromType = "";
    private string _labelToType = "";
    private long? _labelMinCount;

    private HttpClient Api => HttpClientFactory.CreateClient("StarWarsData");

    protected override async Task OnInitializedAsync()
    {
        GlobalFilterService.OnChange += OnGlobalFilterChanged;
        await Task.WhenAll(LoadEntityTypes(), LoadEdgeLabels());
        PublishPageContext(null);
    }

    // Publish "what the user is looking at" to the copilot. Page-only when no
    // node is expanded; subject-bound when one is. Called from OnInitialized
    // and ToggleDetails. Cleared on Dispose so the next page starts fresh.
    private void PublishPageContext(TemporalNodeDto? node)
    {
        var extras = new Dictionary<string, string>(StringComparer.Ordinal);

        if (node is null)
        {
            PageContext.Set(new PageContext(Page: "knowledge-graph", Extras: extras));
            return;
        }

        if (!string.IsNullOrEmpty(node.Continuity)) extras["continuity"] = node.Continuity;
        if (node.StartYear is int sy) extras["startYear"] = sy.ToString();
        if (node.EndYear is int ey) extras["endYear"] = ey.ToString();

        PageContext.Set(new PageContext(
            Page: "knowledge-graph",
            Subject: node.Name,
            SubjectKind: string.IsNullOrEmpty(node.Type) ? null : node.Type,
            SubjectId: node.Id,
            Extras: extras));
    }

    private async Task LoadEntityTypes()
    {
        try
        {
            var types = await Api.GetFromJsonAsync<List<string>>("api/RelationshipGraph/entity-types");
            if (types is { Count: > 0 })
                _entityTypes = types;
        }
        catch { }
    }

    private async Task LoadEdgeLabels()
    {
        try
        {
            var labels = await Api.GetFromJsonAsync<List<string>>("api/RelationshipGraph/edge-labels");
            if (labels is { Count: > 0 })
                _edgeLabels = labels;
        }
        catch { }
    }

    private static readonly string[] _semanticOptions = ["lifespan", "conflict", "construction", "creation", "institutional", "publication", "usage"];

    private Task<IEnumerable<string>> SearchEntityTypes(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _entityTypes.AsEnumerable()
            : _entityTypes.Where(t => FormatTypeName(t).Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchSemantics(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _semanticOptions.AsEnumerable()
            : _semanticOptions.Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchEdgeLabels(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _edgeLabels.AsEnumerable()
            : _edgeLabels.Where(l => FormatPropertyKey(l).Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private async void OnGlobalFilterChanged()
    {
        await InvokeAsync(async () =>
        {
            // Clear label selection if it might not exist in the new filter context
            if (!string.IsNullOrEmpty(_selectedLabel))
            {
                _selectedLabel = "";
            }

            await LoadEntityTypes();
            _table?.ReloadServerData();
            _labelTable?.ReloadServerData();
            StateHasChanged();
        });
    }

    private async Task<TableData<TemporalNodeDto>> LoadData(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var page = state.Page + 1;
            var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
            qs["page"] = page.ToString();
            qs["pageSize"] = state.PageSize.ToString();

            if (!string.IsNullOrWhiteSpace(_selectedType))
                qs["type"] = _selectedType;
            if (!string.IsNullOrWhiteSpace(_search))
                qs["q"] = _search;
            if (_temporalOnly)
                qs["temporalOnly"] = "true";
            if (!string.IsNullOrWhiteSpace(_selectedSemantic))
                qs["semantic"] = _selectedSemantic;
            if (!string.IsNullOrWhiteSpace(_selectedLabel))
                qs["label"] = _selectedLabel;
            if (!string.IsNullOrWhiteSpace(_selectedCalendar))
                qs["calendar"] = _selectedCalendar;
            if (_yearFrom.HasValue)
                qs["yearFrom"] = _yearFrom.Value.ToString();
            if (_yearTo.HasValue)
                qs["yearTo"] = _yearTo.Value.ToString();

            // Server-side sort via MudTableSortLabel
            if (!string.IsNullOrWhiteSpace(state.SortLabel))
            {
                qs["sortBy"] = state.SortLabel;
                qs["sortDirection"] = state.SortDirection == SortDirection.Descending
                    ? "descending"
                    : "ascending";
            }

            var c = GlobalFilterService.GetContinuityQueryParam();
            if (!string.IsNullOrEmpty(c))
                qs["continuity"] = c;
            var u = GlobalFilterService.GetRealmQueryParam();
            if (!string.IsNullOrEmpty(u))
                qs["realm"] = u;

            var result = await Api.GetFromJsonAsync<BrowseTemporalNodesResult>(
                $"api/RelationshipGraph/temporal-nodes?{qs}", ct);

            return new TableData<TemporalNodeDto>
            {
                Items = result?.Items ?? [],
                TotalItems = (int)(result?.Total ?? 0),
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load nodes: {ex.Message}", Severity.Error);
            return new TableData<TemporalNodeDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _table?.ReloadServerData();
    }

    private void OnFilterChanged()
    {
        _table?.ReloadServerData();
    }

    private async Task<TableData<EdgeLabelStatsDto>> LoadLabelStats(TableState state, CancellationToken ct)
    {
        _labelsLoading = true;
        try
        {
            var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
            qs["page"] = (state.Page + 1).ToString();
            qs["pageSize"] = state.PageSize.ToString();

            if (!string.IsNullOrWhiteSpace(_labelSearch))
                qs["q"] = _labelSearch;
            if (!string.IsNullOrWhiteSpace(_labelFromType))
                qs["fromType"] = _labelFromType;
            if (!string.IsNullOrWhiteSpace(_labelToType))
                qs["toType"] = _labelToType;
            if (_labelMinCount is > 0)
                qs["minCount"] = _labelMinCount.Value.ToString();

            if (!string.IsNullOrWhiteSpace(state.SortLabel))
            {
                qs["sortBy"] = state.SortLabel;
                qs["sortDirection"] = state.SortDirection == SortDirection.Descending
                    ? "descending"
                    : "ascending";
            }

            var c = GlobalFilterService.GetContinuityQueryParam();
            if (!string.IsNullOrEmpty(c))
                qs["continuity"] = c;
            var u = GlobalFilterService.GetRealmQueryParam();
            if (!string.IsNullOrEmpty(u))
                qs["realm"] = u;

            var result = await Api.GetFromJsonAsync<BrowseEdgeLabelsResult>(
                $"api/RelationshipGraph/edge-label-stats?{qs}", ct);

            return new TableData<EdgeLabelStatsDto>
            {
                Items = result?.Items ?? [],
                TotalItems = (int)(result?.Total ?? 0),
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load edge label stats: {ex.Message}", Severity.Error);
            return new TableData<EdgeLabelStatsDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _labelsLoading = false;
        }
    }

    private void OnLabelSearchChanged(string value)
    {
        _labelSearch = value;
        _labelTable?.ReloadServerData();
    }

    private void OnLabelFilterChanged()
    {
        _labelTable?.ReloadServerData();
    }

    private void JumpToNodesFilteredByLabel(string label)
    {
        // Switch the Nodes tab filter to this label and reload.
        _selectedLabel = label;
        _table?.ReloadServerData();
        Snackbar.Add($"Filtered nodes by '{FormatPropertyKey(label)}' — switch to the Nodes tab to view.", Severity.Info);
    }

    private async Task ToggleDetails(TemporalNodeDto node)
    {
        var nodeId = node.Id;
        if (_expandedNodeId == nodeId)
        {
            _expandedNodeId = null;
            _expandedLabels = null;
            _holocronOnlyLabels.Clear();
            _holocronAnnotatedLabels.Clear();
            _expandedEdges = null;
            _expandedEdgesTotal = 0;
            _expandedNodeEnrichments = null;
            // Collapsed — drop subject from page context but keep the page tag
            // so the copilot still knows we're on /knowledge-graph.
            PublishPageContext(null);
            return;
        }

        _expandedNodeId = nodeId;
        _expandedLabels = null;
        _holocronOnlyLabels.Clear();
        _holocronAnnotatedLabels.Clear();
        _expandedEdges = null;
        _expandedEdgesTotal = 0;
        _expandedNodeEnrichments = null;
        _expandedLabelsLoading = true;
        _expandedEdgesLoading = true;
        _expandedNodeEnrichmentsLoading = true;
        PublishPageContext(node);
        StateHasChanged();

        // Fetch labels (chip summary), edges (drill-down table), and Phase 2 attribute enrichments
        // (claim + evidence panel) in parallel — same node, three independent endpoints. Each
        // section paints as its data lands rather than blocking on the slowest fetch.
        var labelsTask = Api.GetFromJsonAsync<EntityLabelsResult>($"api/RelationshipGraph/labels/{nodeId}");
        var edgesTask = Api.GetFromJsonAsync<EntityEdgesResult>($"api/RelationshipGraph/edges/{nodeId}?limit=500");
        var nodeEnrichmentsTask = Api.GetFromJsonAsync<EntityNodeEnrichmentsResult>($"api/RelationshipGraph/node-enrichments/{nodeId}");

        try
        {
            var result = await labelsTask;
            _expandedLabels = result?.Labels ?? [];
            if (result is not null)
            {
                _holocronOnlyLabels = new HashSet<string>(result.HolocronOnlyLabels ?? [], StringComparer.OrdinalIgnoreCase);
                _holocronAnnotatedLabels = new HashSet<string>(result.HolocronAnnotatedLabels ?? [], StringComparer.OrdinalIgnoreCase);
            }
        }
        catch
        {
            _expandedLabels = [];
        }
        finally
        {
            _expandedLabelsLoading = false;
        }

        try
        {
            var edges = await edgesTask;
            _expandedEdges = edges?.Edges ?? [];
            _expandedEdgesTotal = edges?.Total ?? 0;
        }
        catch
        {
            _expandedEdges = [];
            _expandedEdgesTotal = 0;
        }
        finally
        {
            _expandedEdgesLoading = false;
        }

        try
        {
            var enrichments = await nodeEnrichmentsTask;
            _expandedNodeEnrichments = enrichments?.Enrichments ?? [];
        }
        catch
        {
            _expandedNodeEnrichments = [];
        }
        finally
        {
            _expandedNodeEnrichmentsLoading = false;
        }
    }

    /// <summary>
    /// Opens <see cref="StarWarsData.Frontend.Components.Shared.HolocronProgressDialog"/>,
    /// which kicks off POST /api/holocron/jobs/enhance/{pageId} and polls
    /// /api/holocron/jobs/{pageId}/status until terminal — rendering a stepper of the
    /// 7 workflow stages plus an activity feed bridged from the workflow events
    /// (mirrors the Character Timelines progress UX). When the dialog closes, refreshes
    /// the panel data so the new enrichments surface inline. Public to any authenticated
    /// user — the agent's own pre-flight rules and pass-budget settings bound the cost.
    /// </summary>
    private async Task EnhanceWithHolocron(TemporalNodeDto node)
    {
        var nodeId = node.Id;
        var nodeName = node.Name;
        // Re-clicking while a run is in flight re-opens the modal — the dialog itself
        // pre-checks status and re-attaches without firing a new POST. The previous
        // "no-op if already running" guard made the button feel broken when users
        // closed the modal mid-run and wanted to peek at progress again.
        _holocronRunningForNodeId = nodeId;
        StateHasChanged();
        try
        {
            var parameters = new DialogParameters<StarWarsData.Frontend.Components.Shared.HolocronProgressDialog>
            {
                { x => x.PageId, nodeId },
                { x => x.NodeName, nodeName },
            };
            // CloseOnEscapeKey + BackdropClick = true so the user can dismiss the modal
            // any way they like — closing only stops polling, the workflow keeps running.
            var options = new DialogOptions
            {
                CloseOnEscapeKey = true,
                BackdropClick = true,
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            };
            var dialog = await DialogService.ShowAsync<StarWarsData.Frontend.Components.Shared.HolocronProgressDialog>($"Enhance {nodeName}", parameters, options);
            var result = await dialog.Result;

            // Determine whether the run actually finished. The dialog returns the latest
            // HolocronStatusResponse (or null on early-close before the first poll). Only
            // refresh the panel when the run reached a terminal state during this dialog
            // session — otherwise the run is still in flight server-side.
            var finished = false;
            if (result is { Canceled: false, Data: StarWarsData.Frontend.Components.Shared.HolocronProgressDialog.HolocronStatusResponse status })
            {
                finished = status.Stage is HolocronJobStatus.Completed or HolocronJobStatus.Failed;
            }

            if (finished && _expandedNodeId == nodeId)
            {
                // Refresh the panel: collapse → expand re-fetches labels/edges/node-enrichments
                // in parallel, so the new enrichments surface inline.
                await ToggleDetails(node);
                await ToggleDetails(node);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Holocron call errored: {ex.Message}", Severity.Error);
        }
        finally
        {
            _holocronRunningForNodeId = null;
            StateHasChanged();
        }
    }

    /// <summary>Mirror of the API's <c>HolocronStatusDto</c> for response deserialisation.</summary>
