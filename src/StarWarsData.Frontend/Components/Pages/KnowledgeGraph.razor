    private static string FormatYearRange(int? fromYear, int? toYear)
    {
        if (!fromYear.HasValue && !toYear.HasValue)
            return "—";
        var f = fromYear.HasValue ? FormatYear(fromYear.Value) : "?";
        var t = toYear.HasValue ? FormatYear(toYear.Value) : "?";
        return f == t ? f : $"{f} → {t}";
    }

    private static string FormatYear(int year) => year < 0 ? $"{-year} BBY" : year > 0 ? $"{year} ABY" : "0 BBY/ABY";

    // Direct spatial KG types — those that have a /galaxy-map/{pageId} deep
    // link (per Design-031). Indirect spatial linking (Battle → location) is
    // Phase 2 of Design-030 and lives in the citation resolver.
    private static bool IsSpatialKind(string? type) => type is "System" or "CelestialBody" or "Sector" or "Region" or "TradeRoute";

    /// <summary>Render a UTC timestamp as a coarse "X ago" string for the edge-row last-updated caption.</summary>
    private static string FormatRelativeTime(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s ago";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return utc.ToString("yyyy-MM-dd");
    }

