@page "/knowledge-graph"
@using static StarWarsData.Frontend.Components.Shared.KnowledgeGraphFormatters
@using Microsoft.Extensions.AI
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject GlobalFilterService GlobalFilterService
@inject PageContextService PageContext
@inject PageControlService PageControl
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<KnowledgeGraph> Logger
@implements IDisposable

<PageTitle>Knowledge Graph — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="Explore a Star Wars knowledge graph with 166,000+ entities and 694,000+ relationships. Browse by type, search entities, and view temporal lifecycle data." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4 px-4">

    @* <MudText Typo="Typo.h5" Class="mb-4">Knowledge Graph</MudText> *@

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-0 pt-4"
             @bind-ActivePanelIndex="_activeTabIndex">
    <MudTabPanel Text="Nodes" Icon="@Icons.Material.Filled.AccountTree">

    @* ── Bulk action bar (visible when nodes are selected) ── *@
    @if (_selectedItems.Count > 0)
    {
        <MudPaper Elevation="2" Class="pa-3 mb-3" Style="background-color: var(--mud-palette-primary-hover);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" />
                <MudText Typo="Typo.body1">
                    <strong>@_selectedItems.Count</strong> node@(_selectedItems.Count == 1 ? "" : "s") selected
                </MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Hub"
                           OnClick="OpenSelectedInGraphExplorer"
                           Disabled="@(_selectedItems.Count == 0)">
                    Open in Graph Explorer
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopySelectedIds">
                    Copy PageIds
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSelection">
                    Clear
                </MudButton>
            </MudStack>
        </MudPaper>
    }

    @* ── Filter card (MudPaper + MudGrid is the idiomatic MudBlazor pattern for
       a filter bar above a table — keeps filters out of MudTable.ToolBarContent
       which has flex-layout defects with input components, and gives us
       responsive 12-column layout with no custom CSS) ── *@
    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField T="string" @bind-Value="_search" Placeholder="Search entities..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnSearchChanged"
                              Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedType" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Types" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedLabel" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchEdgeLabels" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Relationships" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatPropertyKey(v))" MaxItems="20"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudAutocomplete T="string" @bind-Value="_selectedSemantic" @bind-Value:after="OnFilterChanged"
                                 SearchFunc="SearchSemantics" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Placeholder="All Dimensions" Clearable="true" Dense="true"
                                 ToStringFunc="@(v => FormatPropertyKey(v))" MaxItems="10"
                                 ResetValueOnEmptyText="true" CoerceValue="false" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSwitch T="bool" @bind-Value="_temporalOnly" @bind-Value:after="OnFilterChanged"
                           Color="Color.Primary" Label="Temporal only" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudToggleGroup T="string" @bind-Value="_selectedCalendar" @bind-Value:after="OnCalendarChanged"
                                Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                    <MudToggleItem T="string" Value="@("")" Text="All" />
                    <MudToggleItem T="string" Value="@("galactic")" Text="Galactic" />
                    <MudToggleItem T="string" Value="@("real")" Text="Real World" />
                </MudToggleGroup>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudNumericField T="int?" @bind-Value="_yearFromAbs" @bind-Value:after="OnYearInputChanged"
                                     Placeholder="@(_selectedCalendar == "real" ? "e.g. 1977" : "Year")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" Min="0"
                                     Label="From" />
                    @if (_selectedCalendar == "galactic")
                    {
                        <MudToggleGroup T="string" @bind-Value="_yearFromEra" @bind-Value:after="OnYearInputChanged"
                                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                            <MudToggleItem T="string" Value="@("BBY")" Text="BBY" />
                            <MudToggleItem T="string" Value="@("ABY")" Text="ABY" />
                        </MudToggleGroup>
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudNumericField T="int?" @bind-Value="_yearToAbs" @bind-Value:after="OnYearInputChanged"
                                     Placeholder="@(_selectedCalendar == "real" ? "e.g. 2025" : "Year")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" Min="0"
                                     Label="To" />
                    @if (_selectedCalendar == "galactic")
                    {
                        <MudToggleGroup T="string" @bind-Value="_yearToEra" @bind-Value:after="OnYearInputChanged"
                                        Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
                            <MudToggleItem T="string" Value="@("BBY")" Text="BBY" />
                            <MudToggleItem T="string" Value="@("ABY")" Text="ABY" />
                        </MudToggleGroup>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable T="TemporalNodeDto" ServerData="LoadData" @ref="_table" Dense="true"
              Hover="true" Bordered="false" Striped="true" Elevation="1"
              Loading="_loading" LoadingProgressColor="Color.Primary"
              AllowUnsorted="false"
              MultiSelection="true" @bind-SelectedItems="_selectedItems"
              SelectOnRowClick="false">
        <HeaderContent>
            <MudTh Style="width:50px"></MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="name" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="type">Type</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="continuity">Continuity</MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="TemporalNodeDto" SortLabel="startyear">Temporal Data</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:60px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (context.ImageUrl is not null)
                {
                    <MudAvatar Size="Size.Small">
                        <MudImage Src="@StripRevision(context.ImageUrl)" Alt="@context.Name" />
                    </MudAvatar>
                }
            </MudTd>
            <MudTd DataLabel="Name">
                <MudLink Href="@($"/knowledge-graph/nodes/{context.Id}")" Underline="Underline.Hover">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                    @FormatTypeName(context.Type)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Continuity">
                @if (context.Continuity == "Canon")
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="font-size:10px;">Canon</MudChip>
                }
                else if (context.Continuity == "Legends")
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Style="font-size:10px;">Legends</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Temporal">
                @if (context.TemporalFacets.Count > 0)
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                        @foreach (var (facet, idx) in context.TemporalFacets.OrderBy(f => f.Order).Select((f, i) => (f, i)))
                        {
                            @if (idx > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"
                                         Style="opacity:0.3; font-size:12px;" />
                            }
                            <MudTooltip Text="@($"{facet.Semantic} ({facet.Calendar})")">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                         Color="@GetFacetColor(facet.Semantic)" Style="font-size:11px;">
                                    @FormatFacetRole(facet.Semantic): @facet.Text
                                </MudChip>
                            </MudTooltip>
                        }
                    </MudStack>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@(_expandedNodeId == context.Id ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small" OnClick="@(() => ToggleDetails(context))" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (_expandedNodeId == context.Id)
            {
                <MudTr>
                    <td colspan="6">
                        <MudPaper Class="pa-4 ma-2" Outlined="true">
                            <NodeDetailPanel Node="@context" />
                        </MudPaper>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 20, 50, 100 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                No knowledge graph nodes found matching your filters.
            </MudAlert>
        </NoRecordsContent>
    </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Edges" Icon="@Icons.Material.Filled.Hub">
        @* ── Filter card (same MudPaper + MudGrid pattern as the Nodes tab) ── *@
        <MudPaper Outlined="true" Class="pa-3 mb-3">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudTextField T="string" @bind-Value="_labelSearch" Placeholder="Search labels..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="OnLabelSearchChanged"
                                  Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudAutocomplete T="string" @bind-Value="_labelFromType" @bind-Value:after="OnLabelFilterChanged"
                                     SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Placeholder="From type" Clearable="true" Dense="true"
                                     ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                     ResetValueOnEmptyText="true" CoerceValue="false" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudAutocomplete T="string" @bind-Value="_labelToType" @bind-Value:after="OnLabelFilterChanged"
                                     SearchFunc="SearchEntityTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Placeholder="To type" Clearable="true" Dense="true"
                                     ToStringFunc="@(v => FormatTypeName(v))" MaxItems="20"
                                     ResetValueOnEmptyText="true" CoerceValue="false" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudNumericField T="long?" @bind-Value="_labelMinCount" @bind-Value:after="OnLabelFilterChanged"
                                     Placeholder="Min count" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Clearable="true" HideSpinButtons="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudTable T="EdgeLabelStatsDto" ServerData="LoadLabelStats" @ref="_labelTable" Dense="true"
                  Hover="true" Bordered="false" Striped="true" Elevation="1"
                  Loading="_labelsLoading" LoadingProgressColor="Color.Primary"
                  AllowUnsorted="false">
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="label">Label</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="count" InitialDirection="SortDirection.Descending">Count</MudTableSortLabel>
                </MudTh>
                <MudTh>Continuity</MudTh>
                <MudTh>From types</MudTh>
                <MudTh>To types</MudTh>
                <MudTh>
                    <MudTableSortLabel T="EdgeLabelStatsDto" SortLabel="avgWeight">Avg conf.</MudTableSortLabel>
                </MudTh>
                <MudTh>Example</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Label">
                    <MudLink Href="@($"/knowledge-graph")" OnClick="@(() => JumpToNodesFilteredByLabel(context.Label))" Underline="Underline.Hover">
                        <strong>@FormatPropertyKey(context.Label)</strong>
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Count">@context.Count.ToString("N0")</MudTd>
                <MudTd DataLabel="Continuity">
                    <MudStack Row="true" Spacing="1">
                        @if (context.CanonCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="font-size:10px;">C: @context.CanonCount.ToString("N0")</MudChip>
                        }
                        @if (context.LegendsCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" Style="font-size:10px;">L: @context.LegendsCount.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="From">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var tc in context.TopFromTypes)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px;">@FormatTypeName(tc.Type) · @tc.Count.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="To">
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var tc in context.TopToTypes)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px;">@FormatTypeName(tc.Type) · @tc.Count.ToString("N0")</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="AvgWeight">@context.AvgWeight.ToString("F2")</MudTd>
                <MudTd DataLabel="Sample">
                    @if (context.Sample is { } s)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudLink Href="@($"/knowledge-graph/nodes/{s.FromId}")" Underline="Underline.Hover">
                                <MudText Typo="Typo.caption">@s.FromName</MudText>
                            </MudLink>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="opacity:.4; font-size:14px;" />
                            <MudLink Href="@($"/knowledge-graph/nodes/{s.ToId}")" Underline="Underline.Hover">
                                <MudText Typo="Typo.caption">@s.ToName</MudText>
                            </MudLink>
                        </MudStack>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
            </PagerContent>
            <NoRecordsContent>
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                    No relationship labels match your filters.
                </MudAlert>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
    </MudTabs>

</MudContainer>

@code {
    private MudTable<TemporalNodeDto>? _table;
    private bool _loading;
    private string _search = "";
    private string _selectedType = "";
    private bool _temporalOnly;
    private string _selectedSemantic = "";
    private string _selectedLabel = "";
    private string _selectedCalendar = "";
    private int? _yearFrom;
    private int? _yearTo;

    // Galactic mode: user-friendly absolute year + era selector
    private int? _yearFromAbs;
    private string _yearFromEra = "BBY";
    private int? _yearToAbs;
    private string _yearToEra = "ABY";
    private List<string> _entityTypes = [];
    private List<string> _edgeLabels = [];
    // Currently-expanded row's PageId. The detail content (attributes, edges, enrichments,
    // Holocron-enhance dialog) is owned by <NodeDetailPanel>, which fetches its own data —
    // this page only tracks whether the panel is mounted in the row's ChildRowContent.
    private int? _expandedNodeId;

    // Multi-selection: persist across pages by tracking selected ids, not row references
    private HashSet<TemporalNodeDto> _selectedItems = new();

    // Edge Labels tab state
    private MudTable<EdgeLabelStatsDto>? _labelTable;
    private bool _labelsLoading;
    private string _labelSearch = "";
    private string _labelFromType = "";
    private string _labelToType = "";
    private long? _labelMinCount;

    // Tab index for MudTabs — bound so SP-4 can switch between Nodes (0) and Edges (1).
    private int _activeTabIndex;

    // Page-control registration token (Design-041); disposed in Dispose.
    private IDisposable? _pageControlRegistration;

    private HttpClient Api => HttpClientFactory.CreateClient("StarWarsData");

    protected override async Task OnInitializedAsync()
    {
        GlobalFilterService.OnChange += OnGlobalFilterChanged;
        await Task.WhenAll(LoadEntityTypes(), LoadEdgeLabels());
        PublishPageContext(null);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RegisterPageControlActions();
    }

    // Publish "what the user is looking at" to the copilot. Page-only when no
    // node is expanded; subject-bound when one is. Called from OnInitialized
    // and ToggleDetails. Cleared on Dispose so the next page starts fresh.
    private void PublishPageContext(TemporalNodeDto? node)
    {
        var extras = new Dictionary<string, string>(StringComparer.Ordinal);

        if (node is null)
        {
            PageContext.Set(new PageContext(Page: "knowledge-graph", Extras: extras));
            return;
        }

        if (!string.IsNullOrEmpty(node.Continuity)) extras["continuity"] = node.Continuity;
        if (node.StartYear is int sy) extras["startYear"] = sy.ToString();
        if (node.EndYear is int ey) extras["endYear"] = ey.ToString();

        PageContext.Set(new PageContext(
            Page: "knowledge-graph",
            Subject: node.Name,
            SubjectKind: string.IsNullOrEmpty(node.Type) ? null : node.Type,
            SubjectId: node.Id,
            Extras: extras));
    }

    private async Task LoadEntityTypes()
    {
        try
        {
            var types = await Api.GetFromJsonAsync<List<string>>("api/RelationshipGraph/entity-types");
            if (types is { Count: > 0 })
                _entityTypes = types;
        }
        catch { }
    }

    private async Task LoadEdgeLabels()
    {
        try
        {
            var labels = await Api.GetFromJsonAsync<List<string>>("api/RelationshipGraph/edge-labels");
            if (labels is { Count: > 0 })
                _edgeLabels = labels;
        }
        catch { }
    }

    private static readonly string[] _semanticOptions = ["lifespan", "conflict", "construction", "creation", "institutional", "publication", "usage"];

    private Task<IEnumerable<string>> SearchEntityTypes(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _entityTypes.AsEnumerable()
            : _entityTypes.Where(t => FormatTypeName(t).Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchSemantics(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _semanticOptions.AsEnumerable()
            : _semanticOptions.Where(s => s.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchEdgeLabels(string? value, CancellationToken ct)
    {
        var results = string.IsNullOrWhiteSpace(value)
            ? _edgeLabels.AsEnumerable()
            : _edgeLabels.Where(l => FormatPropertyKey(l).Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private async void OnGlobalFilterChanged()
    {
        await InvokeAsync(async () =>
        {
            // Clear label selection if it might not exist in the new filter context
            if (!string.IsNullOrEmpty(_selectedLabel))
            {
                _selectedLabel = "";
            }

            await LoadEntityTypes();
            _table?.ReloadServerData();
            _labelTable?.ReloadServerData();
            StateHasChanged();
        });
    }

    private async Task<TableData<TemporalNodeDto>> LoadData(TableState state, CancellationToken ct)
    {
        _loading = true;
        try
        {
            var page = state.Page + 1;
            var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
            qs["page"] = page.ToString();
            qs["pageSize"] = state.PageSize.ToString();

            if (!string.IsNullOrWhiteSpace(_selectedType))
                qs["type"] = _selectedType;
            if (!string.IsNullOrWhiteSpace(_search))
                qs["q"] = _search;
            if (_temporalOnly)
                qs["temporalOnly"] = "true";
            if (!string.IsNullOrWhiteSpace(_selectedSemantic))
                qs["semantic"] = _selectedSemantic;
            if (!string.IsNullOrWhiteSpace(_selectedLabel))
                qs["label"] = _selectedLabel;
            if (!string.IsNullOrWhiteSpace(_selectedCalendar))
                qs["calendar"] = _selectedCalendar;
            if (_yearFrom.HasValue)
                qs["yearFrom"] = _yearFrom.Value.ToString();
            if (_yearTo.HasValue)
                qs["yearTo"] = _yearTo.Value.ToString();

            // Server-side sort via MudTableSortLabel
            if (!string.IsNullOrWhiteSpace(state.SortLabel))
            {
                qs["sortBy"] = state.SortLabel;
                qs["sortDirection"] = state.SortDirection == SortDirection.Descending
                    ? "descending"
                    : "ascending";
            }

            var c = GlobalFilterService.GetContinuityQueryParam();
            if (!string.IsNullOrEmpty(c))
                qs["continuity"] = c;
            var u = GlobalFilterService.GetRealmQueryParam();
            if (!string.IsNullOrEmpty(u))
                qs["realm"] = u;

            var result = await Api.GetFromJsonAsync<BrowseTemporalNodesResult>(
                $"api/RelationshipGraph/temporal-nodes?{qs}", ct);

            return new TableData<TemporalNodeDto>
            {
                Items = result?.Items ?? [],
                TotalItems = (int)(result?.Total ?? 0),
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load nodes: {ex.Message}", Severity.Error);
            return new TableData<TemporalNodeDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        _table?.ReloadServerData();
    }

    private void OnFilterChanged()
    {
        _table?.ReloadServerData();
    }

    private async Task<TableData<EdgeLabelStatsDto>> LoadLabelStats(TableState state, CancellationToken ct)
    {
        _labelsLoading = true;
        try
        {
            var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
            qs["page"] = (state.Page + 1).ToString();
            qs["pageSize"] = state.PageSize.ToString();

            if (!string.IsNullOrWhiteSpace(_labelSearch))
                qs["q"] = _labelSearch;
            if (!string.IsNullOrWhiteSpace(_labelFromType))
                qs["fromType"] = _labelFromType;
            if (!string.IsNullOrWhiteSpace(_labelToType))
                qs["toType"] = _labelToType;
            if (_labelMinCount is > 0)
                qs["minCount"] = _labelMinCount.Value.ToString();

            if (!string.IsNullOrWhiteSpace(state.SortLabel))
            {
                qs["sortBy"] = state.SortLabel;
                qs["sortDirection"] = state.SortDirection == SortDirection.Descending
                    ? "descending"
                    : "ascending";
            }

            var c = GlobalFilterService.GetContinuityQueryParam();
            if (!string.IsNullOrEmpty(c))
                qs["continuity"] = c;
            var u = GlobalFilterService.GetRealmQueryParam();
            if (!string.IsNullOrEmpty(u))
                qs["realm"] = u;

            var result = await Api.GetFromJsonAsync<BrowseEdgeLabelsResult>(
                $"api/RelationshipGraph/edge-label-stats?{qs}", ct);

            return new TableData<EdgeLabelStatsDto>
            {
                Items = result?.Items ?? [],
                TotalItems = (int)(result?.Total ?? 0),
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load edge label stats: {ex.Message}", Severity.Error);
            return new TableData<EdgeLabelStatsDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _labelsLoading = false;
        }
    }

    private void OnLabelSearchChanged(string value)
    {
        _labelSearch = value;
        _labelTable?.ReloadServerData();
    }

    private void OnLabelFilterChanged()
    {
        _labelTable?.ReloadServerData();
    }

    private void JumpToNodesFilteredByLabel(string label)
    {
        // Switch the Nodes tab filter to this label and reload.
        _selectedLabel = label;
        _table?.ReloadServerData();
        Snackbar.Add($"Filtered nodes by '{FormatPropertyKey(label)}' — switch to the Nodes tab to view.", Severity.Info);
    }

    /// <summary>
    /// Toggle the expanded-detail panel for a row. The panel itself (NodeDetailPanel) owns
    /// its own data fetch + Holocron-enhance dialog; this method only flips visibility
    /// and updates the copilot's page context with the current subject.
    /// </summary>
    private Task ToggleDetails(TemporalNodeDto node)
    {
        if (_expandedNodeId == node.Id)
        {
            _expandedNodeId = null;
            PublishPageContext(null);
        }
        else
        {
            _expandedNodeId = node.Id;
            PublishPageContext(node);
        }
        return Task.CompletedTask;
    }

    private void OnYearInputChanged()
    {
        if (_selectedCalendar == "galactic")
        {
            _yearFrom = _yearFromAbs.HasValue ? (_yearFromEra == "BBY" ? -_yearFromAbs.Value : _yearFromAbs.Value) : null;
            _yearTo = _yearToAbs.HasValue ? (_yearToEra == "BBY" ? -_yearToAbs.Value : _yearToAbs.Value) : null;
        }
        else
        {
            _yearFrom = _yearFromAbs;
            _yearTo = _yearToAbs;
        }
        OnFilterChanged();
    }

    private void OnCalendarChanged()
    {
        _yearFromAbs = null;
        _yearToAbs = null;
        _yearFrom = null;
        _yearTo = null;
        _yearFromEra = "BBY";
        _yearToEra = "ABY";
        OnFilterChanged();
    }



    private void ClearSelection()
    {
        _selectedItems = new HashSet<TemporalNodeDto>();
    }

    private void OpenSelectedInGraphExplorer()
    {
        if (_selectedItems.Count == 0)
            return;

        // Graph explorer currently takes a single root. Open the first; users
        // can open additional nodes in new tabs via shift/ctrl-click on the
        // individual row links. For now, show a note and navigate to the first.
        var first = _selectedItems.First();
        if (_selectedItems.Count > 1)
        {
            Snackbar.Add(
                $"Graph Explorer takes one root at a time — opening '{first.Name}'. " +
                $"{_selectedItems.Count - 1} other(s) remain selected.",
                Severity.Info);
        }
        Navigation.NavigateTo($"/graph-explorer/{first.Id}");
    }

    private async Task CopySelectedIds()
    {
        if (_selectedItems.Count == 0)
            return;

        var ids = string.Join(",", _selectedItems.Select(n => n.Id));
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ids);
            Snackbar.Add($"Copied {_selectedItems.Count} PageId(s) to clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Clipboard copy failed", Severity.Warning);
        }
    }

    public void Dispose()
    {
        _pageControlRegistration?.Dispose();
        PageContext.Clear();
        GlobalFilterService.OnChange -= OnGlobalFilterChanged;
    }

    // ── Page-control: SP-4 driving /knowledge-graph (Design-041) ─────────────
    //
    // Coverage:
    //   1. Switch tab                     — knowledge_graph_switch_tab
    //   2. Apply node filters (any subset)— knowledge_graph_set_node_filters
    //   3. Apply edge filters             — knowledge_graph_set_edge_filters
    //   4. Reset filters                  — knowledge_graph_clear_filters
    //   5. Read the current node page     — knowledge_graph_list_nodes
    //   6. Read the current edge page     — knowledge_graph_list_edges
    //   7. Open a node's detail page      — knowledge_graph_open_node
    //
    // list_nodes/list_edges use LLM-as-matcher: the agent reads the rows
    // (each tagged with pageId) and picks the one matching the user's intent,
    // then calls open_node. Filter tools are forgiving: unknown type/label
    // values trigger a substring resolve against the entity-types and
    // edge-labels catalogues so phrasing like "starship" maps to the actual
    // canonical type name without an extra discovery turn.
    void RegisterPageControlActions()
    {
        var switchTab = AIFunctionFactory.Create(
            (string tab) =>
            {
                if (string.IsNullOrWhiteSpace(tab))
                    return "Provide 'nodes' or 'edges'.";
                var target = tab.Trim().ToLowerInvariant() switch
                {
                    "nodes" or "node" or "entities" => 0,
                    "edges" or "edge" or "relationships" or "labels" => 1,
                    _ => -1,
                };
                if (target < 0) return $"Unknown tab '{tab}'. Use 'nodes' or 'edges'.";
                _activeTabIndex = target;
                InvokeAsync(StateHasChanged);
                return target == 0
                    ? "Switched to the Nodes tab. Use knowledge_graph_set_node_filters to filter."
                    : "Switched to the Edges tab. Use knowledge_graph_set_edge_filters to filter.";
            },
            name: "knowledge_graph_switch_tab",
            description: "Switch between the 'nodes' (entities) and 'edges' (relationship labels) tabs. "
                + "Arg: tab ('nodes' or 'edges')."
        );

        var setNodeFilters = AIFunctionFactory.Create(
            (string? search, string? type, string? relationship, string? semantic,
             string? calendar, int? yearFrom, int? yearTo, bool? temporalOnly) =>
            {
                var changes = new List<string>();

                if (search is not null) { _search = search; changes.Add($"search='{search}'"); }

                if (type is not null)
                {
                    if (type.Length == 0) { _selectedType = ""; changes.Add("type=cleared"); }
                    else
                    {
                        var resolved = ResolveCatalogValue(type, _entityTypes, FormatTypeName);
                        if (resolved is null) return $"No entity type matches '{type}'. Try a shorter substring (e.g. 'starship').";
                        _selectedType = resolved;
                        changes.Add($"type={FormatTypeName(resolved)}");
                    }
                }

                if (relationship is not null)
                {
                    if (relationship.Length == 0) { _selectedLabel = ""; changes.Add("relationship=cleared"); }
                    else
                    {
                        var resolved = ResolveCatalogValue(relationship, _edgeLabels, FormatPropertyKey);
                        if (resolved is null) return $"No relationship matches '{relationship}'. Available examples: " + string.Join(", ", _edgeLabels.Take(8).Select(FormatPropertyKey));
                        _selectedLabel = resolved;
                        changes.Add($"relationship={FormatPropertyKey(resolved)}");
                    }
                }

                if (semantic is not null)
                {
                    if (semantic.Length == 0) { _selectedSemantic = ""; changes.Add("semantic=cleared"); }
                    else
                    {
                        var hit = _semanticOptions.FirstOrDefault(s => s.Equals(semantic, StringComparison.OrdinalIgnoreCase))
                            ?? _semanticOptions.FirstOrDefault(s => s.Contains(semantic, StringComparison.OrdinalIgnoreCase));
                        if (hit is null) return $"No semantic dimension matches '{semantic}'. Options: {string.Join(", ", _semanticOptions)}.";
                        _selectedSemantic = hit;
                        changes.Add($"semantic={hit}");
                    }
                }

                if (calendar is not null)
                {
                    var c = calendar.Trim().ToLowerInvariant();
                    var hit = c switch
                    {
                        "" or "all" or "any" => "",
                        "galactic" or "in-universe" or "iu" => "galactic",
                        "real" or "real-world" or "rw" => "real",
                        _ => null,
                    };
                    if (hit is null) return $"Unknown calendar '{calendar}'. Use 'galactic', 'real', or empty for all.";
                    _selectedCalendar = hit;
                    changes.Add($"calendar={(hit.Length == 0 ? "all" : hit)}");
                }

                // Signed year input: negative = BBY, positive = ABY (galactic),
                // or plain absolute year (real / all). Mirror the abs+era split
                // so the UI's NumericField + ToggleGroup reflect the choice.
                if (yearFrom is int yf)
                {
                    _yearFromAbs = Math.Abs(yf);
                    _yearFromEra = yf < 0 ? "BBY" : "ABY";
                    changes.Add($"yearFrom={yf}");
                }
                if (yearTo is int yt)
                {
                    _yearToAbs = Math.Abs(yt);
                    _yearToEra = yt < 0 ? "BBY" : "ABY";
                    changes.Add($"yearTo={yt}");
                }
                if (yearFrom is not null || yearTo is not null || calendar is not null)
                {
                    // Recompute the underlying _yearFrom/_yearTo from abs+era,
                    // then reload. OnYearInputChanged calls OnFilterChanged().
                    OnYearInputChanged();
                }

                if (temporalOnly is bool tOnly) { _temporalOnly = tOnly; changes.Add($"temporalOnly={tOnly}"); }

                if (changes.Count == 0) return "No filter values were provided — nothing changed.";

                _activeTabIndex = 0; // ensure user sees the Nodes tab they're filtering
                _table?.ReloadServerData();
                InvokeAsync(StateHasChanged);
                return "Applied node filters: " + string.Join(", ", changes) + ". Call knowledge_graph_list_nodes to read the matches.";
            },
            name: "knowledge_graph_set_node_filters",
            description: "Apply any combination of Nodes-tab filters. All args optional; pass only what should change. "
                + "search: text matched against entity names. "
                + "type: entity type (e.g. 'Starship', 'Character', 'Battle') — resolved by substring. "
                + "relationship: edge label (e.g. 'affiliated_with', 'destroyed') — resolved by substring. "
                + "semantic: temporal dimension ('lifespan', 'conflict', 'construction', 'creation', 'institutional', 'publication', 'usage'). "
                + "calendar: 'galactic' (in-universe BBY/ABY), 'real' (real-world year), or empty for both. "
                + "yearFrom / yearTo: SIGNED years — negative = BBY, positive = ABY in galactic mode; absolute in real/all. "
                + "temporalOnly: when true, only nodes with temporal data are returned. "
                + "Pass an empty string to clear an individual text filter."
        );

        var setEdgeFilters = AIFunctionFactory.Create(
            (string? search, string? fromType, string? toType, long? minCount) =>
            {
                var changes = new List<string>();

                if (search is not null) { _labelSearch = search; changes.Add($"search='{search}'"); }

                if (fromType is not null)
                {
                    if (fromType.Length == 0) { _labelFromType = ""; changes.Add("fromType=cleared"); }
                    else
                    {
                        var resolved = ResolveCatalogValue(fromType, _entityTypes, FormatTypeName);
                        if (resolved is null) return $"No entity type matches fromType='{fromType}'.";
                        _labelFromType = resolved;
                        changes.Add($"fromType={FormatTypeName(resolved)}");
                    }
                }

                if (toType is not null)
                {
                    if (toType.Length == 0) { _labelToType = ""; changes.Add("toType=cleared"); }
                    else
                    {
                        var resolved = ResolveCatalogValue(toType, _entityTypes, FormatTypeName);
                        if (resolved is null) return $"No entity type matches toType='{toType}'.";
                        _labelToType = resolved;
                        changes.Add($"toType={FormatTypeName(resolved)}");
                    }
                }

                if (minCount is long mc) { _labelMinCount = mc > 0 ? mc : null; changes.Add($"minCount={mc}"); }

                if (changes.Count == 0) return "No filter values were provided — nothing changed.";

                _activeTabIndex = 1; // surface the Edges tab
                _labelTable?.ReloadServerData();
                InvokeAsync(StateHasChanged);
                return "Applied edge filters: " + string.Join(", ", changes) + ". Call knowledge_graph_list_edges to read the matches.";
            },
            name: "knowledge_graph_set_edge_filters",
            description: "Apply any combination of Edges-tab filters (relationship-label statistics). "
                + "search: substring of the label name. "
                + "fromType / toType: entity types on either side of the relationship (resolved by substring). "
                + "minCount: hide labels with fewer than this many edges. "
                + "Pass an empty string to clear an individual text filter."
        );

        var clearFilters = AIFunctionFactory.Create(
            () =>
            {
                _search = "";
                _selectedType = "";
                _selectedLabel = "";
                _selectedSemantic = "";
                _selectedCalendar = "";
                _temporalOnly = false;
                _yearFromAbs = null;
                _yearToAbs = null;
                _yearFromEra = "BBY";
                _yearToEra = "ABY";
                _yearFrom = null;
                _yearTo = null;

                _labelSearch = "";
                _labelFromType = "";
                _labelToType = "";
                _labelMinCount = null;

                _table?.ReloadServerData();
                _labelTable?.ReloadServerData();
                InvokeAsync(StateHasChanged);
                return "Cleared all node and edge filters.";
            },
            name: "knowledge_graph_clear_filters",
            description: "Reset every filter on both the Nodes and Edges tabs to its default."
        );

        var listNodes = AIFunctionFactory.Create(
            async (int? limit) =>
            {
                var cap = limit is int n && n > 0 ? Math.Min(n, 50) : 20;
                try
                {
                    var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
                    qs["page"] = "1";
                    qs["pageSize"] = cap.ToString();
                    if (!string.IsNullOrWhiteSpace(_selectedType)) qs["type"] = _selectedType;
                    if (!string.IsNullOrWhiteSpace(_search)) qs["q"] = _search;
                    if (_temporalOnly) qs["temporalOnly"] = "true";
                    if (!string.IsNullOrWhiteSpace(_selectedSemantic)) qs["semantic"] = _selectedSemantic;
                    if (!string.IsNullOrWhiteSpace(_selectedLabel)) qs["label"] = _selectedLabel;
                    if (!string.IsNullOrWhiteSpace(_selectedCalendar)) qs["calendar"] = _selectedCalendar;
                    if (_yearFrom.HasValue) qs["yearFrom"] = _yearFrom.Value.ToString();
                    if (_yearTo.HasValue) qs["yearTo"] = _yearTo.Value.ToString();
                    var cont = GlobalFilterService.GetContinuityQueryParam();
                    if (!string.IsNullOrEmpty(cont)) qs["continuity"] = cont;
                    var realm = GlobalFilterService.GetRealmQueryParam();
                    if (!string.IsNullOrEmpty(realm)) qs["realm"] = realm;

                    var result = await Api.GetFromJsonAsync<BrowseTemporalNodesResult>(
                        $"api/RelationshipGraph/temporal-nodes?{qs}");

                    if (result is null || result.Items.Count == 0)
                        return "No nodes match the current filters. Try relaxing them with knowledge_graph_clear_filters.";

                    var lines = result.Items.Select(n =>
                    {
                        var era = n.StartYear.HasValue || n.EndYear.HasValue
                            ? $" · {n.StartYear?.ToString() ?? "?"}..{n.EndYear?.ToString() ?? "?"}"
                            : "";
                        return $"- #{n.Id} · {n.Name} ({FormatTypeName(n.Type)}, {n.Continuity}){era}";
                    });
                    return $"Top {result.Items.Count} of {result.Total:N0} matching nodes:\n"
                        + string.Join("\n", lines)
                        + "\n\nCall knowledge_graph_open_node(id) to navigate to one.";
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "knowledge_graph_list_nodes failed");
                    return $"Failed to list nodes: {ex.Message}";
                }
            },
            name: "knowledge_graph_list_nodes",
            description: "Read the first page of nodes matching the current Nodes-tab filters. Each line includes "
                + "the pageId, name, type, continuity, and temporal range. Use this to find the right node by reading "
                + "the list and picking the one that matches the user's phrasing. Optional 'limit' caps the output "
                + "(default 20, max 50)."
        );

        var listEdges = AIFunctionFactory.Create(
            async (int? limit) =>
            {
                var cap = limit is int n && n > 0 ? Math.Min(n, 50) : 20;
                try
                {
                    var qs = System.Web.HttpUtility.ParseQueryString(string.Empty);
                    qs["page"] = "1";
                    qs["pageSize"] = cap.ToString();
                    qs["sortBy"] = "count";
                    qs["sortDirection"] = "descending";
                    if (!string.IsNullOrWhiteSpace(_labelSearch)) qs["q"] = _labelSearch;
                    if (!string.IsNullOrWhiteSpace(_labelFromType)) qs["fromType"] = _labelFromType;
                    if (!string.IsNullOrWhiteSpace(_labelToType)) qs["toType"] = _labelToType;
                    if (_labelMinCount is > 0) qs["minCount"] = _labelMinCount.Value.ToString();
                    var cont = GlobalFilterService.GetContinuityQueryParam();
                    if (!string.IsNullOrEmpty(cont)) qs["continuity"] = cont;
                    var realm = GlobalFilterService.GetRealmQueryParam();
                    if (!string.IsNullOrEmpty(realm)) qs["realm"] = realm;

                    var result = await Api.GetFromJsonAsync<BrowseEdgeLabelsResult>(
                        $"api/RelationshipGraph/edge-label-stats?{qs}");

                    if (result is null || result.Items.Count == 0)
                        return "No relationship labels match the current Edges-tab filters.";

                    var lines = result.Items.Select(e =>
                    {
                        var fromTypes = string.Join("/", e.TopFromTypes.Take(3).Select(t => FormatTypeName(t.Type)));
                        var toTypes = string.Join("/", e.TopToTypes.Take(3).Select(t => FormatTypeName(t.Type)));
                        return $"- {FormatPropertyKey(e.Label)} · {e.Count:N0} edges · {fromTypes} → {toTypes}";
                    });
                    return $"Top {result.Items.Count} of {result.Total:N0} relationship labels:\n"
                        + string.Join("\n", lines)
                        + "\n\nCall knowledge_graph_set_node_filters(relationship: '<label>') to find the nodes using one.";
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "knowledge_graph_list_edges failed");
                    return $"Failed to list edges: {ex.Message}";
                }
            },
            name: "knowledge_graph_list_edges",
            description: "Read the most common relationship labels matching the current Edges-tab filters. "
                + "Each line includes the label, edge count, and dominant from/to entity types. "
                + "Optional 'limit' caps the output (default 20, max 50)."
        );

        var openNode = AIFunctionFactory.Create(
            (int pageId, string? name) =>
            {
                if (pageId <= 0) return "Provide a positive pageId from knowledge_graph_list_nodes.";
                Navigation.NavigateTo($"/knowledge-graph/nodes/{pageId}");
                var display = string.IsNullOrWhiteSpace(name) ? $"pageId {pageId}" : name!;
                return $"Opened the knowledge graph node detail for {display}.";
            },
            name: "knowledge_graph_open_node",
            description: "Navigate to a node's detail page by pageId. Get the pageId from knowledge_graph_list_nodes. "
                + "Optional 'name' is used in the confirmation message."
        );

        var actions = new PageAction[]
        {
            new(switchTab, Label: "Switch between Nodes and Edges tabs", Example: "show me the edges tab"),
            new(setNodeFilters, Label: "Filter the nodes list", Example: "show only canon starships from the clone wars"),
            new(setEdgeFilters, Label: "Filter the relationship labels", Example: "edges between characters and battles"),
            new(clearFilters, Label: "Clear all filters", Example: "reset the filters"),
            new(listNodes, Label: "Read the current node matches", Example: "what nodes match?"),
            new(listEdges, Label: "Read the relationship labels", Example: "list the relationship types"),
            new(openNode, Label: "Open a node's detail page", Example: "open Yoda"),
        };

        try
        {
            _pageControlRegistration = PageControl.Register("knowledge_graph", actions);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "PageControlService already had a registration; knowledge-graph page tools unavailable this circuit.");
        }
    }

    // Case-insensitive resolve of a user-typed value against a catalogue. Tries
    // exact (raw + formatted), then unique substring on either form. Returns
    // the canonical (raw) value or null when ambiguous / no match.
    static string? ResolveCatalogValue(string input, IReadOnlyList<string> catalogue, Func<string, string> format)
    {
        if (string.IsNullOrWhiteSpace(input) || catalogue.Count == 0) return null;
        var exact = catalogue.FirstOrDefault(v => v.Equals(input, StringComparison.OrdinalIgnoreCase)
            || format(v).Equals(input, StringComparison.OrdinalIgnoreCase));
        if (exact is not null) return exact;
        var matches = catalogue.Where(v => v.Contains(input, StringComparison.OrdinalIgnoreCase)
            || format(v).Contains(input, StringComparison.OrdinalIgnoreCase)).Take(2).ToList();
        return matches.Count == 1 ? matches[0] : null;
    }
}
