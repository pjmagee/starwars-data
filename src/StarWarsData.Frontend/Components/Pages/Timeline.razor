@page "/timeline"
@using StarWarsData.Models.Queries
@inject PageContextService PageContext
@inject PageControlService PageControl
@inject ILogger<Timeline> Logger
@implements IDisposable

<PageTitle>Timeline — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="Browse thousands of Star Wars timeline events across all eras — from the dawn of the Jedi to the rise of the First Order. Filter by category and year range, in-universe (BBY/ABY) or real-world publication dates." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4 px-4">

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-0 pt-4"
             @bind-ActivePanelIndex="_activeTabIndex">
        <MudTabPanel Text="Star Wars" Icon="@Icons.Material.Filled.Explore">
            <EventTimeline @ref="_swTimeline"
                           ShowCategoryFilter="true"
                           CalendarMode="Calendar.Galactic"
                           OnEventSelected="OnEventSelected" />
        </MudTabPanel>
        <MudTabPanel Text="Real World" Icon="@Icons.Material.Filled.CalendarMonth">
            <EventTimeline @ref="_realTimeline"
                           ShowCategoryFilter="true"
                           CalendarMode="Calendar.Real"
                           OnEventSelected="OnEventSelected" />
        </MudTabPanel>
    </MudTabs>

</MudContainer>

@code {
    int _activeTabIndex;
    EventTimeline? _swTimeline;
    EventTimeline? _realTimeline;
    IDisposable? _pageControlRegistration;

    string ActiveRealm => _activeTabIndex == 0 ? "Star Wars" : "Real World";
    EventTimeline? ActiveTimeline => _activeTabIndex == 0 ? _swTimeline : _realTimeline;

    protected override void OnInitialized()
    {
        PublishBaselineContext();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Register on first render — the child refs aren't bound until then.
        if (firstRender)
            RegisterPageControlActions();
    }

    void PublishBaselineContext()
    {
        // Page baseline — no SUBJECT until an event is selected. We pass the
        // active realm as a facet so SP-4 knows which timeline we're on without
        // needing to read the URL.
        PageContext.Set(new PageContext(
            Page: "timeline",
            Extras: new Dictionary<string, string>(StringComparer.Ordinal) { ["realm"] = ActiveRealm }));
    }

    void OnEventSelected(TimelineEvent ev)
    {
        // When the user clicks (or the agent calls timeline_select_event) we
        // publish a SUBJECT envelope so SP-4 can answer follow-up questions
        // about that specific event via the KG.
        if (ev.PageId is null)
        {
            PublishBaselineContext();
            return;
        }

        var kind = string.IsNullOrEmpty(ev.Template) ? "TimelineEvent" : CleanTemplateName(ev.Template);
        var extras = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["realm"] = ActiveRealm,
            ["year"] = ev.DisplayYear,
        };
        if (!string.IsNullOrEmpty(ev.Template))
            extras["category"] = CleanTemplateName(ev.Template);

        PageContext.Set(new PageContext(
            Page: "timeline",
            Subject: ev.Title ?? ev.DisplayTitle,
            SubjectKind: kind,
            SubjectId: ev.PageId,
            Extras: extras));
    }

    static string CleanTemplateName(string template)
    {
        var lastColon = template.LastIndexOf(':');
        var name = lastColon >= 0 ? template[(lastColon + 1)..] : template;
        return name.Replace("_infobox", "", StringComparison.OrdinalIgnoreCase);
    }

    void RegisterPageControlActions()
    {
        // Page-control catalogue for /timeline (Design-041 Phase 3).
        // Tools are organised around the four user-visible knobs on this page:
        //
        //   1. Tab          — timeline_set_realm
        //   2. Era range    — timeline_set_eras / timeline_list_eras
        //   3. Categories   — timeline_set_categories / timeline_list_categories
        //   4. Selection    — timeline_select_event
        //
        // Each handler delegates to the currently-active EventTimeline child;
        // when the realm tab flips, ActiveTimeline points at the other instance
        // and the same tool names target it transparently.
        //
        // The two list_* tools are MEDIA for the agent — read once when needed,
        // not on every turn. Tool descriptions instruct the agent to skip them
        // when it already knows valid names from prior context.

        // ── 1. Realm tab ────────────────────────────────────────────────────
        var setRealm = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            (string realm) =>
            {
                var r = realm?.Trim().ToLowerInvariant();
                var target = r switch
                {
                    "star wars" or "starwars" or "galactic" or "in-universe" => 0,
                    "real world" or "real" or "real-world" or "publication" => 1,
                    _ => -1,
                };
                if (target < 0)
                    return $"Unknown realm '{realm}'. Use 'Star Wars' (in-universe BBY/ABY) or 'Real World' (publication dates).";
                if (target == _activeTabIndex)
                    return $"Already on the {ActiveRealm} timeline tab.";
                _activeTabIndex = target;
                PublishBaselineContext();
                _ = InvokeAsync(StateHasChanged);
                return $"Switched to the {ActiveRealm} timeline tab.";
            },
            name: "timeline_set_realm",
            description: "Switch the timeline tab. Args: realm = 'Star Wars' (in-universe BBY/ABY events, eras apply) "
                + "or 'Real World' (real-world publication dates, no era filter)."
        );

        // ── 2. Era range ────────────────────────────────────────────────────
        var listEras = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            () =>
            {
                var t = ActiveTimeline;
                if (t is null) return "No active timeline tab.";
                if (t.IsRealWorldCalendar)
                    return "Era filtering is a Galactic-calendar concept and does not apply to the Real World tab.";
                if (t.AvailableEras.Count == 0)
                    return "Eras haven't loaded yet on this tab — try again in a moment.";
                var lines = t.AvailableEras
                    .OrderBy(e => e.StartDemarcation == Demarcation.Bby ? -e.StartYear : e.StartYear)
                    .Select(e =>
                    {
                        var range = $"{e.StartYear:0.##} {e.StartDemarcation.ToString().ToUpperInvariant()}–"
                                  + $"{e.EndYear:0.##} {e.EndDemarcation.ToString().ToUpperInvariant()}";
                        return $"- {e.Name} ({range})";
                    });
                return $"Eras available on the Star Wars tab (oldest first):\n" + string.Join("\n", lines);
            },
            name: "timeline_list_eras",
            description: "List every available era and its year range on the Star Wars tab. CALL THIS ONLY when you don't already "
                + "know the era names the user mentioned. Do not call it every turn."
        );

        var setEras = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            async (string? fromEra, string? toEra) =>
            {
                var t = ActiveTimeline;
                if (t is null) return "No active timeline tab.";
                if (t.IsRealWorldCalendar)
                    return "Era filtering doesn't apply to the Real World tab. Switch via timeline_set_realm first if you want era filters.";
                if (string.IsNullOrWhiteSpace(fromEra) && string.IsNullOrWhiteSpace(toEra))
                {
                    await t.ClearErasAsync();
                    await t.ApplyFiltersAsync();
                    return "Cleared the era filter — showing every era.";
                }
                var applied = await t.SetEraRangeAsync(fromEra, toEra);
                if (applied is null || applied.Count == 0)
                    return $"No matching eras for '{fromEra}' → '{toEra}'. Use timeline_list_eras to see valid names.";
                await t.ApplyFiltersAsync();
                return $"Era filter set: {applied.Count} era(s) from {t.FromEraName ?? "(open)"} to {t.ToEraName ?? "(open)"}. "
                    + $"Includes: {string.Join(", ", applied)}.";
            },
            name: "timeline_set_eras",
            description: "Set the era range (From / To inclusive) on the Star Wars tab, then reload events. "
                + "Args: fromEra (string, optional) and toEra (string, optional). Pass both null to clear. "
                + "Use the user's era phrasing — e.g. 'Republic Era', 'High Republic Era', 'Imperial Era'. "
                + "If you don't already know what's valid, call timeline_list_eras first."
        );

        // ── 3. Categories ───────────────────────────────────────────────────
        var listCategories = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            () =>
            {
                var t = ActiveTimeline;
                if (t is null || t.AvailableCategories.Count == 0)
                    return "No categories loaded yet — the timeline tab is still initialising.";
                var selected = t.SelectedCategories;
                var lines = t.AvailableCategories
                    .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
                    .Select(c => selected.Contains(c, StringComparer.OrdinalIgnoreCase) ? $"[x] {c}" : $"[ ] {c}");
                return $"Categories available on the {ActiveRealm} tab (x = currently selected):\n" + string.Join("\n", lines);
            },
            name: "timeline_list_categories",
            description: "List every available event-category on the active timeline tab. CALL THIS ONLY when the user's request "
                + "uses words you cannot map to a known category (e.g. 'unrest', 'first contact'). Common categories like "
                + "Battle, Treaty, War, Mission, Duel, Character, Government, Election, Disease are usually safe to set directly."
        );

        var setCategories = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            async (string[] categories) =>
            {
                var t = ActiveTimeline;
                if (t is null) return "No active timeline tab.";
                if (t.AvailableCategories.Count == 0)
                    return "Categories haven't loaded yet on this tab — try again in a moment.";
                var requested = categories ?? Array.Empty<string>();
                await t.SetCategoriesAsync(requested);
                var applied = t.SelectedCategories;
                var unmatched = requested.Where(r => !t.AvailableCategories.Contains(r, StringComparer.OrdinalIgnoreCase)).ToArray();
                await t.ApplyFiltersAsync();
                var summary = applied.Count switch
                {
                    0 => $"Cleared all category filters on the {ActiveRealm} tab — no events will show until categories are set.",
                    _ => $"Set {applied.Count} categor{(applied.Count == 1 ? "y" : "ies")} on the {ActiveRealm} tab: {string.Join(", ", applied)}.",
                };
                return unmatched.Length == 0
                    ? summary
                    : summary + $" (Ignored unknown: {string.Join(", ", unmatched)}.)";
            },
            name: "timeline_set_categories",
            description: "Replace the event-category multi-select and reload events. Pass an empty array to clear. "
                + "Args: categories (string array, e.g. ['Battle','Treaty']). Use category names verbatim from the chip set; "
                + "if uncertain, call timeline_list_categories first."
        );

        // ── 4. Event selection ──────────────────────────────────────────────
        var selectEvent = Microsoft.Extensions.AI.AIFunctionFactory.Create(
            async (int pageId) =>
            {
                var t = ActiveTimeline;
                if (t is null) return "No active timeline tab.";
                var match = await t.SelectEventByPageIdAsync(pageId);
                if (match is null)
                    return $"No timeline event with pageId {pageId} is currently loaded. Use timeline_set_categories / timeline_set_eras "
                        + "to load the relevant slice, then retry.";
                return $"Focused '{match.Title}' ({match.DisplayYear}, pageId {pageId}). The user's next question will be answered "
                    + "with this event as the SUBJECT — you can call get_entity_properties / get_entity_relationships on the pageId directly.";
            },
            name: "timeline_select_event",
            description: "Focus a specific event on the active timeline by its KG pageId. Scrolls it into view, outlines it, "
                + "and updates the SUBJECT envelope so follow-up questions resolve against that event. "
                + "Arg: pageId (int). The event must already be loaded (run timeline_set_categories / timeline_set_eras first if not)."
        );

        var actions = new PageAction[]
        {
            new(setRealm, Label: "Switch Star Wars / Real World tab", Example: "switch to the Real World timeline"),
            new(listEras, Label: "List eras", Example: "what eras are available?"),
            new(setEras, Label: "Filter by era range (From / To)", Example: "narrow to the High Republic and Imperial eras"),
            new(listCategories, Label: "List categories", Example: "what categories can I filter by?"),
            new(setCategories, Label: "Filter by event category", Example: "show me only battles and treaties"),
            new(selectEvent, Label: "Focus a specific event", Example: "open the Battle of Yavin"),
        };

        try
        {
            _pageControlRegistration = PageControl.Register("timeline", actions);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "PageControlService already had a registration; timeline page tools unavailable this circuit.");
        }
    }

    public void Dispose()
    {
        _pageControlRegistration?.Dispose();
        PageContext.Clear();
    }
}
