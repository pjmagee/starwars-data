@page "/knowledge-graph/nodes/{NodeId:int}"
@using static StarWarsData.Frontend.Components.Shared.KnowledgeGraphFormatters
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject GlobalFilterService GlobalFilterService
@inject PageContextService PageContext
@implements IDisposable

<PageTitle>@(_node?.Name ?? $"Node {NodeId}") — Knowledge Graph</PageTitle>
<HeadContent>
    <meta name="description" content="@(_node is null ? "Knowledge graph node detail." : $"Detail view for {_node.Name} — type {_node.Type}. Attributes, temporal data, relationships, and Holocron enrichments.")" />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="my-4 px-4">

    @* ── Breadcrumb so users see Knowledge Graph as the root of this surface ── *@
    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-2" />

    @if (_loading)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
            <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Loading node…</MudText>
        </MudStack>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }
    else if (_node is not null)
    {
        @* ── Header card: name, type/continuity, image, and pivot buttons ── *@
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudGrid Spacing="3">
                @if (_node.ImageUrl is not null)
                {
                    <MudItem xs="12" sm="3" md="2">
                        <MudImage Src="@StripRevision(_node.ImageUrl)" Alt="@_node.Name"
                                  ObjectFit="ObjectFit.Contain" Style="max-height:200px; width:100%;"
                                  Class="rounded" />
                    </MudItem>
                }
                <MudItem xs="12" sm="@(_node.ImageUrl is not null ? 9 : 12)" md="@(_node.ImageUrl is not null ? 10 : 12)">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
                        <MudText Typo="Typo.h5">@_node.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                            @FormatTypeName(_node.Type)
                        </MudChip>
                        @if (_node.Continuity == "Canon")
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary">Canon</MudChip>
                        }
                        else if (_node.Continuity == "Legends")
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary">Legends</MudChip>
                        }
                    </MudStack>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center">
                        @if (_node.WikiUrl is not null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Href="@_node.WikiUrl" Target="_blank">
                                Wookieepedia
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Hub"
                                   Href="@($"/graph-explorer/{_node.Id}")">
                            Open in Graph Explorer
                        </MudButton>
                        @if (IsSpatialKind(_node.Type))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Explore"
                                       Href="@($"/galaxy-map/{_node.Id}")">
                                Galaxy Map
                            </MudButton>
                        }
                        @if (_node.StartYear.HasValue || _node.EndYear.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Timeline"
                                       Href="@($"/timeline/{_node.Id}")">
                                Timeline
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.History"
                                   Href="@($"/holocron/jobs/{_node.Id}")">
                            Holocron history
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Detail panel — shared with the KnowledgeGraph row-expand surface so the
             content stays in sync between the two surfaces. ShowHeader=false because
             the header card above already exposes the action buttons; ShowImageInline=false
             because the image lives in the header card. ── *@
        <MudPaper Outlined="true" Class="pa-4">
            <NodeDetailPanel Node="_node" ShowHeader="false" ShowImageInline="false" />
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter] public int NodeId { get; set; }

    private TemporalNodeDto? _node;
    private bool _loading;
    private string? _error;
    private List<BreadcrumbItem> _breadcrumbs = [];

    private HttpClient Api => HttpClientFactory.CreateClient("StarWarsData");

    protected override void OnInitialized()
    {
        GlobalFilterService.OnChange += OnGlobalFilterChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_node?.Id == NodeId)
            return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _node = null;
        StateHasChanged();

        try
        {
            // Single-node fetch — same DTO shape as a row inside /api/RelationshipGraph/temporal-nodes.
            // 404 => "node not found"; any other failure surfaces the message inline.
            var response = await Api.GetAsync($"api/RelationshipGraph/temporal-nodes/{NodeId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _error = $"No knowledge graph node found with id {NodeId}.";
                return;
            }
            response.EnsureSuccessStatusCode();
            _node = await response.Content.ReadFromJsonAsync<TemporalNodeDto>();

            if (_node is null)
            {
                _error = $"No knowledge graph node found with id {NodeId}.";
                return;
            }

            RebuildBreadcrumbs();
            PublishPageContext();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load node: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void RebuildBreadcrumbs()
    {
        _breadcrumbs =
        [
            new BreadcrumbItem("Knowledge Graph", "/knowledge-graph"),
            new BreadcrumbItem("Nodes", "/knowledge-graph", disabled: true),
            new BreadcrumbItem(_node?.Name ?? $"#{NodeId}", null, disabled: true),
        ];
    }

    private void PublishPageContext()
    {
        if (_node is null)
        {
            PageContext.Set(new PageContext(Page: "knowledge-graph-node"));
            return;
        }

        var extras = new Dictionary<string, string>(StringComparer.Ordinal);
        if (!string.IsNullOrEmpty(_node.Continuity)) extras["continuity"] = _node.Continuity;
        if (_node.StartYear is int sy) extras["startYear"] = sy.ToString();
        if (_node.EndYear is int ey) extras["endYear"] = ey.ToString();

        PageContext.Set(new PageContext(
            Page: "knowledge-graph-node",
            Subject: _node.Name,
            SubjectKind: string.IsNullOrEmpty(_node.Type) ? null : _node.Type,
            SubjectId: _node.Id,
            Extras: extras));
    }

    private async void OnGlobalFilterChanged()
    {
        // A node's identity is invariant under continuity/realm filters, but its
        // edges + relationship labels are scoped to the filter — re-fetching the
        // node refreshes both the DTO and (through the NodeDetailPanel @key) the
        // panel state. We force a panel reload by nulling _node so the parameter
        // identity changes for the next render.
        if (_node is null)
            return;

        await InvokeAsync(async () =>
        {
            await LoadAsync();
        });
    }

    public void Dispose()
    {
        PageContext.Clear();
        GlobalFilterService.OnChange -= OnGlobalFilterChanged;
    }
}
