@page "/ask"
@page "/ask/{SessionId:guid}"
@using Microsoft.Agents.AI.AGUI
@using Microsoft.Extensions.AI
@inject IHttpClientFactory HttpClientFactory
@inject GlobalFilterService GlobalFilterService
@inject ChatHistoryService ChatHistory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILoggerFactory LoggerFactory
@inject ILogger<Ask> Logger
@inject LayoutService Layout
@implements IDisposable

<PageTitle>Ask AI — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="Ask questions about the Star Wars universe. AI agent with 30+ tools queries a knowledge graph of 166K entities and performs semantic search over 800K article passages." />
</HeadContent>

<div class="ask-chat-container">

    @if (_aiUnavailable)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="rounded-0" NoIcon="false">
            AI features are temporarily unavailable due to API quota limits. Other features such as Timeline, Data Tables, Graph Explorer, and Galaxy Maps remain fully operational.
        </MudAlert>
    }

    @* ── Scrollable conversation area ── *@
    <div class="ask-chat-messages" @ref="_messagesContainer">

        @if (_conversation.Count == 0 && !_loading)
        {
            @* ── Empty state: mode cards + examples ── *@
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4 py-sm-8">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4 mb-sm-6" Color="Color.Secondary">
                    What would you like to explore?
                </MudText>
                @* Mode card grid hidden below lg — compact layout kicks in at md (1024) too. *@
                <div class="d-none d-lg-flex flex-wrap gap-2 justify-center mb-6">
                    @foreach (var mode in _modes)
                    {
                        var m = mode;
                        var selected = _selectedMode == m.Key;
                        <MudPaper Outlined="true"
                                  Class="@($"pa-3 cursor-pointer mud-clickable d-flex flex-column align-center gap-1{(selected ? " mud-border-primary" : "")}")"
                                  Style="@($"width: 140px;{(selected ? $" border-color: var(--mud-palette-{m.Color.ToString().ToLower()}); border-width: 2px;" : "")}")"
                                  @onclick="() => ToggleMode(m.Key)">
                            <MudIcon Icon="@m.Icon" Color="@(selected ? m.Color : Color.Default)" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Align="Align.Center" Style="font-weight:600">@m.Label</MudText>
                        </MudPaper>
                    }
                </div>

                <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-3">
                    @(SelectedMode is null ? "Try asking" : $"{SelectedMode.Label} examples")
                </MudText>
                @if (FilteredExamples.Length == 0)
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="my-4">
                        No example prompts are cached for this filter combination yet. Ask a question directly or try toggling the Canon, Legends, Star Wars, or Real World filters.
                    </MudText>
                }
                else
                {
                    <MudGrid Spacing="2" Justify="Justify.Center">
                        @foreach (var example in FilteredExamples)
                        {
                            var prompt = example;
                            <MudItem xs="12" sm="6" md="4" Class="d-flex">
                                <MudPaper Outlined="true" Class="pa-3 cursor-pointer mud-clickable flex-grow-1" @onclick="() => UseExample(prompt)">
                                    <MudText Typo="Typo.body2">@prompt</MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudContainer>
        }
        else
        {
            @* ── Conversation messages ── *@
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Gutters="false" Class="py-4 px-2 px-lg-4">
                @foreach (var msg in _conversation)
                {
                    @if (msg.Role == ConversationRole.User)
                    {
                        <div @key="msg.Id" class="ask-msg ask-msg-user mb-3">
                            <MudPaper Elevation="0" Class="pa-3 d-flex align-start gap-3" Style="background:var(--mud-palette-background-grey); border-radius:12px;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                                <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@msg.Text</MudText>
                            </MudPaper>
                        </div>
                    }
                    else if (msg.Role == ConversationRole.ToolGroup)
                    {
                        <div @key="msg.Id" class="ask-msg ask-msg-tools mb-2 ml-2">
                            <MudPaper Elevation="0" Class="pa-2 px-3" Style="background:transparent;border-left:3px solid var(--mud-palette-primary);border-radius:0">
                                <div class="d-flex align-center gap-2 cursor-pointer" @onclick="() => msg.IsExpanded = !msg.IsExpanded" style="user-select:none">
                                    @if (msg.ToolCalls!.All(t => t.IsComplete))
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    }
                                    else
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                    }
                                    <MudText Typo="Typo.body2" Style="font-weight:600;flex:1">
                                        @{
                                            var done = msg.ToolCalls!.Count(t => t.IsComplete);
                                            var total = msg.ToolCalls!.Count;
                                        }
                                        @if (done == total)
                                        {
                                            @($"Used {total} tool{(total != 1 ? "s" : "")}")
                                        }
                                        else
                                        {
                                            @($"Working\u2026 ({done}/{total} tool{(total != 1 ? "s" : "")})")
                                        }
                                    </MudText>
                                    <MudIcon Icon="@(msg.IsExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Color="Color.Secondary" />
                                </div>
                                @if (msg.IsExpanded)
                                {
                                    <MudStack Spacing="1" Class="mt-2 ml-7">
                                        @foreach (var tc in msg.ToolCalls!)
                                        {
                                            var tool = tc;
                                            <MudPaper Elevation="0" Class="pa-2" Style="background: rgba(255,255,255,0.02); border-radius:6px;">
                                                <div class="d-flex align-center gap-2" style="cursor:pointer" @onclick="() => tool.IsDetailExpanded = !tool.IsDetailExpanded">
                                                    @if (tool.IsComplete)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" Style="font-size:14px" />
                                                    }
                                                    else
                                                    {
                                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Style="width:14px;height:14px" />
                                                    }
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="flex:1">@FriendlyToolName(tool.ToolName)</MudText>
                                                    @if (tool.IsComplete)
                                                    {
                                                        <MudIcon Icon="@(tool.IsDetailExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                                 Size="Size.Small" Color="Color.Secondary" Style="font-size:14px" />
                                                    }
                                                </div>
                                                @if (tool.IsDetailExpanded && tool.IsComplete)
                                                {
                                                    <div class="mt-2" style="font-size:12px;">
                                                        @if (!string.IsNullOrWhiteSpace(tool.Arguments))
                                                        {
                                                            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Input</MudText>
                                                            <pre style="background:rgba(0,0,0,0.3); padding:8px; border-radius:4px; overflow-x:auto; white-space:pre-wrap; word-break:break-word; color:#a0c4ff; font-size:11px; max-height:200px; overflow-y:auto;">@FormatJson(tool.Arguments)</pre>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(tool.Result))
                                                        {
                                                            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1 mt-2">Output</MudText>
                                                            <pre style="background:rgba(0,0,0,0.3); padding:8px; border-radius:4px; overflow-x:auto; white-space:pre-wrap; word-break:break-word; color:#a0ffa0; font-size:11px; max-height:300px; overflow-y:auto;">@FormatJson(tool.Result)</pre>
                                                        }
                                                    </div>
                                                }
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }
                            </MudPaper>
                        </div>
                    }
                    else if (msg.Role == ConversationRole.Visualization)
                    {
                        <div @key="msg.Id" class="ask-msg ask-msg-viz mb-3 ml-2">
                            @switch (msg.VisualizationType)
                            {
                                case "chart" when msg.ChartDescriptor is not null:
                                    <AskChartView Descriptor="msg.ChartDescriptor" />
                                    break;
                                case "graph" when msg.GraphDescriptor is not null:
                                    <AskGraphView Descriptor="msg.GraphDescriptor" />
                                    break;
                                case "table" when msg.TableDescriptor is not null:
                                    <AskTableView Descriptor="msg.TableDescriptor" />
                                    break;
                                case "data_table" when msg.DataTableDescriptor is not null:
                                    <AskDataTableView Descriptor="msg.DataTableDescriptor" />
                                    break;
                                case "timeline" when msg.TimelineDescriptor is not null:
                                    <AskTimelineView Descriptor="msg.TimelineDescriptor" />
                                    break;
                                case "infobox" when msg.InfoboxDescriptor is not null:
                                    <AskInfoboxView Descriptor="msg.InfoboxDescriptor" />
                                    break;
                                case "text" when msg.TextDescriptor is not null:
                                    <AskTextView Descriptor="msg.TextDescriptor" />
                                    break;
                                case "aurebesh" when msg.AurebeshDescriptor is not null:
                                    <AskAurebeshView Descriptor="msg.AurebeshDescriptor" />
                                    break;
                                case "family_tree" when msg.FamilyTreeDescriptor is not null:
                                    <FamilyTreeView Descriptor="msg.FamilyTreeDescriptor" />
                                    break;
                            }
                        </div>
                    }
                    else if (msg.Role == ConversationRole.Assistant)
                    {
                        <div @key="msg.Id" class="ask-msg ask-msg-assistant mb-3 ml-2">
                            <MudPaper Elevation="0" Class="pa-3 d-flex align-start gap-3" Style="border-radius:12px;">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Secondary" Style="margin-top:2px" />
                                <div style="flex:1; min-width:0;">
                                    <MudMarkdown Value="@msg.Text" />
                                </div>
                            </MudPaper>
                        </div>
                    }
                    else if (msg.Role == ConversationRole.Error)
                    {
                        <div @key="msg.Id" class="ask-msg mb-3 ml-2">
                            <MudAlert Severity="Severity.Error">@msg.Text</MudAlert>
                        </div>
                    }
                }

                @if (_loading)
                {
                    <div class="ask-msg mb-3 ml-2">
                        <MudPaper Elevation="0" Class="pa-3 d-flex align-center gap-2" Style="background:transparent">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Working…</MudText>
                        </MudPaper>
                    </div>
                }
            </MudContainer>
        }
    </div>

    @* ── Sticky input area at bottom ── *@
    <div class="ask-chat-input">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Gutters="false" Class="py-2 px-2 px-lg-4">

            @* Compact mode chips — visible lg and up only, hidden below *@
            <div class="d-none d-lg-flex flex-wrap gap-1 mb-2 justify-center">
                <MudChip T="string"
                         Color="@(_selectedMode == "auto" ? Color.Primary : Color.Default)"
                         Variant="@(_selectedMode == "auto" ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => _selectedMode = "auto")" Size="Size.Small">
                    Auto
                </MudChip>
                @foreach (var mode in _modes)
                {
                    var m = mode;
                    var sel = _selectedMode == m.Key;
                    <MudChip T="string"
                             Color="@(sel ? m.Color : Color.Default)"
                             Variant="@(sel ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleMode(m.Key))" Size="Size.Small"
                             Icon="@m.Icon">
                        @m.Label
                    </MudChip>
                }
            </div>

            @* Input row — single responsive layout: auto-growing text field + icon-only send button. *@
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="d-flex gap-1 align-center">
                    <MudTextField @bind-Value="_model.Prompt"
                                  Label="@(SelectedMode is null ? "Ask anything about Star Wars\u2026" : SelectedMode.Placeholder)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Immediate="true"
                                  FullWidth="true"
                                  Disabled="_loading"
                                  OnKeyDown="OnInputKeyDown"
                                  Sizing="InputSizing.Auto"
                                  MaxLines="6"
                                  Lines="1"
                                  Class="flex-grow-1" />
                    <MudTooltip Text="@(_loading ? "Thinking\u2026" : _aiUnavailable ? "Unavailable" : "Send")">
                        <MudIconButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Disabled="@(_loading || _aiUnavailable)"
                                       Icon="@(_loading ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Send)"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </EditForm>

            @if (!_isAuthenticated)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-2 d-none d-lg-block">
                    <MudLink Href="/authentication/login" Underline="Underline.Always" Color="Color.Secondary">Sign in</MudLink>
                    to save chat history, get more requests, and bring your own OpenAI key.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="mt-2 d-block d-lg-none">
                    <MudLink Href="/authentication/login" Underline="Underline.Always" Color="Color.Secondary">Sign in</MudLink>
                    for history &amp; more requests
                </MudText>
            }

        </MudContainer>
    </div>
</div>

<style>
    .ask-chat-container {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - 80px);
    }
    .ask-chat-messages {
        flex: 1;
        overflow-y: auto;
        min-height: 0;
    }
    .ask-chat-input {
        border-top: 1px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface);
    }
</style>

@code {

    [Parameter] public Guid? SessionId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // ── Conversation model ──

    enum ConversationRole { User, Assistant, ToolGroup, Visualization, Error }

    class ToolCallInfo
    {
        public string CallId { get; set; } = "";
        public string ToolName { get; set; } = "";
        public string Arguments { get; set; } = "";
        public string? Result { get; set; }
        public bool IsComplete { get; set; }
        public bool IsDetailExpanded { get; set; }
    }

    class ConversationMessage
    {
        public string Id { get; } = Guid.NewGuid().ToString("N");
        public ConversationRole Role { get; set; }
        public string? Text { get; set; }
        public List<ToolCallInfo>? ToolCalls { get; set; }
        public bool IsExpanded { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.UtcNow;

        // Visualization data (for Role == Visualization)
        public string? VisualizationType { get; set; }
        public ChartDescriptor? ChartDescriptor { get; set; }
        public GraphDescriptor? GraphDescriptor { get; set; }
        public TableDescriptor? TableDescriptor { get; set; }
        public DataTableDescriptor? DataTableDescriptor { get; set; }
        public TimelineDescriptor? TimelineDescriptor { get; set; }
        public InfoboxDescriptor? InfoboxDescriptor { get; set; }
        public TextDescriptor? TextDescriptor { get; set; }
        public AurebeshDescriptor? AurebeshDescriptor { get; set; }
        public FamilyTreeDescriptor? FamilyTreeDescriptor { get; set; }
    }

    // ── State ──
    //
    // Wire path: AGUIChatClient (Microsoft.Agents.AI.AGUI) wraps the AGUI SSE
    // protocol behind IChatClient — see Design-041. `_chatMessages` is the
    // canonical conversation history M.E.AI feeds back to the agent each turn;
    // `_conversation` is the UI render list, which carries extras the wire
    // protocol doesn't (Visualization, Error, ToolGroup) and stays in sync via
    // mirroring during streaming and session load.

    private readonly List<ConversationMessage> _conversation = [];
    private readonly List<ChatMessage> _chatMessages = [];

    // Per-turn streaming state — cleared at each SubmitAsync.
    // _callNames lets us recognise render_* tool calls by their FunctionResultContent
    // (which only carries CallId, not Name) so we can build the inline Visualization.
    // _toolGroupByCallId / _currentToolGroup group consecutive tool calls into a single
    // expandable card the same way the SSE-era code did (interrupted by any non-tool message).
    // _assistantByMessageId mirrors CopilotSidebar — rebuild assistant bubbles from the
    // canonical M.E.AI accumulator each tick, keyed by MessageId to avoid duplication
    // when AGUIChatClient emits both incremental deltas and a final assembled TextContent.
    private readonly Dictionary<string, string> _callNames = [];
    private readonly Dictionary<string, ToolCallInfo> _toolInfoByCallId = [];
    private readonly Dictionary<string, ConversationMessage> _assistantByMessageId = [];
    private ConversationMessage? _currentToolGroup;
    private bool _toolGroupInterrupted;
    // Set true after any render_* tool result fires this turn. Subsequent assistant text
    // is suppressed because the visualization IS the answer — any post-render prose
    // (or worse, JSON-as-text leaking from a regurgitated tool call) is clutter. The system
    // prompt instructs the agent to end the turn after rendering; this is the structural backstop.
    private bool _renderedThisTurn;

    private AskModel _model = new();
    private bool _loading;
    private ElementReference _messagesContainer;

    private IChatClient? _chatClient;

    private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

    // ── Session state ──
    private Guid? _currentSessionId;
    private string? _userId;
    private bool _isAuthenticated;

    // ── Mode selection ──

    private record VisualizationMode(
        string Key, string Label, string Description, string Placeholder,
        string Icon, Color Color, string[] Examples);

    private static readonly VisualizationMode[] _modes =
    [
        new("chart", "Chart", "Aggregate, compare, and visualize data across the entire Star Wars universe",
            "e.g. Which planets have the most species diversity?",
            Icons.Material.Filled.BarChart, Color.Primary,
            [
                "Which planets are home to the most distinct native species?",
                "Chart the top 15 organizations by number of affiliated characters",
                "Compare the number of battles fought at each major planet during the Clone Wars",
                "Pie chart showing the distribution of starship classes by manufacturer",
                "Bar chart of the deadliest wars by number of battles fought in each",
                "Radar chart comparing Anakin Skywalker, Obi-Wan Kenobi, and Mace Windu",
            ]),
        new("graph", "Graph", "Master-apprentice lineages, political hierarchies, and relationship networks (NOT family trees — use Family Tree mode for kinship)",
            "e.g. Map the full Darth Bane lineage through the Rule of Two",
            Icons.Material.Filled.AccountTree, Color.Secondary,
            [
                "Trace the Rule of Two: show every Sith master-apprentice link from Darth Bane to Darth Sidious",
                "Show how Dooku connects to both the Jedi Order and the Separatists through his relationships",
                "Show the political hierarchy of the Galactic Empire — who governed what and who reported to whom",
                "How is Thrawn connected to Palpatine through the chain of command?",
                "Map the Imperial Inquisitor chain of command under Darth Vader",
            ]),
        new("family_tree", "Family Tree", "Marriage-aware, generation-aligned family trees centered on a single Character",
            "e.g. Family tree of Anakin Skywalker",
            Icons.Material.Filled.FamilyRestroom, Color.Secondary,
            [
                "Family tree of Anakin Skywalker",
                "Show me the Skywalker family centered on Luke Skywalker",
                "Trace Leia Organa's lineage across three generations",
                "Family tree of Han Solo and Leia",
                "Trace Rey Skywalker's lineage to Emperor Palpatine",
            ]),
        new("table", "Browse", "Page through an entire collection of one entity type with the columns you pick",
            "e.g. Browse all wars with their dates, belligerents, and outcome",
            Icons.Material.Filled.ViewList, Color.Tertiary,
            [
                "Browse all wars with their date, belligerents, location, and outcome",
                "Show all fleets with their affiliation, commanding officer, and notable engagements",
                "List all treaties with their signatories, date, and the conflict they ended",
                "Browse all lightsabers with their crystal, owner, and type",
                "Show all space stations with their location, affiliation, and destruction date",
            ]),
        new("data_table", "Custom Grid", "A one-off grid the AI assembles by joining data from multiple queries",
            "e.g. Which Sith Lords outlived their masters, and by how long?",
            Icons.Material.Filled.Dataset, Color.Info,
            [
                "List every Sith master-apprentice pair, how each master died, and whether the apprentice was responsible",
                "Which characters were alive during both the Clone Wars and the Galactic Civil War? Show their allegiance in each",
                "Compare the founding date, capital world, and lifespan of every major galactic government",
                "Which military units switched allegiance during the fall of the Republic, and to whom?",
                "What governments existed when Palpatine was alive, and which ones did he control?",
            ]),
        new("timeline", "Timeline", "Temporal events scoped by era, date range, or entity lifetime",
            "e.g. Timeline of the fall of the Republic from the Naboo Crisis to Order 66",
            Icons.Material.Filled.Timeline, Color.Warning,
            [
                "Timeline of the fall of the Republic from the Naboo Crisis to Order 66",
                "Show every battle, duel, and mission during the Clone Wars from 22 BBY to 19 BBY",
                "Timeline of all Mandalorian wars and conflicts from ancient times to the Imperial era",
                "What treaties, laws, and elections shaped galactic politics between 1000 BBY and 0 BBY?",
                "Show the lifecycle of the Jedi Order — founding, schisms, purges, and reformations",
            ]),
        new("infobox", "Infobox", "Detailed wiki-style profiles and side-by-side entity comparisons",
            "e.g. Compare the Death Star and Starkiller Base side by side",
            Icons.Material.Filled.Badge, Color.Success,
            [
                "Compare the Death Star, Death Star II, Starkiller Base, and the Star Forge side by side",
                "Show full profiles of all seven lightsaber combat forms",
                "Put the Venator, Imperial, and Executor class Star Destroyers next to each other",
                "Compare Darth Revan, Darth Nihilus, and Darth Traya",
                "Show the profile of the Chiss Ascendancy",
            ]),
        new("text", "Research", "AI semantic search across 800K+ article passages for lore, motivations, and deep analysis",
            "e.g. Why did Palpatine tell Anakin about the power to save the ones he loved?",
            Icons.Material.Filled.AutoAwesome, Color.Dark,
            [
                "Why did Palpatine tell Anakin the tragedy of Darth Plagueis, and how did it lead to Anakin's fall?",
                "What motivated Count Dooku to leave the Jedi Order, and how did Sidious exploit that?",
                "How did the destruction of Alderaan change galactic opinion of the Empire and fuel the Rebellion?",
                "Why did the Jedi fail to detect Palpatine as a Sith Lord despite him being right under their noses?",
                "What was the philosophy behind the Rule of Two, and how did each Sith Lord interpret it differently?",
                "Explain how Mustafar transformed Anakin into Vader — the physical, psychological, and Force consequences",
            ]),
    ];

    private string _selectedMode = "auto";
    private VisualizationMode? SelectedMode => _selectedMode == "auto" ? null : _modes.FirstOrDefault(m => m.Key == _selectedMode);

    // Dynamic suggestions fetched from api/suggestions; falls back to the hardcoded
    // pool (shuffled without replacement) when the cache is empty or the endpoint errors.
    // NOTE: the hardcoded pool is exclusively in-universe (Realm=Starwars). When the user
    // has filtered to Real World only, we must NOT fall back to it — showing in-universe
    // prompts would violate the filter. Instead we return an empty set and rely on the
    // card grid to render nothing for that combination.
    private string[] _randomExamples = [];

    private static string[] ShuffleFallback(string? mode, bool allowInUniverse)
    {
        if (!allowInUniverse)
            return [];

        var pool = mode is null
            ? _modes.SelectMany(m => m.Examples).ToArray()
            : (_modes.FirstOrDefault(m => m.Key == mode)?.Examples ?? _modes.SelectMany(m => m.Examples).ToArray()).ToArray();
        // Random.Shared.Shuffle is in-place; then Take samples without replacement.
        Random.Shared.Shuffle(pool);
        return pool.Take(6).ToArray();
    }

    private async Task LoadSuggestionsAsync(string? mode = null)
    {
        // Continuity/realm always mirror the global filter; mode is an extra narrowing.
        var continuity = GlobalFilterService.GetContinuityQueryParam();
        var realm = GlobalFilterService.GetRealmQueryParam();

        // The hardcoded fallback pool is all in-universe. It is only safe to use when the
        // user has not filtered to Real-only. In-universe selected, Real-only filter, and
        // "both realms" all permit the in-universe fallback; Real-only does not.
        var allowInUniverseFallback = !string.Equals(realm, "Real", StringComparison.OrdinalIgnoreCase);

        try
        {
            // Mode-scoped API call honoring the global filter. If the bucket has fewer
            // than 6 items, the API returns whatever it has — we render that directly
            // rather than retrying without the mode, because cross-mode leakage (e.g.
            // chart prompts showing on the infobox cards) is worse UX than a short list.
            var items = await FetchSuggestionsAsync(mode, continuity, realm);

            if (items is { Count: > 0 })
            {
                _randomExamples = items.Select(i => i.Prompt).ToArray();
                return;
            }

            // API returned nothing — either cache is unseeded or the bucket is genuinely
            // empty. Fall back to the hardcoded mode-scoped pool only if the active realm
            // filter allows in-universe content; otherwise return an empty set so the UI
            // doesn't render prompts that violate the filter.
            _randomExamples = ShuffleFallback(mode, allowInUniverseFallback);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load dynamic Ask suggestions; using hardcoded fallback");
            _randomExamples = ShuffleFallback(mode, allowInUniverseFallback);
        }
    }

    private async Task<List<SuggestionDto>?> FetchSuggestionsAsync(string? mode, string? continuity, string? realm)
    {
        var qs = new List<string> { "count=6" };
        if (!string.IsNullOrEmpty(mode))
            qs.Add($"mode={Uri.EscapeDataString(mode)}");
        if (!string.IsNullOrEmpty(continuity))
            qs.Add($"continuity={Uri.EscapeDataString(continuity)}");
        if (!string.IsNullOrEmpty(realm))
            qs.Add($"realm={Uri.EscapeDataString(realm)}");

        return await Http.GetFromJsonAsync<List<SuggestionDto>>($"api/suggestions?{string.Join("&", qs)}");
    }

    private sealed record SuggestionDto(string Mode, string Shape, string Prompt, string Continuity, string Realm, List<int> EntityIds);

    private void ToggleMode(string key)
    {
        _selectedMode = _selectedMode == key ? "auto" : key;
        _ = InvokeAsync(async () =>
        {
            await LoadSuggestionsAsync(_selectedMode == "auto" ? null : _selectedMode);
            StateHasChanged();
        });
    }

    // Now that dynamic suggestions are loaded per-mode on toggle, _randomExamples
    // already reflects the selected mode; no need to fall back to hardcoded pools.
    private string[] FilteredExamples => _randomExamples;

    public class AskModel
    {
        [Required(ErrorMessage = "Please enter a question.")]
        public string Prompt { get; set; } = string.Empty;
    }

    private bool _aiUnavailable;

    private HttpClient Http => HttpClientFactory.CreateClient("StarWarsData");

    protected override async Task OnInitializedAsync()
    {
        // Two chat surfaces on the same page is redundant — suppress the right
        // copilot drawer while /ask is active. Cleared in Dispose.
        Layout.SetHideCopilot(true);

        // AGUIChatClient is an IChatClient over the AGUI SSE protocol. The named
        // "StarWarsData" HttpClient has the X-User-Id and rate-limit-body-capture
        // handlers, plus resilience disabled so long SSE streams aren't cut by
        // the default 30s timeout (Program.cs).
        //
        // No .UseFunctionInvocation() here — /ask has no client-side (frontend)
        // tools; render_* and every other tool runs server-side in AskAIAgent.
        // Server-executed tools still surface as FunctionCallContent /
        // FunctionResultContent on the streaming response and drive the tool
        // group + inline visualization.
        var http = HttpClientFactory.CreateClient("StarWarsData");
        _chatClient = new AGUIChatClient(
            http,
            "kernel/stream",
            LoggerFactory,
            jsonSerializerOptions: null,
            serviceProvider: null);

        ChatHistory.OnChange += OnChatHistoryChanged;
        GlobalFilterService.OnChange += OnGlobalFilterChanged;

        if (AuthState is not null)
        {
            var state = await AuthState;
            _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            _userId = state.User.FindFirst("sub")?.Value
                      ?? state.User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")?.Value;

            ChatHistory.SetAuthenticated(_isAuthenticated);
        }

        await CheckAiStatusAsync();
        await LoadSuggestionsAsync();
    }

    private async Task CheckAiStatusAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<AiStatusResponse>("api/ai/status");
            _aiUnavailable = response?.Status is "QuotaExceeded" or "RateLimited";
        }
        catch
        {
            // If the status endpoint itself fails, don't block the page
        }
    }

    private record AiStatusResponse(string Status, int ErrorsLastHour);

    private void OnChatHistoryChanged()
    {
        InvokeAsync(() =>
        {
            // Only reset when "New Chat" was explicitly clicked (ActiveSessionId cleared)
            // AND we're not in the middle of streaming a response
            if (ChatHistory.ActiveSessionId is null
                && (_currentSessionId is not null || _conversation.Count > 0)
                && !_loading)
            {
                ResetChat();
            }
            StateHasChanged();
        });
    }

    private void ResetChat()
    {
        _currentSessionId = null;
        _model = new AskModel();
        _conversation.Clear();
        _chatMessages.Clear();
        _callNames.Clear();
        _toolInfoByCallId.Clear();
        _assistantByMessageId.Clear();
        _currentToolGroup = null;
        _toolGroupInterrupted = false;
        _renderedThisTurn = false;
        // Intermediate placeholder while LoadSuggestionsAsync runs — respect the current realm filter.
        var allowInUniverse = !string.Equals(GlobalFilterService.GetRealmQueryParam(), "Real", StringComparison.OrdinalIgnoreCase);
        _randomExamples = ShuffleFallback(_selectedMode == "auto" ? null : _selectedMode, allowInUniverse);
        StateHasChanged();
        _ = InvokeAsync(async () =>
        {
            await LoadSuggestionsAsync(_selectedMode == "auto" ? null : _selectedMode);
            StateHasChanged();
        });
    }

    private void OnGlobalFilterChanged()
    {
        // Continuity/Realm toggle changed — reload dynamic suggestions so the empty-state
        // cards match the newly-selected filter scope.
        _ = InvokeAsync(async () =>
        {
            await LoadSuggestionsAsync(_selectedMode == "auto" ? null : _selectedMode);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Layout.SetHideCopilot(false);
        ChatHistory.OnChange -= OnChatHistoryChanged;
        GlobalFilterService.OnChange -= OnGlobalFilterChanged;
        (_chatClient as IDisposable)?.Dispose();
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _isAuthenticated)
        {
            // Migrate any anonymous localStorage sessions to the authenticated API
            await MigrateAnonymousSessionsAsync();
        }
    }

    private async Task MigrateAnonymousSessionsAsync()
    {
        try
        {
            var localSessions = await ChatHistory.GetAllLocalSessionsAsync();
            if (localSessions.Count == 0) return;

            // Only clear localStorage if ALL migrations succeed
            var allSucceeded = true;
            foreach (var local in localSessions)
            {
                var body = new SaveChatSessionRequest { Title = local.Title, Messages = local.Messages };
                var response = await Http.PostAsJsonAsync("api/ChatSessions", body);
                if (!response.IsSuccessStatusCode) { allSucceeded = false; break; }
            }

            if (!allSucceeded) return;

            await ChatHistory.ClearLocalSessionsAsync();
            await ChatHistory.LoadAsync();
        }
        catch { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SessionId.HasValue && SessionId != _currentSessionId)
        {
            await LoadSession(SessionId.Value);
        }
        else if (!SessionId.HasValue && _currentSessionId.HasValue && _conversation.Count == 0)
        {
            // Navigated to /ask without a session ID and no active conversation — start fresh.
            // The _conversation.Count check prevents resetting when we just saved an anonymous
            // session (URL stays /ask but the conversation is still live in memory).
            NewChat();
        }
    }

    private void UseExample(string prompt)
    {
        _model.Prompt = prompt;
        _ = InvokeAsync(SubmitAsync);
    }

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_loading && !string.IsNullOrWhiteSpace(_model.Prompt))
            await SubmitAsync();
    }

    // ── Core submit: multi-turn conversation ──

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Prompt) || _loading || _chatClient is null) return;

        var userPrompt = _model.Prompt.Trim();
        _model.Prompt = "";
        _loading = true;
        StateHasChanged();

        // UI bubble shows raw prompt; the wire-format message carries the envelope.
        _conversation.Add(new ConversationMessage { Role = ConversationRole.User, Text = userPrompt });

        var continuity = GlobalFilterService.GetContinuityQueryParam() ?? "Both";
        var envelopedContent = $"[CONTINUITY: {continuity}] [PREFER: {_selectedMode}] {userPrompt}";
        _chatMessages.Add(new ChatMessage(ChatRole.User, envelopedContent));

        // Reset per-turn streaming state
        _callNames.Clear();
        _toolInfoByCallId.Clear();
        _assistantByMessageId.Clear();
        _currentToolGroup = null;
        _toolGroupInterrupted = false;
        _renderedThisTurn = false;

        await ScrollToBottom();

        using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(5));

        try
        {
            var updates = new List<ChatResponseUpdate>();

            await foreach (var update in _chatClient.GetStreamingResponseAsync(_chatMessages, options: null, cts.Token))
            {
                updates.Add(update);
                ApplyToolCallContents(update);
                ApplyErrorContents(update);
                ApplyAssistantText(updates);

                StateHasChanged();
                await ScrollToBottom();
            }

            // Persist this assistant turn back into _chatMessages so the next user
            // turn carries full context. ToChatResponse() collapses streamed deltas
            // (and AGUI's per-event splits) into the canonical M.E.AI messages.
            var response = updates.ToChatResponse();
            foreach (var m in response.Messages)
                _chatMessages.Add(m);

            // If the stream completed but no assistant/tool/visualization message appeared
            // after the user's message, the guardrail or agent returned an empty response.
            var lastUserIdx = -1;
            for (int i = _conversation.Count - 1; i >= 0; i--)
            {
                if (_conversation[i].Role == ConversationRole.User) { lastUserIdx = i; break; }
            }
            var hasResponseAfterUser = lastUserIdx >= 0
                && _conversation.Skip(lastUserIdx + 1).Any(m => m.Role is ConversationRole.Assistant or ConversationRole.Visualization or ConversationRole.ToolGroup);

            if (!hasResponseAfterUser)
            {
                _conversation.Add(new ConversationMessage
                {
                    Role = ConversationRole.Error,
                    Text = "No response was received. The request may have been blocked or the AI service may be unavailable. Please try again."
                });
            }

            // Collapse tool groups now that the turn is done — matches the old finalize step.
            foreach (var msg in _conversation)
            {
                if (msg.Role == ConversationRole.ToolGroup)
                    msg.IsExpanded = false;
            }

            // Auto-save session
            await SaveCurrentSessionAsync(userPrompt);
        }
        catch (OperationCanceledException)
        {
            _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = "Request timed out. Try a simpler question." });
        }
        catch (JsonException jsonEx)
        {
            // AGUIChatClient internally deserializes every TOOL_CALL_RESULT content
            // field as JsonElement. When a server tool returns a non-JSON value
            // (raw error string, plain text), the exception escapes the streaming
            // iterator and kills the turn. Render a friendly message instead of
            // raw "'E' is an invalid start of a value" parser noise. The faulty
            // tool itself is the bug to chase upstream — see Design-041 follow-up.
            Logger.LogError(jsonEx, "Ask streaming hit malformed JSON in a tool result");
            _conversation.Add(new ConversationMessage
            {
                Role = ConversationRole.Error,
                Text = "A tool returned a malformed response, so this turn couldn't complete. Try rephrasing the question or asking again.",
            });
        }
        catch (RateLimitedException rl)
        {
            var retryMinutes = Math.Ceiling((rl.RetryAfterSeconds ?? 1800) / 60.0);
            var isAuthForMessage = rl.IsAuthenticated ?? _isAuthenticated;
            var limit = rl.Limit ?? (isAuthForMessage ? 6 : 1);

            var message = isAuthForMessage
                ? $"You have used all {limit} of your requests. Your next request will be available in {retryMinutes:0} minutes. Add your own OpenAI API key in your Profile to remove this limit."
                : $"As an anonymous user you are limited to {limit} request per window. Your next request will be available in {retryMinutes:0} minutes. Sign in for more requests, or add your own OpenAI API key for unlimited access.";

            _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = message });
        }
        catch (HttpRequestException httpEx)
        {
            var code = httpEx.StatusCode is { } sc ? $"({(int)sc})" : "";
            _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = $"Request failed {code}. Please try again.".Trim() });
            Logger.LogError(httpEx, "Ask streaming request failed");
        }
        catch (Exception ex)
        {
            _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = $"Unexpected error: {ex.Message}" });
            Logger.LogError(ex, "Ask streaming call threw");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    // ── ChatResponseUpdate handlers ──

    private void ApplyToolCallContents(ChatResponseUpdate update)
    {
        foreach (var content in update.Contents)
        {
            switch (content)
            {
                case FunctionCallContent fc:
                    OnFunctionCall(fc);
                    break;
                case FunctionResultContent fr:
                    OnFunctionResult(fr);
                    break;
            }
        }
    }

    private void OnFunctionCall(FunctionCallContent fc)
    {
        if (_toolInfoByCallId.ContainsKey(fc.CallId))
            return;

        _callNames[fc.CallId] = fc.Name;
        var info = new ToolCallInfo
        {
            CallId = fc.CallId,
            ToolName = fc.Name,
            Arguments = fc.Arguments is { Count: > 0 }
                ? JsonSerializer.Serialize(fc.Arguments, JsonOpts)
                : "",
        };
        _toolInfoByCallId[fc.CallId] = info;

        // Group consecutive tool calls together — only start a new group when there's
        // no current group or a non-tool message (assistant text / visualization)
        // interrupted the sequence. Mirrors the SSE-era behaviour.
        if (_currentToolGroup is null || _toolGroupInterrupted)
        {
            _currentToolGroup = new ConversationMessage
            {
                Role = ConversationRole.ToolGroup,
                ToolCalls = [info],
                IsExpanded = true,
            };
            _conversation.Add(_currentToolGroup);
            _toolGroupInterrupted = false;
        }
        else
        {
            _currentToolGroup.ToolCalls!.Add(info);
        }
    }

    private void OnFunctionResult(FunctionResultContent fr)
    {
        if (!_toolInfoByCallId.TryGetValue(fr.CallId, out var info))
            return;
        info.IsComplete = true;

        var resultJson = SerializeFunctionResult(fr.Result);
        info.Result = resultJson;

        var toolName = _callNames.TryGetValue(fr.CallId, out var n) ? n : null;
        if (toolName is null || resultJson is null) return;

        var vizType = toolName switch
        {
            "render_table" => "table",
            "render_data_table" => "data_table",
            "render_chart" => "chart",
            "render_graph" or "render_path" => "graph",
            "render_timeline" => "timeline",
            "render_infobox" => "infobox",
            "render_markdown" => "text",
            "render_aurebesh" => "aurebesh",
            "render_family_tree" => "family_tree",
            _ => null,
        };
        if (vizType is null) return;

        var vizMsg = new ConversationMessage { Role = ConversationRole.Visualization, VisualizationType = vizType };
        try
        {
            switch (toolName)
            {
                case "render_table":
                    vizMsg.TableDescriptor = JsonSerializer.Deserialize<TableDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_data_table":
                    vizMsg.DataTableDescriptor = JsonSerializer.Deserialize<DataTableDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_chart":
                    vizMsg.ChartDescriptor = JsonSerializer.Deserialize<ChartDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_graph":
                case "render_path":
                    vizMsg.GraphDescriptor = JsonSerializer.Deserialize<GraphDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_timeline":
                    vizMsg.TimelineDescriptor = JsonSerializer.Deserialize<TimelineDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_infobox":
                    vizMsg.InfoboxDescriptor = JsonSerializer.Deserialize<InfoboxDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_markdown":
                    vizMsg.TextDescriptor = JsonSerializer.Deserialize<TextDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_aurebesh":
                    vizMsg.AurebeshDescriptor = JsonSerializer.Deserialize<AurebeshDescriptor>(resultJson, JsonOpts);
                    break;
                case "render_family_tree":
                    vizMsg.FamilyTreeDescriptor = JsonSerializer.Deserialize<FamilyTreeDescriptor>(resultJson, JsonOpts);
                    break;
            }
            _conversation.Add(vizMsg);
            _toolGroupInterrupted = true;
            // Lock out post-render assistant text — see _renderedThisTurn declaration.
            _renderedThisTurn = true;
        }
        catch (JsonException ex)
        {
            Logger.LogWarning(ex, "Failed to deserialize {ToolName} result", toolName);
        }
    }

    // The AGUI wire-format result arrives as a JsonElement; saved-session replay
    // hands us a string. Normalise both to the raw JSON text we feed to the
    // descriptor deserializers and the session-persistence layer.
    private static string? SerializeFunctionResult(object? result) => result switch
    {
        null => null,
        string s => s,
        JsonElement el => el.ValueKind == JsonValueKind.String ? el.GetString() : el.GetRawText(),
        _ => JsonSerializer.Serialize(result, JsonOpts),
    };

    private void ApplyErrorContents(ChatResponseUpdate update)
    {
        foreach (var content in update.Contents)
        {
            if (content is not ErrorContent err) continue;
            var errorMsg = !string.IsNullOrEmpty(err.Message) ? err.Message : "Unknown error";
            if (errorMsg.Contains("429", StringComparison.Ordinal)
                || errorMsg.Contains("quota", StringComparison.OrdinalIgnoreCase)
                || errorMsg.Contains("insufficient_quota", StringComparison.OrdinalIgnoreCase))
            {
                _aiUnavailable = true;
                _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = "AI features are temporarily unavailable due to API quota limits. Other features such as Timeline, Data Tables, Graph Explorer, and Galaxy Maps remain fully operational." });
            }
            else
            {
                _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = errorMsg });
            }
            Logger.LogError("ErrorContent from agent: {Error}", errorMsg);
            _toolGroupInterrupted = true;
        }
    }

    private void ApplyAssistantText(IReadOnlyList<ChatResponseUpdate> updates)
    {
        // After a render_* result this turn, the visualization IS the answer —
        // skip mirroring assistant text bubbles so we don't render leftover JSON
        // or boilerplate the model emitted before stopping.
        if (_renderedThisTurn) return;

        // Rebuild the assistant message list from the canonical M.E.AI accumulator
        // each tick. ToChatResponse() collapses streamed deltas + final assembled
        // messages into one ChatMessage per assistant segment, keyed by MessageId.
        var response = updates.ToChatResponse();
        var index = 0;
        foreach (var m in response.Messages.Where(m => m.Role == ChatRole.Assistant))
        {
            var text = m.Text ?? "";
            // Skip tool-call-only assistant segments. ToChatResponse emits one
            // assistant ChatMessage per tool call (carrying just FunctionCallContent),
            // which has no user-facing text — the tool breadcrumb already represents
            // it. Without this filter we render an empty MudPaper between every pair
            // of tool calls.
            if (string.IsNullOrEmpty(text))
            {
                index++;
                continue;
            }

            var key = !string.IsNullOrEmpty(m.MessageId) ? m.MessageId! : $"__pos:{index}";
            if (!_assistantByMessageId.TryGetValue(key, out var bubble))
            {
                bubble = new ConversationMessage { Role = ConversationRole.Assistant, Text = "" };
                _assistantByMessageId[key] = bubble;
                _conversation.Add(bubble);
                _toolGroupInterrupted = true;
            }
            bubble.Text = text;
            index++;
        }
    }

    // ── Scroll ──

    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            await JS.InvokeVoidAsync("eval", "document.querySelector('.ask-chat-messages')?.scrollTo({top: 999999, behavior: 'smooth'})");
        }
        catch { }
    }

    // ── Session management ──

    private async Task SaveCurrentSessionAsync(string userPrompt)
    {
        try
        {
            // Generate an AI-summarized 3-4 word title only for new sessions
            var title = _currentSessionId is null
                ? await ChatHistory.SummarizeTitleAsync(userPrompt)
                : "";

            var messages = BuildSessionMessages();

            if (_isAuthenticated && _userId is not null)
            {
                // Authenticated: save to API
                var body = new SaveChatSessionRequest { Title = title, Messages = messages };

                if (_currentSessionId is not null)
                {
                    await Http.PutAsJsonAsync($"api/ChatSessions/{_currentSessionId}", body);
                    await ChatHistory.LoadAsync();
                }
                else
                {
                    var response = await Http.PostAsJsonAsync("api/ChatSessions", body);
                    if (response.IsSuccessStatusCode)
                    {
                        _currentSessionId = await response.Content.ReadFromJsonAsync<Guid>();
                        ChatHistory.ActiveSessionId = _currentSessionId;
                        await ChatHistory.LoadAsync();
                    }
                }
            }
            else
            {
                // Anonymous: save to localStorage
                var isNew = _currentSessionId is null;
                _currentSessionId ??= Guid.NewGuid();
                if (string.IsNullOrEmpty(title))
                {
                    // Existing session — preserve original title
                    var existing = await ChatHistory.LoadLocalSessionAsync(_currentSessionId.Value);
                    title = existing?.Title ?? ChatHistoryService.FallbackTitle(userPrompt);
                }
                await ChatHistory.SaveLocalSessionAsync(_currentSessionId.Value, title, messages);
                ChatHistory.ActiveSessionId = _currentSessionId;
            }
        }
        catch { }
    }

    private List<ChatSessionMessage> BuildSessionMessages()
    {
        var messages = new List<ChatSessionMessage>();

        foreach (var msg in _conversation)
        {
            switch (msg.Role)
            {
                case ConversationRole.User:
                    messages.Add(new ChatSessionMessage
                    {
                        Role = "user",
                        Content = msg.Text ?? "",
                        Timestamp = msg.Timestamp,
                    });
                    break;
                case ConversationRole.Assistant:
                    messages.Add(new ChatSessionMessage
                    {
                        Role = "assistant",
                        Content = msg.Text ?? "",
                        Timestamp = msg.Timestamp,
                    });
                    break;
                case ConversationRole.ToolGroup:
                    foreach (var tc in msg.ToolCalls ?? [])
                    {
                        messages.Add(new ChatSessionMessage
                        {
                            Role = "tool",
                            ToolName = tc.ToolName,
                            ToolCallId = tc.CallId,
                            ToolCallArgs = tc.Arguments,
                            Content = tc.Result ?? "",
                            Timestamp = msg.Timestamp,
                        });
                    }
                    break;
                case ConversationRole.Visualization:
                    messages.Add(new ChatSessionMessage
                    {
                        Role = "visualization",
                        VisualizationType = msg.VisualizationType,
                        VisualizationData = msg.VisualizationType switch
                        {
                            "chart" => JsonSerializer.Serialize(msg.ChartDescriptor, JsonOpts),
                            "graph" => JsonSerializer.Serialize(msg.GraphDescriptor, JsonOpts),
                            "table" => JsonSerializer.Serialize(msg.TableDescriptor, JsonOpts),
                            "data_table" => JsonSerializer.Serialize(msg.DataTableDescriptor, JsonOpts),
                            "timeline" => JsonSerializer.Serialize(msg.TimelineDescriptor, JsonOpts),
                            "infobox" => JsonSerializer.Serialize(msg.InfoboxDescriptor, JsonOpts),
                            "text" => JsonSerializer.Serialize(msg.TextDescriptor, JsonOpts),
                            "family_tree" => JsonSerializer.Serialize(msg.FamilyTreeDescriptor, JsonOpts),
                            _ => null,
                        },
                        Timestamp = msg.Timestamp,
                    });
                    break;
                case ConversationRole.Error:
                    messages.Add(new ChatSessionMessage
                    {
                        Role = "error",
                        Content = msg.Text ?? "",
                        Timestamp = msg.Timestamp,
                    });
                    break;
            }
        }

        return messages;
    }

    private async Task LoadSession(Guid sessionId)
    {
        _loading = true;
        _conversation.Clear();
        _chatMessages.Clear();
        _callNames.Clear();
        _toolInfoByCallId.Clear();
        _assistantByMessageId.Clear();
        _currentToolGroup = null;
        _toolGroupInterrupted = false;
        _renderedThisTurn = false;
        StateHasChanged();

        try
        {
            List<ChatSessionMessage>? sessionMessages = null;

            if (_isAuthenticated)
            {
                var response = await Http.GetAsync($"api/ChatSessions/{sessionId}");
                if (response.IsSuccessStatusCode)
                {
                    var session = await response.Content.ReadFromJsonAsync<ChatSessionDetail>(JsonOpts);
                    sessionMessages = session?.Messages;
                }
            }
            else
            {
                var local = await ChatHistory.LoadLocalSessionAsync(sessionId);
                sessionMessages = local?.Messages;
            }

            if (sessionMessages is not null)
            {
                {
                    _currentSessionId = sessionId;
                    ChatHistory.ActiveSessionId = sessionId;
                    _model.Prompt = "";

                    // Rebuild conversation display + IChatClient replay from saved messages.
                    // ChatMessage shapes mirror what AGUIChatClient.AsAGUIMessages produces:
                    // - assistant + tool calls in ONE ChatMessage with FunctionCallContent items
                    // - each tool result in its own ChatMessage(ChatRole.Tool) with FunctionResultContent
                    foreach (var msg in sessionMessages)
                    {
                        switch (msg.Role)
                        {
                            case "user":
                                _conversation.Add(new ConversationMessage { Role = ConversationRole.User, Text = msg.Content, Timestamp = msg.Timestamp });
                                _chatMessages.Add(new ChatMessage(ChatRole.User, msg.Content));
                                break;
                            case "assistant":
                                _conversation.Add(new ConversationMessage { Role = ConversationRole.Assistant, Text = msg.Content, Timestamp = msg.Timestamp });
                                _chatMessages.Add(new ChatMessage(ChatRole.Assistant, msg.Content));
                                break;
                            case "tool":
                            {
                                var callId = msg.ToolCallId ?? Guid.NewGuid().ToString("N");
                                var toolName = msg.ToolName ?? "tool";

                                // Build the FunctionCallContent. If we can parse the saved
                                // arguments string as a JSON object, hand it over as a dictionary
                                // so AGUIChatClient round-trips it intact; otherwise leave args
                                // empty and let the wire format degrade to "{}" rather than
                                // crash the JSON pipeline with malformed args.
                                IDictionary<string, object?>? argsDict = null;
                                if (!string.IsNullOrWhiteSpace(msg.ToolCallArgs))
                                {
                                    try
                                    {
                                        argsDict = JsonSerializer.Deserialize<Dictionary<string, object?>>(msg.ToolCallArgs!, JsonOpts);
                                    }
                                    catch (JsonException) { }
                                }
                                var fnCall = new FunctionCallContent(callId, toolName, argsDict);

                                // Append the FunctionCallContent to the previous assistant
                                // ChatMessage if it's already carrying tool calls — matches
                                // how AGUI groups multiple parallel calls under one assistant
                                // message. Otherwise start a new assistant message.
                                var lastChat = _chatMessages.LastOrDefault();
                                if (lastChat is { Role.Value: "assistant" } && lastChat.Contents.Any(c => c is FunctionCallContent))
                                {
                                    lastChat.Contents.Add(fnCall);
                                }
                                else
                                {
                                    _chatMessages.Add(new ChatMessage(ChatRole.Assistant, [fnCall]));
                                }

                                // Tool result. The saved Content is the raw JSON the server returned;
                                // parse as JsonElement so the round-trip back through AGUI doesn't
                                // double-encode the string. Fall back to the raw string if parsing
                                // fails (rare — should only happen for non-JSON tool returns).
                                object? resultObj = msg.Content;
                                try { resultObj = JsonSerializer.Deserialize<JsonElement>(msg.Content); }
                                catch (JsonException) { }
                                _chatMessages.Add(new ChatMessage(ChatRole.Tool, [new FunctionResultContent(callId, resultObj)]));

                                // Render side — group consecutive tool calls into one card,
                                // exactly as live streaming does.
                                var lastConv = _conversation.LastOrDefault();
                                var info = new ToolCallInfo
                                {
                                    CallId = callId,
                                    ToolName = toolName,
                                    Arguments = msg.ToolCallArgs ?? "",
                                    Result = msg.Content,
                                    IsComplete = true,
                                };
                                if (lastConv?.Role == ConversationRole.ToolGroup)
                                {
                                    lastConv.ToolCalls!.Add(info);
                                }
                                else
                                {
                                    _conversation.Add(new ConversationMessage
                                    {
                                        Role = ConversationRole.ToolGroup,
                                        ToolCalls = [info],
                                        IsExpanded = false,
                                        Timestamp = msg.Timestamp,
                                    });
                                }
                                break;
                            }
                            case "visualization":
                            {
                                var vizMsg = new ConversationMessage
                                {
                                    Role = ConversationRole.Visualization,
                                    VisualizationType = msg.VisualizationType,
                                    Timestamp = msg.Timestamp,
                                };
                                if (msg.VisualizationData is not null)
                                {
                                    switch (msg.VisualizationType)
                                    {
                                        case "chart": vizMsg.ChartDescriptor = JsonSerializer.Deserialize<ChartDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "graph": vizMsg.GraphDescriptor = JsonSerializer.Deserialize<GraphDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "table": vizMsg.TableDescriptor = JsonSerializer.Deserialize<TableDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "data_table": vizMsg.DataTableDescriptor = JsonSerializer.Deserialize<DataTableDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "timeline": vizMsg.TimelineDescriptor = JsonSerializer.Deserialize<TimelineDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "infobox": vizMsg.InfoboxDescriptor = JsonSerializer.Deserialize<InfoboxDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "text": vizMsg.TextDescriptor = JsonSerializer.Deserialize<TextDescriptor>(msg.VisualizationData, JsonOpts); break;
                                        case "family_tree": vizMsg.FamilyTreeDescriptor = JsonSerializer.Deserialize<FamilyTreeDescriptor>(msg.VisualizationData, JsonOpts); break;
                                    }
                                }
                                _conversation.Add(vizMsg);
                                break;
                            }
                            case "error":
                                _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = msg.Content, Timestamp = msg.Timestamp });
                                break;
                        }
                    }
                }
            }
            else
            {
                _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = "Chat session not found. It may have been deleted or belongs to a different account." });
            }
        }
        catch (Exception ex)
        {
            _conversation.Add(new ConversationMessage { Role = ConversationRole.Error, Text = $"Failed to load session: {ex.Message}" });
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void NewChat()
    {
        ChatHistory.ActiveSessionId = null;
        ResetChat();
        ChatHistory.NotifyChanged();
    }

    private static string FriendlyToolName(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "Using tool";

        // Convert snake_case tool name to "Title case sentence"
        // e.g. "semantic_search" → "Semantic search"
        // e.g. "render_chart" → "Render chart"
        var words = name.Split('_', StringSplitOptions.RemoveEmptyEntries);
        words[0] = char.ToUpper(words[0][0]) + words[0][1..];
        return string.Join(' ', words);
    }

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}
