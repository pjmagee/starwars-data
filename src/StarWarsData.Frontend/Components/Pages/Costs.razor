@page "/costs"
@inject IHttpClientFactory HttpClientFactory
@using System.Net.Http.Json

<PageTitle>Running Costs — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="What it costs to run Star Wars Data Explorer — live OpenAI spend, domain, and the self-hosted stack." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudStack Spacing="6">

        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Running Costs</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                A non-commercial fan project, but not free to run. The breakdown below covers
                live OpenAI API spend, the domain, and the self-hosted stack behind the rest.
            </MudText>
        </div>

        <MudDivider />

        @* ── OpenAI live spend tile ─────────────────────────────────────────────── *@
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">OpenAI API spend</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Pulled from <MudLink Href="https://platform.openai.com/docs/api-reference/usage/costs" Target="_blank" Underline="Underline.Hover">OpenAI's Costs API</MudLink>
                via a nightly sync. Estimates with ~24h lag.
            </MudText>

            @if (_summary is null)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading spend data…</MudText>
                </MudStack>
            }
            else if (_summary.TotalCentsLast90Days == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    No spend data has been synced yet. Check back tomorrow.
                </MudAlert>
            }
            else
            {
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">Last 30 days</MudText>
                                <MudText Typo="Typo.h4" Style="font-weight: 600;">
                                    @FormatMoney(_summary.TotalCentsLast30Days, _summary.Currency)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @if (_summary.LastSyncedAt is { } ts)
                                    {
                                        <span>Last synced @ts.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                    }
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.overline" Color="Color.Secondary">Last 90 days</MudText>
                                <MudText Typo="Typo.h4" Style="font-weight: 600;">
                                    @FormatMoney(_summary.TotalCentsLast90Days, _summary.Currency)
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Approximate ~@FormatMoney(_summary.TotalCentsLast90Days / 3, _summary.Currency)/month average
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @if (_summary.DailyLast30.Count > 0)
                {
                    <MudPaper Class="pa-4 mt-4" Elevation="2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-2">Daily spend (last 30 days)</MudText>
                        @{
                            var maxCents = Math.Max(1L, _summary.DailyLast30.Max(d => d.Cents));
                        }
                        <div style="display: flex; align-items: flex-end; gap: 2px; height: 80px;">
                            @foreach (var d in _summary.DailyLast30)
                            {
                                var heightPct = Math.Max(2, (int)(d.Cents * 100.0 / maxCents));
                                var tip = $"{d.Date}: {FormatMoney(d.Cents, _summary.Currency)}";
                                <div title="@tip" style="@($"flex: 1; height: {heightPct}%; background: var(--mud-palette-primary); border-radius: 2px; opacity: {(d.Cents == 0 ? "0.25" : "1")};")"></div>
                            }
                        </div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_summary.DailyLast30.First().Date</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_summary.DailyLast30.Last().Date</MudText>
                        </MudStack>
                    </MudPaper>
                }

                @if (_summary.ByLineItemLast30.Count > 0)
                {
                    <MudPaper Class="pa-4 mt-4" Elevation="2">
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;" Class="mb-2">Breakdown by line item (last 30 days)</MudText>
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Line item</th>
                                    <th style="text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var li in _summary.ByLineItemLast30.Take(15))
                                {
                                    <tr>
                                        <td><MudText Typo="Typo.body2">@li.Name</MudText></td>
                                        <td style="text-align: right;">
                                            <MudText Typo="Typo.body2">@FormatMoney(li.Cents, _summary.Currency)</MudText>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }
            }
        </div>

        <MudDivider />

        @* ── Fixed costs ───────────────────────────────────────────────────────── *@
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">Fixed costs</MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Domain</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                <strong>swdata.ai</strong> &mdash; £80 / year.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </div>

        <MudDivider />

        @* ── Self-hosted stack ──────────────────────────────────────────────────── *@
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">Self-hosted</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                The application stack runs on self-hosted infrastructure, so beyond the OpenAI
                API and the domain there are no recurring cloud charges.
            </MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Secondary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Platform</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                <MudLink Href="https://unraid.net" Target="_blank" Underline="Underline.Hover">Unraid OS</MudLink>
                                running the container workloads, fronted by Cloudflare for TLS and DDoS protection.
                                Sign-in uses standards-based OIDC.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Tertiary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Database</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                <MudLink Href="https://www.mongodb.com/docs/atlas/cli/current/atlas-cli-deploy-local/" Target="_blank" Underline="Underline.Hover">MongoDB Atlas Local</MudLink>
                                (Community Edition) with Atlas Search and Vector Search — semantic retrieval
                                and embeddings run on the local instance, no managed-tier cost.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Application</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                .NET 10 with <MudLink Href="https://learn.microsoft.com/dotnet/aspire" Target="_blank" Underline="Underline.Hover">.NET Aspire</MudLink>
                                orchestration, ASP.NET Core API, Blazor Interactive Server frontend
                                (<MudLink Href="https://mudblazor.com" Target="_blank" Underline="Underline.Hover">MudBlazor</MudLink>),
                                and <MudLink Href="https://www.hangfire.io" Target="_blank" Underline="Underline.Hover">Hangfire</MudLink> for background jobs.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Class="pa-4" Elevation="2" Style="height: 100%;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">AI</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2">
                                OpenAI models via <MudLink Href="https://learn.microsoft.com/dotnet/ai" Target="_blank" Underline="Underline.Hover">Microsoft.Extensions.AI</MudLink>
                                and <MudLink Href="https://github.com/microsoft/Agents-for-net" Target="_blank" Underline="Underline.Hover">Microsoft.Agents.AI</MudLink>.
                                Embeddings, chunking, and the agent toolchain account for the OpenAI spend above.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </div>

        <MudDivider />

        @* ── CTA ──────────────────────────────────────────────────────────────── *@
        <MudPaper Class="pa-4" Elevation="2" Style="text-align: center;">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Donations help cover the OpenAI API spend and domain renewal.
                </MudText>
                <MudButton
                    Variant="Variant.Filled"
                    Color="Color.Warning"
                    Href="https://www.buymeacoffee.com/pjmagee"
                    Target="_blank"
                    StartIcon="@Icons.Material.Filled.Coffee">
                    Buy Me a Coffee
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Source on <MudLink Href="https://github.com/pjmagee/starwars-data" Target="_blank" Underline="Underline.Always">GitHub</MudLink>.
                </MudText>
            </MudStack>
        </MudPaper>

    </MudStack>
</MudContainer>

@code {
    HttpClient Api => HttpClientFactory.CreateClient("StarWarsData");
    OpenAiSummaryDto? _summary;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Api.GetFromJsonAsync<OpenAiSummaryDto>("api/costs/openai-summary");
        }
        catch
        {
            _summary = new OpenAiSummaryDto(0, 0, "usd", null, [], []);
        }
    }

    static string FormatMoney(long cents, string currency)
    {
        var amount = cents / 100m;
        var symbol = currency.ToLowerInvariant() switch
        {
            "usd" => "$",
            "gbp" => "£",
            "eur" => "€",
            _ => currency.ToUpperInvariant() + " ",
        };
        return $"{symbol}{amount:N2}";
    }

    public sealed record OpenAiSummaryDto(
        long TotalCentsLast30Days,
        long TotalCentsLast90Days,
        string Currency,
        DateTime? LastSyncedAt,
        IReadOnlyList<DailySpendDto> DailyLast30,
        IReadOnlyList<LineItemDto> ByLineItemLast30);

    public sealed record DailySpendDto(string Date, long Cents, IReadOnlyList<LineItemDto> LineItems);

    public sealed record LineItemDto(string Name, long Cents);
}
