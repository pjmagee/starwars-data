@page "/family-trees"
@using Microsoft.Extensions.AI
@using StarWarsData.Frontend.Services
@using StarWarsData.Models.Queries
@inject IHttpClientFactory HttpClientFactory
@inject GlobalFilterService Filter
@inject PageContextService PageContext
@inject PageControlService PageControl
@inject ILogger<FamilyTrees> Logger
@implements IDisposable

<PageTitle>Family Trees — Star Wars Data</PageTitle>
<HeadContent>
    <meta name="description" content="Pick any of 600+ families from the Star Wars knowledge graph (Skywalker, Organa, Tarkin, Kryze, Fett, Nightsisters, House of Tagge, San Tekka clan, …) and render a marriage-aware family tree centered on the family's central figure." />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-4 px-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Color="Color.Primary" />
        <MudText Typo="Typo.h5">Family Trees</MudText>
    </MudStack>

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Pick a family from the knowledge graph. The renderer anchors on the family's
        highest-kinship member and draws every relative reachable through marriage,
        parentage, and siblings. Canon/Legends switches in the toolbar filter the
        list and the rendered tree.
    </MudText>

    <MudAutocomplete T="EntitySearchDto"
                     Value="_selected"
                     ValueChanged="OnFamilySelected"
                     SearchFunc="SearchFamilies"
                     ToStringFunc="@FormatFamilyOption"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Placeholder="@($"Search {(_allFamilies?.Count ?? 0)} families by family or character name — try Skywalker, Anakin, Boba… (or just scroll A–Z)")"
                     Clearable="true"
                     ResetValueOnEmptyText="true"
                     CoerceValue="false"
                     MaxItems="@(null)"
                     MaxHeight="520"
                     DebounceInterval="150"
                     Class="mb-3" />

    @if (_descriptor is not null)
    {
        @* Keyed on the family PageId so switching families fully tears down the
           prior chart (the FamilyTreeView guards against double-renders, but a
           fresh component is simpler and matches the rest of the app's reset-
           on-selection pattern). *@
        <FamilyTreeView @key="_descriptor.RootEntityId"
                        Descriptor="_descriptor"
                        EndpointPath="family-tree-by-family" />
    }
    else
    {
        <MudPaper Outlined="true" Class="pa-6 mt-4" Style="width:100%; text-align:center">
            <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom" Color="Color.Secondary" Size="Size.Large" Class="mb-2" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No family selected yet — start typing above to pick one.
            </MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private EntitySearchDto? _selected;
    private FamilyTreeDescriptor? _descriptor;
    private bool _subscribed;
    private IDisposable? _pageControlRegistration;

    // Full list of Family-type KG nodes for the active continuity/realm filter,
    // prefetched on page load so the autocomplete can scroll A–Z through every
    // entry instantly. The server caps `browse?type=Family` at pageSize=100, so
    // we walk pages until we hit the total — usually 6–7 requests for ~630
    // families. Refreshed on filter change.
    private List<EntitySearchDto>? _allFamilies;
    private CancellationTokenSource? _loadCts;

    private HttpClient Http => HttpClientFactory.CreateClient("StarWarsData");

    protected override void OnInitialized()
    {
        if (!_subscribed)
        {
            Filter.OnChange += OnFilterChanged;
            _subscribed = true;
        }
        // SP-4 page-context publish — tells the copilot sidebar the user is
        // on /family-trees with nothing selected yet, so it surfaces the
        // page-level suggestion prompts. Subject is republished on selection.
        PublishPageContext();
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadFamiliesAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            RegisterPageControlActions();
    }

    private async Task ReloadFamiliesAsync()
    {
        // Cancel any in-flight prefetch from a stale filter change.
        _loadCts?.Cancel();
        _loadCts = new CancellationTokenSource();
        var ct = _loadCts.Token;

        try
        {
            var continuity = Filter.GetContinuityQueryParam();
            var realm = Filter.GetRealmQueryParam();
            var acc = new List<EntitySearchDto>();
            const int pageSize = 100; // matches the server cap
            for (var page = 1; page < 50; page++) // safety cap @ 5000 entries
            {
                var qs = new List<string> { "type=Family", $"page={page}", $"pageSize={pageSize}" };
                if (!string.IsNullOrEmpty(continuity))
                    qs.Add($"continuity={Uri.EscapeDataString(continuity)}");
                if (!string.IsNullOrEmpty(realm))
                    qs.Add($"realm={Uri.EscapeDataString(realm)}");

                var url = $"api/RelationshipGraph/browse?{string.Join("&", qs)}";
                var result = await Http.GetFromJsonAsync<BrowseEntitiesResult>(url, ct);
                if (result?.Items is null || result.Items.Count == 0)
                    break;
                acc.AddRange(result.Items);
                if (acc.Count >= result.Total)
                    break;
            }
            // Name-sorted alphabetically — the browse endpoint sorts server-side
            // but we re-sort after concat in case pages interleave at the boundary.
            acc.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
            _allFamilies = acc;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Filter changed again before this load finished — drop.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Family prefetch failed");
            _allFamilies = new List<EntitySearchDto>();
        }
    }

    private async Task<IEnumerable<EntitySearchDto>> SearchFamilies(string? text, CancellationToken ct)
    {
        // Two-mode search:
        //   • Empty query → return the prefetched A–Z list (instant, no HTTP).
        //   • Non-empty   → hit /families/search which surfaces matches BOTH
        //     by family name AND by member-character name. Lets a user who
        //     only knows a first name ("Anakin", "Padmé", "Boba") still find
        //     the right family. Each hit may carry `MatchedVia` with the
        //     character name; FormatFamilyOption surfaces it inline.
        if (string.IsNullOrWhiteSpace(text))
        {
            return _allFamilies ?? Enumerable.Empty<EntitySearchDto>();
        }

        try
        {
            var qs = new List<string> { $"q={Uri.EscapeDataString(text.Trim())}" };
            var continuity = Filter.GetContinuityQueryParam();
            if (!string.IsNullOrEmpty(continuity))
                qs.Add($"continuity={Uri.EscapeDataString(continuity)}");
            var realm = Filter.GetRealmQueryParam();
            if (!string.IsNullOrEmpty(realm))
                qs.Add($"realm={Uri.EscapeDataString(realm)}");

            var url = $"api/RelationshipGraph/families/search?{string.Join("&", qs)}";
            var result = await Http.GetFromJsonAsync<List<EntitySearchDto>>(url, ct);
            return result ?? Enumerable.Empty<EntitySearchDto>();
        }
        catch (OperationCanceledException)
        {
            return Enumerable.Empty<EntitySearchDto>();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Family search failed for query \"{Query}\"", text);
            return Enumerable.Empty<EntitySearchDto>();
        }
    }

    /// <summary>
    /// Display formatter for both the input value and the popover options.
    /// Direct hits read "Skywalker family · Canon"; character-surfaced hits
    /// read "Skywalker family · Canon · via Anakin Skywalker" so the user can
    /// tell which member triggered the match.
    /// </summary>
    private static string FormatFamilyOption(EntitySearchDto? f)
    {
        if (f is null) return string.Empty;
        var parts = new List<string> { f.Name };
        if (!string.IsNullOrEmpty(f.Continuity))
            parts.Add(f.Continuity);
        if (!string.IsNullOrEmpty(f.MatchedVia))
            parts.Add($"via {f.MatchedVia}");
        return string.Join(" · ", parts);
    }

    private void OnFamilySelected(EntitySearchDto? family)
    {
        _selected = family;
        if (family is null)
        {
            _descriptor = null;
            PublishPageContext();
            return;
        }

        // FamilyTreeView fetches via the EndpointPath we hand it. The descriptor
        // carries the Family node's PageId as RootEntityId; the server resolves
        // the focal Character internally and returns the standard wire shape.
        _descriptor = new FamilyTreeDescriptor
        {
            Title = family.Name,
            RootEntityId = family.Id,
            RootEntityName = family.Name,
            MaxDepth = 3,
            Continuity = family.Continuity,
        };
        PublishPageContext();
    }

    // ── SP-4 integration ────────────────────────────────────────────────────
    // PageContext publishes "what the user is looking at" so the copilot
    // sidebar can scope its suggestion prompts and any agent reasoning.
    // PageControl registers callable tools the agent can use to drive this
    // page without an HTTP round-trip through the global ask endpoint.
    private void PublishPageContext()
    {
        var extras = new Dictionary<string, string>(StringComparer.Ordinal);
        var filterContinuity = Filter.GetContinuityQueryParam();
        if (!string.IsNullOrEmpty(filterContinuity))
            extras["filterContinuity"] = filterContinuity;

        if (_selected is null)
        {
            PageContext.Set(new PageContext(Page: "family-trees", Extras: extras.Count > 0 ? extras : null));
            return;
        }

        if (!string.IsNullOrEmpty(_selected.Continuity))
            extras["continuity"] = _selected.Continuity;

        PageContext.Set(new PageContext(
            Page: "family-trees",
            Subject: _selected.Name,
            SubjectKind: "Family",
            SubjectId: _selected.Id,
            Extras: extras));
    }

    private void RegisterPageControlActions()
    {
        var selectFamily = AIFunctionFactory.Create(
            async (string query) =>
            {
                if (string.IsNullOrWhiteSpace(query))
                    return "Provide a family or character name (e.g. 'Tarkin', 'Anakin', 'Bo-Katan').";
                try
                {
                    var qs = new List<string> { $"q={Uri.EscapeDataString(query.Trim())}" };
                    var continuity = Filter.GetContinuityQueryParam();
                    if (!string.IsNullOrEmpty(continuity))
                        qs.Add($"continuity={Uri.EscapeDataString(continuity)}");
                    var realm = Filter.GetRealmQueryParam();
                    if (!string.IsNullOrEmpty(realm))
                        qs.Add($"realm={Uri.EscapeDataString(realm)}");

                    var url = $"api/RelationshipGraph/families/search?{string.Join("&", qs)}";
                    var hits = await Http.GetFromJsonAsync<List<EntitySearchDto>>(url);
                    if (hits is null || hits.Count == 0)
                        return $"No families match '{query}'. Try a different name (family OR character first/last name).";

                    var pick = hits[0];
                    await InvokeAsync(() =>
                    {
                        OnFamilySelected(pick);
                        StateHasChanged();
                    });

                    var via = string.IsNullOrEmpty(pick.MatchedVia) ? "" : $" (matched via {pick.MatchedVia})";
                    var others = hits.Count > 1 ? $" Other matches: {string.Join(", ", hits.Skip(1).Take(4).Select(h => h.Name))}." : "";
                    return $"Selected '{pick.Name}'{via}. Rendering the family tree now.{others}";
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "family_trees_select_family failed for '{Query}'", query);
                    return $"Could not search for '{query}': {ex.Message}";
                }
            },
            name: "family_trees_select_family",
            description: "Search for a family by name OR by one of its member characters' names and render its tree. "
                + "Pass the user's term as-is (e.g. 'Skywalker', 'Anakin', 'Boba Fett', 'Bo-Katan Kryze'). The page picks the "
                + "top match and updates the rendered tree. Returns a summary of what was selected and lists other matches "
                + "the user could pick instead.");

        var clearSelection = AIFunctionFactory.Create(
            () =>
            {
                InvokeAsync(() =>
                {
                    OnFamilySelected(null);
                    StateHasChanged();
                });
                return "Cleared the family selection. The page now shows the empty state.";
            },
            name: "family_trees_clear_selection",
            description: "Clear the currently-rendered family tree. Use when the user says \"start over\" or \"clear\".");

        var describeCurrent = AIFunctionFactory.Create(
            () =>
            {
                if (_selected is null)
                    return "No family is currently selected. Use family_trees_select_family with a name to render one.";
                var cont = string.IsNullOrEmpty(_selected.Continuity) ? "" : $" ({_selected.Continuity})";
                return $"Currently rendering: {_selected.Name}{cont} — KG node #{_selected.Id}. "
                    + "The server resolved the family's highest-kinship Character member as the focal and built a "
                    + "marriage-aware, generation-aligned tree around them.";
            },
            name: "family_trees_describe_current",
            description: "Read out which family is currently rendered on the page (name, continuity, KG node id). "
                + "Use when the user asks \"what am I looking at\" or \"which family is this\".");

        var actions = new PageAction[]
        {
            new(selectFamily, Label: "Pick a family by family or character name",
                Example: "show me the Tarkin family"),
            new(clearSelection, Label: "Clear the current family",
                Example: "clear the tree"),
            new(describeCurrent, Label: "Read out the current selection",
                Example: "which family is on screen?"),
        };

        try
        {
            _pageControlRegistration = PageControl.Register("family-trees", actions);
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "PageControlService already had a registration; family-trees page tools unavailable this circuit.");
        }
    }

    private void OnFilterChanged()
    {
        // When the user flips Canon/Legends two things happen:
        //   1. The prefetched family list is now wrong — refresh it so the
        //      dropdown only shows families in the active continuity.
        //   2. If a family was already selected and its continuity no longer
        //      matches, drop the rendered tree (the tree itself also re-fetches
        //      via FamilyTreeView's own filter subscription, but the descriptor
        //      may point at a now-invisible family).
        InvokeAsync(async () =>
        {
            await ReloadFamiliesAsync();
            if (_selected is not null)
            {
                var continuity = Filter.GetContinuityQueryParam();
                if (!string.IsNullOrEmpty(continuity)
                    && !string.IsNullOrEmpty(_selected.Continuity)
                    && !string.Equals(continuity, _selected.Continuity, StringComparison.OrdinalIgnoreCase))
                {
                    _selected = null;
                    _descriptor = null;
                    StateHasChanged();
                }
            }
            // Re-publish so the copilot sees the new filterContinuity facet
            // (and the dropped subject if the selection was cleared).
            PublishPageContext();
        });
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            Filter.OnChange -= OnFilterChanged;
            _subscribed = false;
        }
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _pageControlRegistration?.Dispose();
        PageContext.Clear();
    }
}
