<Project Sdk="Aspire.AppHost.Sdk/13.3.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);ASPIRECOMPUTE001;ASPIRECOMPUTE003</NoWarn>
    <UserSecretsId>59ee3b5d-5913-4ff8-8856-9fd5265fdca1</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.3.5-preview.1.26270.6" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.3.5" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.3.5" />
    <!-- Float transitive MongoDB.Driver up so Snappier 1.3.1+/SharpCompress override apply. -->
    <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
    <!-- Direct override: MongoDB.Driver's transitive SharpCompress 0.30.1 is flagged (GHSA-6c8g-7p36-r338). 0.48.1 is safe and satisfies the >=0.30.1 constraint. -->
    <PackageReference Include="SharpCompress" Version="0.48.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StarWarsData.Admin\StarWarsData.Admin.csproj" />
    <ProjectReference Include="..\StarWarsData.ApiService\StarWarsData.ApiService.csproj" />
    <ProjectReference Include="..\StarWarsData.Frontend\StarWarsData.Frontend.csproj" />
  </ItemGroup>
</Project>
